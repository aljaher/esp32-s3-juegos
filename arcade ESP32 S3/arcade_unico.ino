const Note SND_INTRO[]  = {{392,100},{523,100},{659,100},{784,160},{0,40},{659,100},{784,260}};
const Note SND_WAKA1[]  = {{880,35}};
const Note SND_WAKA2[]  = {{660,35}};
const Note SND_POWER[]  = {{400,30},{600,30},{800,30},{1000,30},{1200,40}};
const Note SND_GHOST[]  = {{600,40},{900,40},{1200,60},{1500,80}};
const Note SND_DEATH[]  = {{900,90},{800,90},{700,90},{600,90},{500,90},{400,90},{300,90},{200,150}};
const Note SND_LEVEL[]  = {{659,100},{784,100},{988,100},{1319,250}};
const Note SND_CLICK[]  = {{1200,15}};
const Note SND_OVER[]   = {{392,200},{330,200},{262,200},{196,500}};
const Note SND_LIFE[]   = {{1047,80},{1319,80},{1568,160}};
#define NN(a) ((uint8_t)(sizeof(a) / sizeof(a[0])))

const Note* seqPtr = nullptr;
uint8_t  seqLen = 0, seqIdx = 0, seqPrio = 0;
uint32_t seqNext = 0;

void buzz(uint16_t f) {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcWriteTone(PIN_BUZZ, f);
#else
  ledcWriteTone(0, f);
#endif
}
void soundInit() {
#if defined(ESP_ARDUINO_VERSION_MAJOR) && ESP_ARDUINO_VERSION_MAJOR >= 3
  ledcAttach(PIN_BUZZ, 2000, 10);
#else
  ledcSetup(0, 2000, 10);
  ledcAttachPin(PIN_BUZZ, 0);
#endif
  buzz(0);
}
void playSeq(const Note* s, uint8_t n, uint8_t prio) {
  if (!soundOn) return;
  if (seqPtr && prio < seqPrio) return;
  seqPtr = s; seqLen = n; seqIdx = 0; seqPrio = prio; seqNext = millis();
}
void updateSound(uint32_t now) {
  if (!seqPtr) return;
  if ((int32_t)(now - seqNext) < 0) return;
  if (seqIdx >= seqLen) { buzz(0); seqPtr = nullptr; seqPrio = 0; return; }
  buzz(seqPtr[seqIdx].f);
  seqNext = now + seqPtr[seqIdx].ms;
  seqIdx++;
}
void waitMs(uint32_t ms) {
  uint32_t t = millis();
  while (millis() - t < ms) { updateSound(millis()); delay(2); }
}
void click() { playSeq(SND_CLICK, NN(SND_CLICK), 1); }

// ============================== LABERINTO ==============================
// _ vacio fuera del circulo   # pared   . punto   o super punto   = puerta   ' ' pasillo
const int TS = 11, COLS = 17, ROWS = 17, OX = 26, OY = 26;
const char* const MAZE_SRC[ROWS] = {
  "__#############__",
  "_#.............#_",
  "#.o.##.###.##.o.#",
  "#...............#",
  "#.##.#.###.#.##.#",
  "#....#.....#....#",
  "#.##.###=###.##.#",
  "#.....#   #.....#",
  "#.###.#   #.###.#",
  "#.....#####.....#",
  "#.#####...#####.#",
  "#.o...#.#.#...o.#",
  "#...............#",
  "#.##.#.###.#.##.#",
  "#...............#",
  "_#......#......#_",
  "__#############__"
};
char    maze[ROWS][COLS + 1];
uint8_t homeDist[ROWS][COLS];
bool    blinkOn = true, flashWhite = false;

inline bool isPathCh(char t) { return t == ' ' || t == '.' || t == 'o'; }
char tileAt(int c, int r) { return (c < 0 || r < 0 || c >= COLS || r >= ROWS) ? '_' : maze[r][c]; }
bool canEnter(int c, int r) { return isPathCh(tileAt(c, r)); }

void drawTile(int c, int r) {
  if (c < 0 || r < 0 || c >= COLS || r >= ROWS) return;
  char t = maze[r][c];
  int x = OX + c * TS, y = OY + r * TS;
  if (t == '_') { tft.fillRect(x, y, TS, TS, C_BLACK); return; }
  if (t == '#') {
    uint16_t lc = flashWhite ? C_WHITE : SK.wallLine;
    tft.fillRect(x, y, TS, TS, SK.wallFill);
    if (isPathCh(tileAt(c, r - 1)) || tileAt(c, r - 1) == '=') tft.fillRect(x, y, TS, 2, lc);
    if (isPathCh(tileAt(c, r + 1)) || tileAt(c, r + 1) == '=') tft.fillRect(x, y + TS - 2, TS, 2, lc);
    if (isPathCh(tileAt(c - 1, r)) || tileAt(c - 1, r) == '=') tft.fillRect(x, y, 2, TS, lc);
    if (isPathCh(tileAt(c + 1, r)) || tileAt(c + 1, r) == '=') tft.fillRect(x + TS - 2, y, 2, TS, lc);
    return;
  }
  tft.fillRect(x, y, TS, TS, C_BLACK);
  if (t == '.')      tft.fillRect(x + 4, y + 4, 3, 3, SK.dot);
  else if (t == 'o') { if (blinkOn) tft.fillCircle(x + 5, y + 5, 4, SK.dot); }
  else if (t == '=') tft.fillRect(x, y + 4, TS, 3, SK.door);
}
void drawMaze() { for (int r = 0; r < ROWS; r++) for (int c = 0; c < COLS; c++) drawTile(c, r); }
void restoreRect(int x, int y) {   // x,y en pixeles relativos al laberinto
  int c0 = x / TS, c1 = (x + TS - 1) / TS, r0 = y / TS, r1 = (y + TS - 1) / TS;
  for (int r = r0; r <= r1; r++) for (int c = c0; c <= c1; c++) drawTile(c, r);
}

// BFS: distancia de cada pasillo a la casilla sobre la puerta (8,5); la usan los ojos
void buildHomeDist() {
  memset(homeDist, 255, sizeof(homeDist));
  uint8_t qc[ROWS * COLS], qr[ROWS * COLS];
  int head = 0, tail = 0;
  homeDist[5][8] = 0; qc[tail] = 8; qr[tail++] = 5;
  const int dc[4] = {0, -1, 0, 1}, dr[4] = {-1, 0, 1, 0};
  while (head < tail) {
    int c = qc[head], r = qr[head++];
    for (int d = 0; d < 4; d++) {
      int nc = c + dc[d], nr = r + dr[d];
      if (canEnter(nc, nr) && homeDist[nr][nc] == 255) {
        homeDist[nr][nc] = homeDist[r][c] + 1;
        qc[tail] = nc; qr[tail++] = nr;
      }
    }
  }
}

// ============================== SPRITES ==============================
void drawPacSprite(int sx, int sy, int dx, int dy, int mouth, uint16_t col) {
  int cx = sx + 5, cy = sy + 5;
  tft.fillCircle(cx, cy, 5, col);
  if (mouth > 0) {
    if (dx == 0 && dy == 0) dx = 1;
    int pxv = -dy, pyv = dx;
    tft.fillTriangle(cx, cy,
                     cx + dx * 5 + pxv * mouth, cy + dy * 5 + pyv * mouth,
                     cx + dx * 5 - pxv * mouth, cy + dy * 5 - pyv * mouth, C_BLACK);
  }
}
void drawEyes(int sx, int sy, int dx, int dy) {
  tft.fillRect(sx + 2, sy + 3, 3, 3, C_WHITE);
  tft.fillRect(sx + 6, sy + 3, 3, 3, C_WHITE);
  tft.fillRect(sx + 3 + dx, sy + 4 + dy, 1, 1, C_EYE);
  tft.fillRect(sx + 7 + dx, sy + 4 + dy, 1, 1, C_EYE);
}

enum GMode : uint8_t { G_PEN, G_LEAVING, G_NORMAL, G_FRIGHT, G_EATEN, G_ENTERING };
struct Ghost {
  int16_t x, y, px, py;
  int8_t  dx, dy;
  GMode   mode;
  uint8_t acc;
  uint32_t releaseAt;
};
struct Pac {
  int16_t x, y, px, py;
  int8_t  dx, dy, ndx, ndy, lastdx, lastdy;
  uint8_t acc, phase;
};
Ghost ghosts[4];
Pac   pac;

void drawGhostSprite(int sx, int sy, uint16_t col, int dx, int dy, bool fright, bool eyesOnly, bool flash) {
  if (!eyesOnly) {
    uint16_t c = fright ? (flash ? SK.frightFlash : SK.fright) : col;
    tft.fillCircle(sx + 5, sy + 5, 5, c);
    tft.fillRect(sx, sy + 5, 11, 6, c);
    tft.drawFastVLine(sx + 3, sy + 9, 2, C_BLACK);
    tft.drawFastVLine(sx + 7, sy + 9, 2, C_BLACK);
    if (fright) {
      tft.fillRect(sx + 3, sy + 3, 2, 2, flash ? C_RED : C_WHITE);
      tft.fillRect(sx + 7, sy + 3, 2, 2, flash ? C_RED : C_WHITE);
      return;
    }
  }
  drawEyes(sx, sy, dx, dy);
}

// ============================== TEXTO ==============================
void printC(const char* s, int y, uint8_t sz, uint16_t col) {
  tft.setTextSize(sz);
  tft.setTextColor(col);
  int w = strlen(s) * 6 * sz;
  tft.setCursor((240 - w) / 2, y);
  tft.print(s);
}


// Prototipos (adelantados)
void drawMenu();
void drawOptions();

// ============================== ESTADO DE JUEGO ==============================
enum State : uint8_t { S_MENU, S_OPTIONS, S_PLAY, S_PAUSE, S_OVER };
State    state = S_MENU;
uint32_t score = 0, nextLife = 10000, overStart = 0, pauseStart = 0;
int      lives = 3, level = 1, dotsLeft = 0;
int      ghostSpeedQ = 6, frightMsBase = 7000, randChance = 12;
bool     frightActive = false, scatter = true, scoreDirty = true;
uint32_t frightUntil = 0, modeUntil = 0, blinkT = 0;
int      ghostCombo = 200;
bool     newRecord = false;
bool     pacSalir = false;      // true = volver al menu del arcade

const int8_t GDX[4] = {0, -1, 0, 1};   // arriba, izq, abajo, der (orden clasico)
const int8_t GDY[4] = {-1, 0, 1, 0};
const int PAC_SPEED_Q = 8;             // cuartos de pixel por frame (8 = 2 px)

void drawScore() {
  char b[24];
  snprintf(b, sizeof(b), "SCORE %lu", (unsigned long)score);
  tft.fillRect(40, 10, 160, 12, C_BLACK);
  printC(b, 12, 1, SK.text);
}
void drawLives() {
  tft.fillRect(60, 214, 120, 18, C_BLACK);
  for (int i = 0; i < lives && i < 5; i++) {
    int cx = 78 + i * 12, cy = 224;
    tft.fillCircle(cx, cy, 4, SK.pac);
    tft.fillTriangle(cx, cy, cx + 5, cy - 3, cx + 5, cy + 3, C_BLACK);
  }
  char b[12];
  snprintf(b, sizeof(b), "NIV %d", level);
  tft.setTextSize(1); tft.setTextColor(SK.text);
  tft.setCursor(142, 220); tft.print(b);
}

void loadLevel() {
  for (int r = 0; r < ROWS; r++) strcpy(maze[r], MAZE_SRC[r]);
  maze[12][8] = ' ';   // casilla de salida de Pac-Man sin punto
  dotsLeft = 0;
  for (int r = 0; r < ROWS; r++) for (int c = 0; c < COLS; c++) if (maze[r][c] == '.' || maze[r][c] == 'o') dotsLeft++;
  buildHomeDist();
  int base = 5 + diffIdx, add = level - 1; if (add > 2) add = 2;
  ghostSpeedQ = base + add; if (ghostSpeedQ > 8) ghostSpeedQ = 8;
  int ms = 7000 - (level - 1) * 900; if (ms < 2500) ms = 2500;
  if (diffIdx == 0) ms = ms * 14 / 10; else if (diffIdx == 2) ms = ms * 7 / 10;
  frightMsBase = ms;
  randChance = (diffIdx == 0) ? 35 : (diffIdx == 1 ? 12 : 0);
}

void resetEntities() {
  pac.x = 8 * TS; pac.y = 12 * TS; pac.dx = -1; pac.dy = 0; pac.ndx = -1; pac.ndy = 0;
  pac.lastdx = -1; pac.lastdy = 0; pac.acc = 0; pac.phase = 0; pac.px = pac.x; pac.py = pac.y;
  const int8_t gc[4] = {8, 8, 7, 9}, gr[4] = {5, 7, 8, 8};
  for (int i = 0; i < 4; i++) {
    Ghost &g = ghosts[i];
    g.x = gc[i] * TS; g.y = gr[i] * TS; g.px = g.x; g.py = g.y;
    g.dx = (i == 0) ? -1 : 0; g.dy = 0; g.acc = 0;
    g.mode = (i == 0) ? G_NORMAL : G_PEN;
  }
  frightActive = false;
  scatter = true;
}

void drawActors(uint32_t now) {
  int m = 3;
  if (pac.dx || pac.dy) { const uint8_t mm[4] = {1, 3, 4, 3}; m = mm[(pac.phase >> 1) & 3]; }
  drawPacSprite(OX + pac.x, OY + pac.y, pac.lastdx, pac.lastdy, m, SK.pac);
  for (int i = 0; i < 4; i++) {
    Ghost &g = ghosts[i];
    bool fr = (g.mode == G_FRIGHT);
    bool fl = fr && (int32_t)(frightUntil - now) < 2000 && ((now / 200) & 1);
    drawGhostSprite(OX + g.x, OY + g.y, SK.ghost[i], g.dx, g.dy, fr, g.mode == G_EATEN, fl);
  }
}

void startRound(bool intro) {
  resetEntities();
  tft.fillScreen(C_BLACK);
  drawMaze();
  drawScore();
  drawLives();
  drawActors(millis());
  printC("LISTO!", OY + 10 * TS + 2, 1, SK.text);
  if (intro) playSeq(SND_INTRO, NN(SND_INTRO), 3);
  waitMs(intro ? 2300 : 1400);
  for (int c = 5; c <= 11; c++) drawTile(c, 10);
  uint32_t now = millis();
  const uint16_t rel[4] = {0, 2000, 5000, 8000};
  for (int i = 1; i < 4; i++) ghosts[i].releaseAt = now + rel[i];
  modeUntil = now + 5000;
  blinkT = now;
  clearPresses();
}

void startGame() {
  score = 0; lives = 3; level = 1; nextLife = 10000; scoreDirty = true; newRecord = false;
  loadLevel();
  startRound(true);
  state = S_PLAY;
}

// ============================== PAC-MAN ==============================
void startFright(uint32_t now) {
  frightActive = true;
  ghostCombo = 200;
  frightUntil = now + frightMsBase;
  for (int i = 0; i < 4; i++) {
    Ghost &g = ghosts[i];
    if (g.mode == G_NORMAL) { g.mode = G_FRIGHT; g.dx = -g.dx; g.dy = -g.dy; }
  }
  playSeq(SND_POWER, NN(SND_POWER), 2);
}

bool wakaToggle = false;
void eatAt(int c, int r, uint32_t now) {
  char t = maze[r][c];
  if (t == '.') {
    maze[r][c] = ' '; score += 10; dotsLeft--; scoreDirty = true;
    wakaToggle = !wakaToggle;
    if (wakaToggle) playSeq(SND_WAKA1, 1, 0); else playSeq(SND_WAKA2, 1, 0);
  } else if (t == 'o') {
    maze[r][c] = ' '; score += 50; dotsLeft--; scoreDirty = true;
    startFright(now);
  }
}

void movePac(uint32_t now) {
  pac.acc += PAC_SPEED_Q;
  int steps = pac.acc >> 2; pac.acc &= 3;
  for (int s = 0; s < steps; s++) {
    if ((pac.dx || pac.dy) && (pac.ndx || pac.ndy) && pac.ndx == -pac.dx && pac.ndy == -pac.dy) {
      pac.dx = pac.ndx; pac.dy = pac.ndy;     // dar la vuelta en cualquier momento
    }
    if (pac.x % TS == 0 && pac.y % TS == 0) {
      int c = pac.x / TS, r = pac.y / TS;
      eatAt(c, r, now);
      if ((pac.ndx || pac.ndy) && canEnter(c + pac.ndx, r + pac.ndy)) { pac.dx = pac.ndx; pac.dy = pac.ndy; }
      if (!canEnter(c + pac.dx, r + pac.dy)) { pac.dx = 0; pac.dy = 0; }
    }
    pac.x += pac.dx; pac.y += pac.dy;
    if (pac.dx || pac.dy) { pac.lastdx = pac.dx; pac.lastdy = pac.dy; }
  }
  pac.phase++;
}

// ============================== FANTASMAS ==============================
void ghostTarget(int i, int &tc, int &tr) {
  Ghost &g = ghosts[i];
  int pc = (pac.x + TS / 2) / TS, pr = (pac.y + TS / 2) / TS;
  if (g.mode == G_EATEN) { tc = 8; tr = 5; return; }
  if (scatter && g.mode == G_NORMAL) {
    const int sc[4] = {16, 0, 16, 0}, sr[4] = {0, 0, 16, 16};
    tc = sc[i]; tr = sr[i]; return;
  }
  switch (i) {
    case 0: tc = pc; tr = pr; break;
    case 1: tc = pc + 4 * pac.lastdx; tr = pr + 4 * pac.lastdy; break;
    case 2: {
      int ac = pc + 2 * pac.lastdx, ar = pr + 2 * pac.lastdy;
      int bc = (ghosts[0].x + TS / 2) / TS, br = (ghosts[0].y + TS / 2) / TS;
      tc = ac + (ac - bc); tr = ar + (ar - br); break;
    }
    default: {
      int gc = (g.x + TS / 2) / TS, gr = (g.y + TS / 2) / TS;
      long d2 = (long)(gc - pc) * (gc - pc) + (long)(gr - pr) * (gr - pr);
      if (d2 > 64) { tc = pc; tr = pr; } else { tc = 0; tr = 16; }
    }
  }
}

void ghostDecide(int i) {
  Ghost &g = ghosts[i];
  int c = g.x / TS, r = g.y / TS;
  if (g.mode == G_EATEN) {
    int best = 255, bd = -1;
    for (int d = 0; d < 4; d++) {
      int nc = c + GDX[d], nr = r + GDY[d];
      if (canEnter(nc, nr) && homeDist[nr][nc] < best) { best = homeDist[nr][nc]; bd = d; }
    }
    if (bd >= 0) { g.dx = GDX[bd]; g.dy = GDY[bd]; }
    return;
  }
  int tc = 0, tr = 0; ghostTarget(i, tc, tr);
  int cand[4], nc = 0, bestD = -1;
  for (int pass = 0; pass < 2 && nc == 0; pass++) {
    long best = 0x7fffffff;
    for (int d = 0; d < 4; d++) {
      if (pass == 0 && (g.dx || g.dy) && GDX[d] == -g.dx && GDY[d] == -g.dy) continue;
      int xc = c + GDX[d], xr = r + GDY[d];
      if (!canEnter(xc, xr)) continue;
      cand[nc++] = d;
      long dist = (long)(xc - tc) * (xc - tc) + (long)(xr - tr) * (xr - tr);
      if (dist < best) { best = dist; bestD = d; }
    }
  }
  if (nc == 0) { g.dx = 0; g.dy = 0; return; }
  if (g.mode == G_FRIGHT || (g.mode == G_NORMAL && (int)random(100) < randChance)) bestD = cand[random(nc)];
  g.dx = GDX[bestD]; g.dy = GDY[bestD];
}

void moveGhost(int i, uint32_t now) {
  Ghost &g = ghosts[i];
  switch (g.mode) {
    case G_PEN:
      if ((int32_t)(now - g.releaseAt) >= 0) g.mode = G_LEAVING;
      return;
    case G_LEAVING:
      g.dx = 0; g.dy = 0;
      if (g.x < 8 * TS) g.x++;
      else if (g.x > 8 * TS) g.x--;
      else if (g.y > 5 * TS) g.y--;
      else {
        g.mode = frightActive ? G_FRIGHT : G_NORMAL;
        g.dx = random(2) ? 1 : -1; g.dy = 0;
      }
      return;
    case G_ENTERING:
      g.y += 2;
      if (g.y >= 7 * TS) { g.y = 7 * TS; g.mode = G_PEN; g.releaseAt = now + 900; g.dx = 0; g.dy = 0; }
      return;
    default: break;
  }
  int sp = (g.mode == G_EATEN) ? 12 : (g.mode == G_FRIGHT ? 4 : ghostSpeedQ);
  g.acc += sp;
  int steps = g.acc >> 2; g.acc &= 3;
  for (int s = 0; s < steps; s++) {
    if (g.x % TS == 0 && g.y % TS == 0) {
      if (g.mode == G_EATEN && g.x / TS == 8 && g.y / TS == 5) { g.mode = G_ENTERING; g.dx = 0; g.dy = 1; return; }
      ghostDecide(i);
    }
    g.x += g.dx; g.y += g.dy;
  }
}

// ============================== FLUJO DE JUEGO ==============================
void gameOver() {
  state = S_OVER;
  overStart = millis();
  if (score > hiScore) { hiScore = score; newRecord = true; prefs.putUInt("hi", hiScore); }
  tft.fillScreen(C_BLACK);
  printC("GAME OVER", 80, 2, C_RED);
  char b[28]; snprintf(b, sizeof(b), "SCORE %lu", (unsigned long)score);
  printC(b, 112, 2, C_WHITE);
  if (newRecord) printC("NUEVO RECORD!", 142, 1, SK.text);
  else { snprintf(b, sizeof(b), "RECORD %lu", (unsigned long)hiScore); printC(b, 142, 1, SK.dot); }
  playSeq(SND_OVER, NN(SND_OVER), 3);
}

void dieSequence() {
  playSeq(SND_DEATH, NN(SND_DEATH), 3);
  for (int i = 0; i < 4; i++) restoreRect(ghosts[i].x, ghosts[i].y);
  waitMs(350);
  for (int r = 5; r >= 0; r--) {
    restoreRect(pac.x, pac.y);
    if (r > 0) tft.fillCircle(OX + pac.x + 5, OY + pac.y + 5, r, SK.pac);
    waitMs(110);
  }
  waitMs(300);
  lives--;
  if (lives <= 0) gameOver();
  else startRound(false);
}

void levelClear() {
  playSeq(SND_LEVEL, NN(SND_LEVEL), 3);
  waitMs(400);
  for (int i = 0; i < 6; i++) { flashWhite = (i & 1) == 0; drawMaze(); waitMs(180); }
  flashWhite = false;
  level++;
  loadLevel();
  startRound(false);
}

void enterPause() {
  pauseStart = millis();
  state = S_PAUSE;
  buzz(0);
  tft.fillRect(50, 98, 140, 46, C_BLACK);
  tft.drawRect(50, 98, 140, 46, SK.wallLine);
  printC("PAUSA", 104, 2, SK.text);
  printC("OK:SEGUIR  <:SALIR", 128, 1, C_WHITE);
}

void tickPlay(uint32_t now) {
  if (btnPress[B_OK]) { enterPause(); return; }

  int d = -1;
  for (int i = 0; i < 4; i++) if (btnPress[i]) d = i;
  if (d < 0) {
    int cnt = 0, last = -1;
    for (int i = 0; i < 4; i++) if (btnHeld[i]) { cnt++; last = i; }
    if (cnt == 1) d = last;
  }
  if (d >= 0) { pac.ndx = BDX[d]; pac.ndy = BDY[d]; }

  if (now - blinkT >= 250) {
    blinkT = now; blinkOn = !blinkOn;
    for (int r = 0; r < ROWS; r++) for (int c = 0; c < COLS; c++) if (maze[r][c] == 'o') drawTile(c, r);
  }

  pac.px = pac.x; pac.py = pac.y;
  for (int i = 0; i < 4; i++) { ghosts[i].px = ghosts[i].x; ghosts[i].py = ghosts[i].y; }

  movePac(now);

  if (frightActive && (int32_t)(now - frightUntil) >= 0) {
    frightActive = false;
    for (int i = 0; i < 4; i++) if (ghosts[i].mode == G_FRIGHT) ghosts[i].mode = G_NORMAL;
  }
  if (!frightActive && (int32_t)(now - modeUntil) >= 0) {
    scatter = !scatter;
    modeUntil = now + (scatter ? 5000 : 18000);
    for (int i = 0; i < 4; i++) if (ghosts[i].mode == G_NORMAL) { ghosts[i].dx = -ghosts[i].dx; ghosts[i].dy = -ghosts[i].dy; }
  }

  for (int i = 0; i < 4; i++) moveGhost(i, now);

  bool dead = false;
  for (int i = 0; i < 4; i++) {
    Ghost &g = ghosts[i];
    if (g.mode == G_PEN || g.mode == G_ENTERING || g.mode == G_EATEN) continue;
    if (abs(g.x - pac.x) < 8 && abs(g.y - pac.y) < 8) {
      if (g.mode == G_FRIGHT) {
        g.mode = G_EATEN;
        score += ghostCombo; ghostCombo *= 2; scoreDirty = true;
        restoreRect(g.x, g.y);
        playSeq(SND_GHOST, NN(SND_GHOST), 2);
      } else dead = true;
    }
  }

  restoreRect(pac.px, pac.py);
  for (int i = 0; i < 4; i++) if (ghosts[i].px != ghosts[i].x || ghosts[i].py != ghosts[i].y) restoreRect(ghosts[i].px, ghosts[i].py);
  drawActors(now);

  if (scoreDirty) {
    drawScore(); scoreDirty = false;
    if (score >= nextLife) { nextLife += 10000; if (lives < 5) lives++; drawLives(); playSeq(SND_LIFE, NN(SND_LIFE), 2); }
  }
  if (dead) { dieSequence(); return; }
  if (dotsLeft <= 0) { levelClear(); return; }
}

void tickPause() {
  if (btnPress[B_LEFT]) { state = S_MENU; drawMenu(); return; }
  if (btnPress[B_OK]) {
    uint32_t delta = millis() - pauseStart;
    frightUntil += delta; modeUntil += delta;
    for (int i = 1; i < 4; i++) ghosts[i].releaseAt += delta;
    tft.fillScreen(C_BLACK);
    drawMaze(); drawScore(); drawLives(); drawActors(millis());
    state = S_PLAY;
  }
}

void tickOver(uint32_t now) {
  if (now - overStart > 1500 && (btnPress[B_OK] || btnPress[B_RIGHT])) {
    click(); state = S_MENU; drawMenu();
  }
}

// ============================== MENU ==============================
int menuSel = 0, optSel = 0, mx = 50;

void saveSettings() {
  prefs.putBool("snd", soundOn);
  prefs.putUChar("skin", skinIdx);
  prefs.putUChar("diff", diffIdx);
}
void drawMenuItems() {
  const char* items[2] = {"JUGAR", "OPCIONES"};
  for (int i = 0; i < 2; i++) {
    int y = 88 + i * 30;
    tft.fillRect(30, y - 2, 180, 20, C_BLACK);
    char b[20];
    if (i == menuSel) snprintf(b, sizeof(b), "> %s <", items[i]); else snprintf(b, sizeof(b), "%s", items[i]);
    printC(b, y, 2, i == menuSel ? SK.text : C_WHITE);
  }
}
void menuDots() { for (int x = 64; x <= 176; x += 14) tft.fillRect(x, 194, 3, 3, SK.dot); }
void menuAnimReset() { mx = 50; tft.fillRect(36, 186, 168, 22, C_BLACK); menuDots(); }
void drawMenu() {
  tft.fillScreen(C_BLACK);
  printC("PAC-MAN", 38, 3, SK.pac);
  drawMenuItems();
  char b[24]; snprintf(b, sizeof(b), "RECORD %lu", (unsigned long)hiScore);
  printC(b, 160, 1, SK.dot);
  printC("< VOLVER AL ARCADE", 172, 1, C565(150, 150, 150));
  menuAnimReset();
}
void menuAnim() {
  const int y = 189;
  tft.fillRect(mx - 2, y, 16, 13, C_BLACK);
  tft.fillRect(mx - 30, y, 16, 13, C_BLACK);
  mx += 2;
  if (mx > 186) { menuAnimReset(); return; }
  drawGhostSprite(mx - 28, y + 1, SK.ghost[0], 1, 0, false, false, false);
  drawPacSprite(mx, y + 1, 1, 0, ((mx >> 2) & 1) ? 4 : 1, SK.pac);
}
void tickMenu() {
  if (btnPress[B_LEFT]) { click(); pacSalir = true; return; }
  if (btnPress[B_UP] || btnPress[B_DOWN]) { menuSel = 1 - menuSel; click(); drawMenuItems(); }
  if (btnPress[B_OK] || btnPress[B_RIGHT]) {
    click();
    if (menuSel == 0) startGame();
    else { state = S_OPTIONS; optSel = 0; drawOptions(); }
    return;
  }
  menuAnim();
}

// ============================== OPCIONES ==============================
void drawSkinPreview() {
  tft.fillRect(44, 176, 152, 40, C_BLACK);
  int x = 64, y = 180;
  drawPacSprite(x, y, 1, 0, 3, SK.pac);
  for (int i = 0; i < 4; i++) drawGhostSprite(x + 22 + i * 20, y, SK.ghost[i], 1, 0, false, false, false);
  tft.fillRect(60, 202, 120, 8, SK.wallFill);
  tft.drawRect(60, 202, 120, 8, SK.wallLine);
}
void drawOptRows() {
  char b[28];
  for (int i = 0; i < 4; i++) {
    int y = 62 + i * 28;
    tft.fillRect(10, y - 2, 220, 20, C_BLACK);
    switch (i) {
      case 0: snprintf(b, sizeof(b), "SONIDO: %s", soundOn ? "SI" : "NO"); break;
      case 1: snprintf(b, sizeof(b), "SKIN: %s", SK.name); break;
      case 2: snprintf(b, sizeof(b), "DIF: %s", DIFF_NAMES[diffIdx]); break;
      default: snprintf(b, sizeof(b), "VOLVER"); break;
    }
    printC(b, y, 2, i == optSel ? SK.text : C_WHITE);
    if (i == optSel) tft.fillTriangle(20, y + 1, 20, y + 15, 30, y + 8, SK.text);
  }
}
void drawOptions() {
  tft.fillScreen(C_BLACK);
  printC("OPCIONES", 24, 2, SK.pac);
  drawOptRows();
  drawSkinPreview();
}
void tickOptions() {
  if (btnPress[B_UP])   { optSel = (optSel + 3) % 4; click(); drawOptRows(); }
  if (btnPress[B_DOWN]) { optSel = (optSel + 1) % 4; click(); drawOptRows(); }
  if (optSel == 3) {
    if (btnPress[B_OK]) { click(); saveSettings(); state = S_MENU; drawMenu(); }
    return;
  }
  int d = 0;
  if (btnPress[B_LEFT]) d = -1;
  if (btnPress[B_RIGHT] || btnPress[B_OK]) d = 1;
  if (!d) return;
  if (optSel == 0) { soundOn = !soundOn; if (!soundOn) buzz(0); click(); drawOptRows(); }
  else if (optSel == 1) { skinIdx = (skinIdx + NUM_SKINS + d) % NUM_SKINS; click(); drawOptions(); }
  else if (optSel == 2) { diffIdx = (diffIdx + 3 + d) % 3; click(); drawOptRows(); }
  saveSettings();
}

// ============================== PAC-MAN COMO JUEGO DEL ARCADE ==============================
// Corre el bucle de Pac-Man hasta que el jugador sale desde su menu (IZQUIERDA)
void runPacman() {
  pacSalir = false;
  state = S_MENU;
  menuSel = 0;
  drawMenu();
  clearPresses();
  uint32_t last = 0;
  while (!pacSalir) {
    uint32_t now = millis();
    updateSound(now);
    readButtons(now);
    if (now - last < FRAME_MS) { delay(1); continue; }
    last = now;
    switch (state) {
      case S_MENU:    tickMenu();       break;
      case S_OPTIONS: tickOptions();    break;
      case S_PLAY:    tickPlay(now);    break;
      case S_PAUSE:   tickPause();      break;
      case S_OVER:    tickOver(now);    break;
    }
    clearPresses();
  }
  buzz(0);
  seqPtr = nullptr; seqPrio = 0;
}

