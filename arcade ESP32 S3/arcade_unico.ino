namespace inv {

// ---------------------------------------------------------------- sprites (# = pixel)
const char* const SQUID_A[8] = {"...##...", "..####..", ".######.", "##.##.##", "########", "..#..#..", ".#.##.#.", "#.#..#.#"};
const char* const SQUID_B[8] = {"...##...", "..####..", ".######.", "##.##.##", "########", ".#.##.#.", "#......#", ".#....#."};
const char* const CRAB_A[8]  = {"..#.....#..", "...#...#...", "..#######..", ".##.###.##.", "###########", "#.#######.#", "#.#.....#.#", "...##.##..."};
const char* const CRAB_B[8]  = {"..#.....#..", "#..#...#..#", "#.#######.#", "###.###.###", "###########", ".#########.", "..#.....#..", ".#.......#."};
const char* const OCTO_A[8]  = {"....####....", ".##########.", "############", "###..##..###", "############", "...##..##...", "..##.##.##..", "##........##"};
const char* const OCTO_B[8]  = {"....####....", ".##########.", "############", "###..##..###", "############", "..###..###..", ".##..##..##.", "..##....##.."};
const char* const NAVE[8]    = {"......#......", ".....###.....", ".....###.....", ".###########.", "#############", "#############", "#############", "#############"};
const char* const UFO[7]     = {".....######.....", "...##########...", "..############..", ".##.##.##.##.##.", "################", "..###..##..###..", "...#........#..."};
const char* const BOOM[8]    = {"#...#..#...#", ".#..#..#..#.", "..#.....#...", "#..#####..#.", "...#####....", "..#.....#...", ".#..#..#..#.", "#...#..#...#"};
const char* const BOOMN[8]   = {"..#..#..#.#.", ".#.#.##.#.#.", "#.#.####.#.#", ".#.######.#.", "#.#.####.#.#", ".#.#.##.#.#.", "#..#.##.#..#", ".#.#.#..#.#."};

const int ANCHO_CEL = 20, ALTO_CEL = 16, FILAS = 4, COLUMNAS = 6;
const int XMIN = 28, XMAX = 212;           // limites de la formacion
const int Y_NAVE = 198, Y_ESC = 160, Y_UFO = 40, Y_SUELO = 210;
const int ESC_N = 3, ESC_W = 11, ESC_H = 6;  // 3 escudos, 11x6 celdas de 2x2 px

const uint16_t C_FILA0[FILAS] = {C565(255, 80, 255), C565(0, 240, 255), C565(0, 240, 255), C565(120, 255, 60)};
const uint16_t C_NAVE0  = C565(60, 255, 90);
const uint16_t C_ESC0   = C565(60, 220, 60);
const uint16_t C_UFO0   = C565(255, 50, 80);
const uint16_t C_DISP   = C565(255, 255, 255);
const uint16_t C_BALA0  = C565(255, 220, 60);
const uint16_t ACENTO0  = C565(60, 255, 90);
// colores en uso (originales + skin elegida)
uint16_t C_FILA[FILAS], C_NAVE, C_ESC, C_UFO, C_BALA, ACENTO;
void aplicarSkin() {
  for (int i = 0; i < FILAS; i++) C_FILA[i] = skinTinte(C_FILA0[i]);
  C_NAVE = skinTinte(C_NAVE0); C_ESC = skinTinte(C_ESC0); C_UFO = skinTinte(C_UFO0);
  C_BALA = skinTinte(C_BALA0); ACENTO = skinTinte(ACENTO0);
}

const char* const FORMA_ESC[ESC_H] = {".#########.", "###########", "###########", "###########", "####...####", "###.....###"};

struct Bala { int16_t x, y; bool on; uint8_t tipo; };

bool     vivo[FILAS][COLUMNAS];
uint8_t  escudo[ESC_N][ESC_H][ESC_W];
int      ox, oy, dir, frameAnim, vivos;
uint32_t tPaso, tUfo, tExplosion, ufoMsgHasta;
int      expX, expY; bool expOn;
int      nx;                                   // posicion de la nave (centro)
Bala     bn;                                   // bala de la nave
Bala     bi[4];                                // balas de los invasores
int      maxBalasI;
float    ufoX; int ufoDir; bool ufoOn;
uint32_t puntos, record, proxVida; int vidas, nivel, pasoSnd;
uint32_t pPuntos; int pVidas;

const Note SND_DISPARO[] = {{1800, 15}, {1200, 15}};
const Note SND_MATAR[]   = {{500, 25}, {300, 25}, {150, 40}};
const Note SND_GOLPE[]   = {{300, 60}, {200, 60}, {120, 80}, {80, 120}, {60, 120}};
const Note SND_UFO[]     = {{900, 30}, {1300, 30}, {900, 30}, {1300, 30}};
const Note SND_PASO[4][1] = {{{180, 28}}, {{160, 28}}, {{140, 28}}, {{120, 28}}};
const Note SND_SUBE[]    = {{523, 80}, {659, 80}, {784, 80}, {1047, 160}};

// ---------------------------------------------------------------- utilidades
int anchoTipo(int fila) { return fila == 0 ? 8 : (fila < 3 ? 11 : 12); }

const char* const* spriteInvasor(int fila, int frame) {
  if (fila == 0) return frame ? SQUID_B : SQUID_A;
  if (fila < 3)  return frame ? CRAB_B : CRAB_A;
  return frame ? OCTO_B : OCTO_A;
}
int posX(int c, int fila) { return ox + c * ANCHO_CEL + (14 - anchoTipo(fila)) / 2; }
int posY(int f) { return oy + f * ALTO_CEL; }
int escX(int s) { return 120 - (ESC_N * 22 + (ESC_N - 1) * 36) / 2 + s * 58; }

void dibujarInvasor(int c, int f) {
  spriteTxt(posX(c, f), posY(f), spriteInvasor(f, frameAnim), anchoTipo(f), 8, C_FILA[f]);
}
void borrarInvasor(int c, int f) { tft.fillRect(posX(c, f), posY(f), anchoTipo(f), 8, NEGRO); }

void dibujarCeldaEsc(int s, int cx, int cy) {
  int x = escX(s) + cx * 2, y = Y_ESC + cy * 2;
  tft.fillRect(x, y, 2, 2, escudo[s][cy][cx] ? C_ESC : NEGRO);
}
void dibujarEscudos() {
  for (int s = 0; s < ESC_N; s++)
    for (int r = 0; r < ESC_H; r++)
      for (int c = 0; c < ESC_W; c++) if (escudo[s][r][c]) dibujarCeldaEsc(s, c, r);
}
void reiniciarEscudos() {
  for (int s = 0; s < ESC_N; s++)
    for (int r = 0; r < ESC_H; r++)
      for (int c = 0; c < ESC_W; c++) escudo[s][r][c] = (FORMA_ESC[r][c] == '#');
}

// Si el punto (x,y) toca un escudo, lo daña y devuelve true
bool golpeEscudo(int x, int y) {
  for (int s = 0; s < ESC_N; s++) {
    int ex = escX(s);
    if (x < ex || x >= ex + ESC_W * 2 || y < Y_ESC || y >= Y_ESC + ESC_H * 2) continue;
    int cx = (x - ex) / 2, cy = (y - Y_ESC) / 2;
    if (!escudo[s][cy][cx]) continue;
    escudo[s][cy][cx] = 0; dibujarCeldaEsc(s, cx, cy);
    for (int k = 0; k < 2; k++) {                     // desmorona un poco alrededor
      int nxc = cx + (int)random(3) - 1, nyc = cy + (int)random(3) - 1;
      if (nxc >= 0 && nxc < ESC_W && nyc >= 0 && nyc < ESC_H && escudo[s][nyc][nxc]) {
        escudo[s][nyc][nxc] = 0; dibujarCeldaEsc(s, nxc, nyc);
      }
    }
    return true;
  }
  return false;
}

// Borra un rectangulo (bala) y repinta las celdas de escudo que tocaba
void borrarRect(int x, int y, int w, int h) {
  tft.fillRect(x, y, w, h, NEGRO);
  if (y + h <= Y_ESC || y >= Y_ESC + ESC_H * 2) return;
  for (int s = 0; s < ESC_N; s++) {
    int ex = escX(s);
    if (x + w <= ex || x >= ex + ESC_W * 2) continue;
    for (int cy = 0; cy < ESC_H; cy++) for (int cx = 0; cx < ESC_W; cx++) {
      int px = ex + cx * 2, py = Y_ESC + cy * 2;
      if (escudo[s][cy][cx] && px + 2 > x && px < x + w && py + 2 > y && py < y + h) dibujarCeldaEsc(s, cx, cy);
    }
  }
}

// Los invasores que bajan comen los escudos
void comerEscudos() {
  for (int f = 0; f < FILAS; f++) for (int c = 0; c < COLUMNAS; c++) {
    if (!vivo[f][c]) continue;
    int y0 = posY(f), y1 = y0 + 8;
    if (y1 < Y_ESC || y0 >= Y_ESC + ESC_H * 2) continue;
    int x0 = posX(c, f), x1 = x0 + anchoTipo(f);
    for (int s = 0; s < ESC_N; s++) {
      int ex = escX(s);
      if (x1 < ex || x0 >= ex + ESC_W * 2) continue;
      for (int cy = 0; cy < ESC_H; cy++) for (int cx = 0; cx < ESC_W; cx++) {
        int px = ex + cx * 2, py = Y_ESC + cy * 2;
        if (escudo[s][cy][cx] && px + 2 > x0 && px < x1 && py + 2 > y0 && py < y1) {
          escudo[s][cy][cx] = 0; dibujarCeldaEsc(s, cx, cy);
        }
      }
    }
  }
}

void dibujarHUD(bool todo) {
  if (todo || pPuntos != puntos) {
    char b[40]; snprintf(b, sizeof(b), "PUNTOS %05lu  NIV %d", (unsigned long)puntos, nivel);
    tft.fillRect(40, 24, 160, 10, NEGRO);
    printC(b, 26, 1, BLANCO);
    pPuntos = puntos;
  }
  if (todo || pVidas != vidas) {
    tft.fillRect(80, 218, 80, 12, NEGRO);
    for (int i = 0; i < vidas && i < 5; i++) {
      int x = 86 + i * 15;
      tft.fillRect(x + 4, 219, 3, 2, C_NAVE);
      tft.fillRect(x + 1, 221, 9, 3, C_NAVE);
      tft.fillRect(x, 224, 11, 3, C_NAVE);
    }
    pVidas = vidas;
  }
}

void contarVivos() {
  vivos = 0;
  for (int f = 0; f < FILAS; f++) for (int c = 0; c < COLUMNAS; c++) if (vivo[f][c]) vivos++;
}

void nuevaOleada() {
  for (int f = 0; f < FILAS; f++) for (int c = 0; c < COLUMNAS; c++) vivo[f][c] = true;
  contarVivos();
  int bajada = (nivel - 1) * 8; if (bajada > 32) bajada = 32;
  ox = 63; oy = 56 + bajada; dir = 1; frameAnim = 0;
  maxBalasI = 2 + nivel / 3; if (maxBalasI > 4) maxBalasI = 4;
  for (int i = 0; i < 4; i++) bi[i].on = false;
  bn.on = false;
  reiniciarEscudos();
  tPaso = millis() + 500;
  tUfo = millis() + 9000 + random(8000);
  ufoOn = false;
}

void dibujarEscenario() {
  tft.fillScreen(NEGRO);
  tft.drawFastHLine(30, Y_SUELO, 180, C565(40, 160, 60));
  dibujarEscudos();
  for (int f = 0; f < FILAS; f++) for (int c = 0; c < COLUMNAS; c++) if (vivo[f][c]) dibujarInvasor(c, f);
  spriteTxt(nx - 6, Y_NAVE, NAVE, 13, 8, C_NAVE);
  dibujarHUD(true);
}

// ---------------------------------------------------------------- bucle de juego
void pasoInvasores(uint32_t now) {
  int minC = COLUMNAS, maxC = -1;
  for (int f = 0; f < FILAS; f++) for (int c = 0; c < COLUMNAS; c++) if (vivo[f][c]) {
    if (c < minC) minC = c;
    if (c > maxC) maxC = c;
  }
  if (maxC < 0) return;
  int izq = ox + minC * ANCHO_CEL, der = ox + maxC * ANCHO_CEL + 14;
  bool baja = (dir > 0 && der + 4 > XMAX) || (dir < 0 && izq - 4 < XMIN);

  for (int f = 0; f < FILAS; f++) for (int c = 0; c < COLUMNAS; c++) if (vivo[f][c]) borrarInvasor(c, f);
  if (baja) { oy += 8; dir = -dir; } else ox += dir * 4;
  frameAnim ^= 1;
  for (int f = 0; f < FILAS; f++) for (int c = 0; c < COLUMNAS; c++) if (vivo[f][c]) dibujarInvasor(c, f);
  comerEscudos();
  playSeq(SND_PASO[pasoSnd & 3], 1, 0); pasoSnd++;

  int ms = 36 + vivos * 15 - (nivel - 1) * 14;
  if (ms < 14) ms = 14;
  ms = ms * DIF_PCT[diffIdx] / 100;
  tPaso = now + ms;
}

void disparoInvasor() {
  int libre = -1, activas = 0;
  for (int i = 0; i < 4; i++) { if (bi[i].on) activas++; else libre = i; }
  if (libre < 0 || activas >= maxBalasI) return;
  if ((int)random(100) >= 2 + nivel) return;
  int c = random(COLUMNAS);
  for (int f = FILAS - 1; f >= 0; f--) if (vivo[f][c]) {
    bi[libre].x = posX(c, f) + anchoTipo(f) / 2;
    bi[libre].y = posY(f) + 8;
    bi[libre].on = true;
    bi[libre].tipo = random(2);
    return;
  }
}

void explosionNave() {
  playSeq(SND_GOLPE, NN(SND_GOLPE), 3);
  for (int k = 0; k < 8; k++) {
    spriteTxt(nx - 6, Y_NAVE, (k & 1) ? BOOM : BOOMN, 12, 8, (k & 1) ? C565(255, 200, 0) : C565(255, 60, 30));
    waitMs(110);
  }
  tft.fillRect(nx - 8, Y_NAVE - 1, 16, 10, NEGRO);
}

// Juega una partida. Devuelve true si perdio, false si salio por la pausa
bool partida() {
  randomSeed(micros());
  puntos = 0; vidas = 3; nivel = 1; proxVida = 1500; nx = 120; pasoSnd = 0; expOn = false; ufoMsgHasta = 0;
  nuevaOleada();
  dibujarEscenario();
  clearPresses();
  uint32_t ultimo = 0;

  for (;;) {
    uint32_t now = millis();
    updateSound(now);
    readButtons(now);
    if (now - ultimo < FRAME_MS) { delay(1); continue; }
    ultimo = now;

    if (btnPress[B_OK]) {
      clearPresses();
      if (menuPausa(ACENTO)) return false;
      dibujarEscenario();
      continue;
    }

    // ---- nave
    int mv = (btnHeld[B_LEFT] ? -1 : 0) + (btnHeld[B_RIGHT] ? 1 : 0);
    if (mv) {
      int nuevo = constrain(nx + mv * 3, 44, 196);
      if (nuevo != nx) {
        tft.fillRect(nx - 6, Y_NAVE, 13, 8, NEGRO);
        nx = nuevo;
        spriteTxt(nx - 6, Y_NAVE, NAVE, 13, 8, C_NAVE);
      }
    }
    if ((btnPress[B_UP] || btnHeld[B_UP]) && !bn.on) {
      bn.x = nx; bn.y = Y_NAVE - 6; bn.on = true;
      playSeq(SND_DISPARO, NN(SND_DISPARO), 1);
    }

    // ---- bala de la nave
    if (bn.on) {
      borrarRect(bn.x, bn.y, 2, 6);
      bn.y -= 7;
      bool fin = false;
      if (bn.y < 30) fin = true;
      // contra invasores
      for (int f = 0; f < FILAS && !fin; f++) for (int c = 0; c < COLUMNAS && !fin; c++) {
        if (!vivo[f][c]) continue;
        int x0 = posX(c, f), y0 = posY(f);
        if (bn.x + 1 >= x0 && bn.x < x0 + anchoTipo(f) && bn.y <= y0 + 8 && bn.y + 6 >= y0) {
          vivo[f][c] = false; vivos--;
          borrarInvasor(c, f);
          static const uint8_t pts[FILAS] = {30, 20, 20, 10};
          puntos += pts[f];
          playSeq(SND_MATAR, NN(SND_MATAR), 2);
          expX = x0 - 1; expY = y0; expOn = true; tExplosion = now + 130;
          spriteTxt(expX, expY, BOOM, 12, 8, C565(255, 255, 255));
          fin = true;
        }
      }
      // contra el ovni
      if (!fin && ufoOn && bn.y <= Y_UFO + 7 && bn.y + 6 >= Y_UFO && bn.x >= (int)ufoX && bn.x < (int)ufoX + 16) {
        static const uint16_t ptsU[4] = {50, 100, 150, 300};
        uint16_t p = ptsU[random(4)];
        puntos += p; ufoOn = false;
        tft.fillRect((int)ufoX, Y_UFO, 16, 7, NEGRO);
        char b[8]; snprintf(b, sizeof(b), "%u", p);
        tft.setTextSize(1); tft.setTextColor(C_UFO); tft.setCursor((int)ufoX, Y_UFO); tft.print(b);
        playSeq(SND_MATAR, NN(SND_MATAR), 2);
        ufoMsgHasta = now + 800;
        tUfo = now + 12000 + random(10000);
        fin = true;
      }
      if (!fin && golpeEscudo(bn.x, bn.y)) fin = true;
      if (fin) bn.on = false;
      else tft.fillRect(bn.x, bn.y, 2, 6, C_DISP);
    }
    if (expOn && (int32_t)(now - tExplosion) >= 0) {
      tft.fillRect(expX, expY, 12, 8, NEGRO); expOn = false;
    }

    // ---- ovni
    if (ufoMsgHasta && (int32_t)(now - ufoMsgHasta) >= 0) { tft.fillRect(30, Y_UFO, 180, 8, NEGRO); ufoMsgHasta = 0; }
    if (!ufoOn && (int32_t)(now - tUfo) >= 0) {
      if (vivos > 6 && oy < 110) {
        ufoOn = true; ufoDir = random(2) ? 1 : -1;
        ufoX = ufoDir > 0 ? 32 : 192;
        playSeq(SND_UFO, NN(SND_UFO), 1);
      }
      tUfo = now + 12000 + random(10000);
    }
    if (ufoOn) {
      tft.fillRect((int)ufoX, Y_UFO, 16, 7, NEGRO);
      ufoX += ufoDir * 2;
      if (ufoX < 30 || ufoX > 194) { ufoOn = false; tft.fillRect(28, Y_UFO, 184, 8, NEGRO); }
      else spriteTxt((int)ufoX, Y_UFO, UFO, 16, 7, C_UFO);
    }

    // ---- invasores
    if ((int32_t)(now - tPaso) >= 0) pasoInvasores(now);
    disparoInvasor();

    // ---- balas enemigas
    bool golpeado = false;
    for (int i = 0; i < 4; i++) {
      if (!bi[i].on) continue;
      borrarRect(bi[i].x - 1, bi[i].y, 3, 7);
      bi[i].y += 3 + (nivel > 3 ? 1 : 0) + (nivel > 6 ? 1 : 0);
      bool fin = false;
      if (bi[i].y >= Y_SUELO - 6) fin = true;
      else if (bi[i].y + 7 >= Y_NAVE && bi[i].y <= Y_NAVE + 8 && bi[i].x >= nx - 6 && bi[i].x <= nx + 6) { golpeado = true; fin = true; }
      else if (golpeEscudo(bi[i].x, bi[i].y + 6)) fin = true;
      else if (bn.on && bn.x + 1 >= bi[i].x - 1 && bn.x <= bi[i].x + 1 && bn.y <= bi[i].y + 7 && bn.y + 6 >= bi[i].y) {   // se cruzan las balas
        borrarRect(bn.x, bn.y, 2, 6); bn.on = false; fin = true;
      }
      if (fin) bi[i].on = false;
      else {
        int x = bi[i].x - 1, y = bi[i].y;
        tft.fillRect(x + 1, y, 1, 7, C_BALA);
        tft.fillRect(x + (bi[i].tipo ^ ((y >> 2) & 1)) * 2, y + 2, 1, 2, C_BALA);
      }
    }

    // ---- consecuencias
    if (golpeado) {
      explosionNave();
      vidas--;
      for (int i = 0; i < 4; i++) { if (bi[i].on) borrarRect(bi[i].x - 1, bi[i].y, 3, 7); bi[i].on = false; }
      if (bn.on) { borrarRect(bn.x, bn.y, 2, 6); bn.on = false; }
      if (vidas <= 0) return true;
      nx = 120; spriteTxt(nx - 6, Y_NAVE, NAVE, 13, 8, C_NAVE);
      dibujarHUD(true);
      waitMs(500);
      clearPresses();
      tPaso = millis() + 400;
      continue;
    }
    // invasores llegaron abajo
    bool llegaron = false;
    for (int f = FILAS - 1; f >= 0 && !llegaron; f--) for (int c = 0; c < COLUMNAS; c++)
      if (vivo[f][c] && posY(f) + 8 >= Y_NAVE - 2) { llegaron = true; break; }
    if (llegaron) { explosionNave(); return true; }

    if (puntos >= proxVida) { proxVida += 1500; if (vidas < 5) vidas++; playSeq(SND_SUBE, NN(SND_SUBE), 2); }
    dibujarHUD(false);

    if (vivos <= 0) {
      playSeq(SND_SUBE, NN(SND_SUBE), 3);
      waitMs(900);
      nivel++;
      nuevaOleada();
      dibujarEscenario();
      clearPresses();
    }
    clearPresses();
  }
}

void jugar() {
  for (;;) {
    record = prefsA.getUInt("hiInv", 0);
    if (!menuJuego("INVADERS", ACENTO0, record, 1)) return;
    aplicarSkin();
    for (;;) {
      pPuntos = 0xFFFFFFFF; pVidas = -1;
      bool perdio = partida();
      if (!perdio) break;
      bool nuevo = puntos > record;
      if (nuevo) { record = puntos; prefsA.putUInt("hiInv", record); }
      if (!pantallaFin(puntos, record, nuevo, ACENTO)) break;
    }
  }
}

