Preferences prefsA;                       // records de los juegos nuevos (espacio "arcade")

const uint16_t NEGRO  = 0x0000;
const uint16_t BLANCO = 0xFFFF;

// Mezcla dos colores RGB565. t = 0 -> a, t = 255 -> b
uint16_t mezclar565(uint16_t a, uint16_t b, uint8_t t) {
  int ra = (a >> 11) & 31, ga = (a >> 5) & 63, ba = a & 31;
  int rb = (b >> 11) & 31, gb = (b >> 5) & 63, bb = b & 31;
  int r = ra + ((rb - ra) * (int)t) / 255;
  int g = ga + ((gb - ga) * (int)t) / 255;
  int bl = ba + ((bb - ba) * (int)t) / 255;
  return (uint16_t)((r << 11) | (g << 5) | bl);
}
inline uint16_t aclarar(uint16_t c)  { return mezclar565(c, 0xFFFF, 100); }
inline uint16_t oscurecer(uint16_t c) { return mezclar565(c, 0x0000, 120); }

// Espera un momento sin perder los botones ni el sonido
void esperar(uint32_t ms) {
  uint32_t t = millis();
  while (millis() - t < ms) { updateSound(millis()); delay(2); }
}

// Menu de pausa. Devuelve true si el jugador elige SALIR al menu.
// Despues de seguir, el juego tiene que redibujar toda la pantalla.
bool menuPausa(uint16_t acento) {
  buzz(0);
  tft.fillRoundRect(46, 88, 148, 66, 6, NEGRO);
  tft.drawRoundRect(46, 88, 148, 66, 6, acento);
  printC("PAUSA", 94, 2, acento);
  printC("OK: SEGUIR", 120, 1, BLANCO);
  printC("<: SALIR", 134, 1, BLANCO);
  clearPresses();
  for (;;) {
    uint32_t now = millis();
    readButtons(now);
    updateSound(now);
    if (btnPress[B_OK])   { clearPresses(); return false; }
    if (btnPress[B_LEFT]) { clearPresses(); return true; }
    clearPresses();
    delay(5);
  }
}

// Pantalla de fin de partida. Devuelve true = jugar otra vez, false = volver al menu.
bool pantallaFin(uint32_t pts, uint32_t rec, bool nuevoRec, uint16_t acento) {
  tft.fillScreen(NEGRO);
  printC("GAME OVER", 56, 2, C_RED);
  char b[32];
  snprintf(b, sizeof(b), "PUNTOS %lu", (unsigned long)pts);
  printC(b, 92, 2, BLANCO);
  if (nuevoRec) {
    printC("NUEVO RECORD!", 124, 1, acento);
  } else {
    snprintf(b, sizeof(b), "RECORD %lu", (unsigned long)rec);
    printC(b, 124, 1, acento);
  }
  printC("OK: OTRA VEZ", 158, 1, BLANCO);
  printC("<: MENU", 172, 1, BLANCO);
  playSeq(SND_OVER, NN(SND_OVER), 3);
  uint32_t t0 = millis();
  clearPresses();
  for (;;) {
    uint32_t now = millis();
    readButtons(now);
    updateSound(now);
    if (now - t0 > 900) {
      if (btnPress[B_OK])   { clearPresses(); return true; }
      if (btnPress[B_LEFT]) { clearPresses(); return false; }
    }
    clearPresses();
    delay(5);
  }
}

// Manda un lienzo (GFXcanvas16) completo a la pantalla en (x, y)
void empujarLienzo(GFXcanvas16* c, int x, int y) {
  int w = c->width(), h = c->height();
  uint16_t* buf = c->getBuffer();
  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  for (int r = 0; r < h; r++) tft.writePixels(buf + (size_t)r * w, w);
  tft.endWrite();
}

// Dibuja un sprite de caracteres ('#' = pixel) directo en la pantalla, con fondo negro
void spriteTxt(int x, int y, const char* const* filas, int w, int h, uint16_t col) {
  static uint16_t buf[24 * 16];
  for (int j = 0; j < h; j++)
    for (int i = 0; i < w; i++) buf[j * w + i] = (filas[j][i] == '#') ? col : 0;
  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  tft.writePixels(buf, w * h);
  tft.endWrite();
}

// Pregunta si se puede reservar memoria para un lienzo; muestra aviso si no
GFXcanvas16* crearLienzo(int w, int h) {
  GFXcanvas16* c = new GFXcanvas16(w, h);
  if (c && c->getBuffer()) return c;
  if (c) delete c;
  tft.fillScreen(NEGRO);
  printC("SIN MEMORIA", 110, 2, C_RED);
  waitMs(1500);
  return nullptr;
}


// ---------------------------------------------------------------------
//  SKIN y DIFICULTAD globales para los juegos nuevos
//  (los ajustes se cambian en el menu OPCIONES de cualquier juego y se guardan)
// ---------------------------------------------------------------------
// Aplica la skin elegida (skinIdx) a un color: CLASSIC lo deja igual; las demas lo re-tiñen
uint16_t skinTinte(uint16_t c) {
  if (skinIdx == 0) return c;
  int r = ((c >> 11) & 31) << 3, g = ((c >> 5) & 63) << 2, b = (c & 31) << 3;
  int l = (r * 30 + g * 59 + b * 11) / 100;            // luminosidad 0..255
  switch (skinIdx) {
    case 1:                                            // NEON: mas saturado y vivo
      r = l + (r - l) * 5 / 3; g = l + (g - l) * 5 / 3; b = l + (b - l) * 5 / 3; break;
    case 2:                                            // RETRO: fosforo verde
      r = l / 6; g = l; b = l / 6; break;
    case 3: {                                          // FUEGO: rojo -> naranja -> amarillo
      int a = l * l / 255;
      r = l * 5 / 4; g = a * 4 / 5; b = a * a / 900; break; }
    default:                                           // ARDUINO: negro -> teal -> blanco
      if (l < 150) { r = 0; g = 151 * l / 150; b = 157 * l / 150; }
      else { int t = (l - 150) * 255 / 105; r = t; g = 151 + (255 - 151) * t / 255; b = 157 + (255 - 157) * t / 255; }
      break;
  }
  if (r < 0) r = 0; if (r > 255) r = 255;
  if (g < 0) g = 0; if (g > 255) g = 255;
  if (b < 0) b = 0; if (b > 255) b = 255;
  return C565(r, g, b);
}
const uint8_t DIF_PCT[3] = {135, 100, 75};            // tiempo entre pasos (%): FACIL mas lento, DIFICIL mas rapido
const float   DIF_VEL[3] = {0.85f, 1.0f, 1.2f};       // multiplicador de velocidad del dino

// ---------------------------------------------------------------------
//  MENU DE ENTRADA DE CADA JUEGO (igual que el de Pac-Man: JUGAR / OPCIONES)
//  IZQUIERDA vuelve al arcade.  OPCIONES: SONIDO, SKIN, DIF, VOLVER
// ---------------------------------------------------------------------
static void mjItems(int sel, uint16_t ac) {
  const char* items[2] = {"JUGAR", "OPCIONES"};
  for (int i = 0; i < 2; i++) {
    int y = 88 + i * 30;
    tft.fillRect(30, y - 2, 180, 20, NEGRO);
    char b[20];
    if (i == sel) snprintf(b, sizeof(b), "> %s <", items[i]); else snprintf(b, sizeof(b), "%s", items[i]);
    printC(b, y, 2, i == sel ? ac : BLANCO);
  }
}
static void mjPantalla(const char* titulo, uint16_t ac, uint32_t rec, int sel) {
  tft.fillScreen(NEGRO);
  printC(titulo, 38, 3, ac);
  mjItems(sel, ac);
  char b[24]; snprintf(b, sizeof(b), "RECORD %lu", (unsigned long)rec);
  printC(b, 160, 1, mezclar565(ac, 0xFFFF, 90));
  printC("< VOLVER AL ARCADE", 172, 1, C565(150, 150, 150));
}
static void mjDino(int x, int y, uint16_t c) {         // dinosaurio mini de 12x11
  tft.fillRect(x + 3, y + 3, 7, 5, c);
  tft.fillRect(x + 6, y, 6, 4, c);
  tft.fillRect(x, y + 5, 4, 2, c);
  tft.fillRect(x + 4, y + 8, 2, 3, c);
  tft.fillRect(x + 8, y + 8, 2, 3, c);
  tft.drawPixel(x + 10, y + 1, NEGRO);
}
// Animacion de la franja inferior (como el Pac-Man persiguiendo al fantasma)
static void mjAnim(uint8_t anim, int fr, uint16_t ac) {
  const int y = 189;
  if (anim == 0) {                                     // TETRIS: bloques que cambian de color
    if (fr % 4) return;
    static const uint16_t pal[7] = {C565(0,230,240), C565(250,230,0), C565(180,60,240), C565(40,220,60), C565(240,40,40), C565(50,90,255), C565(255,150,0)};
    for (int i = 0; i < 8; i++) {
      uint16_t c = skinTinte(pal[(i + fr / 4) % 7]);
      tft.fillRect(60 + i * 15, y + 2, 11, 11, c);
      tft.drawFastHLine(60 + i * 15, y + 2, 11, aclarar(c));
    }
  } else if (anim == 1) {                              // INVADERS: un invasor cruzando
    static int x = 50;
    static const char* const S[2][8] = {
      {"...##...", "..####..", ".######.", "##.##.##", "########", "..#..#..", ".#.##.#.", "#.#..#.#"},
      {"...##...", "..####..", ".######.", "##.##.##", "########", ".#.##.#.", "#......#", ".#....#."}};
    tft.fillRect(x - 2, y, 14, 12, NEGRO);
    x += 2; if (x > 176) x = 50;
    spriteTxt(x, y + 2, S[(x >> 3) & 1], 8, 8, ac);
  } else {                                             // DINO: salta un cactus
    static int cx = 186;
    const int dx0 = 70, suelo = 203;
    tft.fillRect(48, y - 10, 146, 28, NEGRO);
    cx -= 3; if (cx < 52) cx = 186;
    int d = cx - (dx0 + 12), salto = 0;
    if (d > -4 && d < 30) salto = (int)(sinf((30 - d) / 34.0f * 3.14159f) * 14);
    tft.drawFastHLine(52, suelo, 136, C565(110, 110, 110));
    mjDino(dx0, suelo - 11 - salto, ac);
    tft.fillRect(cx, suelo - 12, 4, 12, ac);
    tft.fillRect(cx - 3, suelo - 9, 3, 2, ac);
    tft.fillRect(cx + 4, suelo - 8, 3, 2, ac);
  }
}
static void mjFilas(int sel, uint16_t ac) {
  char b[28];
  for (int i = 0; i < 4; i++) {
    int y = 62 + i * 28;
    tft.fillRect(10, y - 2, 220, 20, NEGRO);
    switch (i) {
      case 0: snprintf(b, sizeof(b), "SONIDO: %s", soundOn ? "SI" : "NO"); break;
      case 1: snprintf(b, sizeof(b), "SKIN: %s", SK.name); break;
      case 2: snprintf(b, sizeof(b), "DIF: %s", DIFF_NAMES[diffIdx]); break;
      default: snprintf(b, sizeof(b), "VOLVER"); break;
    }
    printC(b, y, 2, i == sel ? ac : BLANCO);
    if (i == sel) tft.fillTriangle(20, y + 1, 20, y + 15, 30, y + 8, ac);
  }
}
static void mjOpcionesPantalla(int sel, uint16_t ac) {
  tft.fillScreen(NEGRO);
  printC("OPCIONES", 24, 2, ac);
  mjFilas(sel, ac);
  drawSkinPreview();
}
static void mjOpciones(uint16_t acento0) {
  int sel = 0;
  mjOpcionesPantalla(sel, skinTinte(acento0));
  clearPresses();
  uint32_t last = 0;
  for (;;) {
    uint32_t now = millis();
    updateSound(now);
    readButtons(now);
    if (now - last < FRAME_MS) { delay(1); continue; }
    last = now;
    uint16_t ac = skinTinte(acento0);
    if (btnPress[B_UP])   { sel = (sel + 3) % 4; click(); mjFilas(sel, ac); }
    if (btnPress[B_DOWN]) { sel = (sel + 1) % 4; click(); mjFilas(sel, ac); }
    if (sel == 3) {
      if (btnPress[B_OK]) { click(); saveSettings(); clearPresses(); return; }
    } else {
      int d = 0;
      if (btnPress[B_LEFT]) d = -1;
      if (btnPress[B_RIGHT] || btnPress[B_OK]) d = 1;
      if (d) {
        if (sel == 0)      { soundOn = !soundOn; if (!soundOn) buzz(0); click(); mjFilas(sel, ac); }
        else if (sel == 1) { skinIdx = (skinIdx + NUM_SKINS + d) % NUM_SKINS; click(); mjOpcionesPantalla(sel, skinTinte(acento0)); }
        else               { diffIdx = (diffIdx + 3 + d) % 3; click(); mjFilas(sel, ac); }
        saveSettings();
      }
    }
    clearPresses();
  }
}
// Devuelve true = JUGAR, false = volver al arcade. acento0 = color original del juego (la skin lo tiñe aqui)
// anim: 0 tetris, 1 invaders, 2 dino
bool menuJuego(const char* titulo, uint16_t acento0, uint32_t rec, uint8_t anim) {
  int sel = 0, fr = 0;
  mjPantalla(titulo, skinTinte(acento0), rec, sel);
  clearPresses();
  uint32_t last = 0;
  for (;;) {
    uint32_t now = millis();
    updateSound(now);
    readButtons(now);
    if (now - last < FRAME_MS) { delay(1); continue; }
    last = now; fr++;
    uint16_t ac = skinTinte(acento0);
    if (btnPress[B_LEFT]) { click(); clearPresses(); return false; }
    if (btnPress[B_UP] || btnPress[B_DOWN]) { sel = 1 - sel; click(); mjItems(sel, ac); }
    if (btnPress[B_OK] || btnPress[B_RIGHT]) {
      click();
      if (sel == 0) { clearPresses(); return true; }
      mjOpciones(acento0);
      mjPantalla(titulo, skinTinte(acento0), rec, sel);
      clearPresses();
      continue;
    }
    mjAnim(anim, fr, ac);
    clearPresses();
  }
}

