// =====================================================================
//  WiFi + descarga HTTPS. Solo se enciende en la pantalla AGREGAR JUEGO
//  y se apaga siempre al terminar.
//
//  >>> EDITA ESTAS CUATRO LINEAS <<<
// =====================================================================
#define ARC_HOST   "TU-USUARIO.github.io"      // dominio donde alojas los .agm (sin https://)
#define ARC_RUTA   "/arcade/"                  // carpeta; URL final: https://HOST/RUTA/<id>.agm
#define ARC_TLS_SIN_VERIFICAR 0                // 1 = NO validar el certificado (solo para pruebas)
static const char ARC_CA_PEM[] =               // CA raiz del dominio en formato PEM (si validas el certificado)
  "";
const char* const DOMINIOS_OK[] = { ARC_HOST };   // lista blanca: agrega aqui otros dominios permitidos

namespace red {

Preferences pw;

bool leerCred(char* ssid, char* pass) {
  ssid[0] = 0; pass[0] = 0;
  pw.begin("wifi", false);
  pw.getString("ssid", ssid, 33);
  pw.getString("pass", pass, 64);
  pw.end();
  return ssid[0] != 0;
}
void guardarCred(const char* s, const char* p) {
  pw.begin("wifi", false);
  pw.putString("ssid", s);
  pw.putString("pass", p);
  pw.end();
}

void apagar() {
  WiFi.disconnect(true);
  WiFi.mode(WIFI_OFF);
}

// 0 = ok, 1 = sin credenciales, 2 = no conecta, 3 = sin hora (necesaria para validar el certificado)
int conectar(void (*tick)()) {
  char s[33], p[64];
  if (!leerCred(s, p)) return 1;
  WiFi.persistent(false);
  WiFi.mode(WIFI_STA);
  WiFi.begin(s, p);
  uint32_t t = millis();
  while (WiFi.status() != WL_CONNECTED) {
    if (millis() - t > 15000) { apagar(); return 2; }
    if (tick) tick();
    delay(20);
  }
#if !ARC_TLS_SIN_VERIFICAR
  configTime(0, 0, "pool.ntp.org", "time.google.com");
  t = millis();
  while (time(nullptr) < 1700000000) {
    if (millis() - t > 10000) { apagar(); return 3; }
    if (tick) tick();
    delay(20);
  }
#endif
  return 0;
}

// Buffer en RAM con tope: write() devuelve 0 si se pasa del limite
class Buf : public Stream {
 public:
  uint8_t* d = nullptr;
  size_t   cap = 0, n = 0;
  int      tot = 0;
  void   (*prog)(int) = nullptr;
  size_t write(uint8_t c) override { if (n >= cap) return 0; d[n++] = c; return 1; }
  size_t write(const uint8_t* b, size_t k) override {
    if (n + k > cap) return 0;
    memcpy(d + n, b, k); n += k;
    if (prog && tot > 0) prog((int)(n * 100 / tot));
    return k;
  }
  int available() override { return 0; }
  int read() override { return -1; }
  int peek() override { return -1; }
};

// Descarga una URL https permitida. 0 = ok; si no:
//  10 URL no valida, 11 dominio no permitido, 12 sin conexion/TLS, 13 respuesta HTTP != 200,
//  14 archivo demasiado grande, 15 descarga incompleta, 16 falta la CA del certificado
int descargar(const char* url, uint8_t* dst, size_t cap, size_t* nOut, int* httpCode, void (*prog)(int)) {
  if (strlen(url) > 200 || strncmp(url, "https://", 8) != 0) return 10;
  const char* h = url + 8;
  const char* fin = h;
  while (*fin && *fin != '/') fin++;
  size_t hl = fin - h;
  if (hl == 0 || hl > 60 || *fin != '/') return 10;
  for (size_t k = 0; k < hl; k++)
    if (h[k] == ':' || h[k] == '@' || h[k] == '?' || h[k] == '#' || h[k] == '\\') return 10;
  bool ok = false;
  for (size_t i = 0; i < sizeof(DOMINIOS_OK) / sizeof(DOMINIOS_OK[0]); i++)
    if (strlen(DOMINIOS_OK[i]) == hl && strncasecmp(DOMINIOS_OK[i], h, hl) == 0) ok = true;
  if (!ok) return 11;

  WiFiClientSecure cli;
#if ARC_TLS_SIN_VERIFICAR
  cli.setInsecure();
#else
  if (!ARC_CA_PEM[0]) return 16;
  cli.setCACert(ARC_CA_PEM);
#endif
  HTTPClient http;
  http.setFollowRedirects(HTTPC_DISABLE_FOLLOW_REDIRECTS);
  http.setConnectTimeout(8000);
  http.setTimeout(10000);
  if (!http.begin(cli, url)) return 12;
  int code = http.GET();
  *httpCode = code;
  if (code <= 0) { http.end(); return 12; }
  if (code != 200) { http.end(); return 13; }
  int tot = http.getSize();
  if (tot > (int)cap) { http.end(); return 14; }
  Buf b;
  b.d = dst; b.cap = cap; b.tot = tot; b.prog = prog;
  int r = http.writeToStream(&b);
  http.end();
  if (b.n >= cap && r < 0) return 14;
  if (r < 0 || b.n == 0 || (tot > 0 && b.n != (size_t)tot)) return 15;
  *nOut = b.n;
  return 0;
}

