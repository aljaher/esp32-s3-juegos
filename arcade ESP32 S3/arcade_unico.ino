  const uint16_t c1 = C565(120, 200, 255), c2 = C565(205, 238, 255);
  for (int y = 0; y < 80; y++) c->drawFastHLine(0, y, 80, mezclar565(c1, c2, y * 255 / 58 > 255 ? 255 : y * 255 / 58));
  c->fillCircle(64, 15, 7, C565(255, 238, 130));
  c->fillCircle(14, 14, 5, 0xFFFF); c->fillCircle(21, 12, 6, 0xFFFF); c->fillCircle(28, 15, 4, 0xFFFF); c->fillRect(14, 14, 15, 5, 0xFFFF);
  c->fillCircle(20, 66, 26, C565(170, 222, 175));
  c->fillCircle(60, 70, 24, C565(105, 200, 120));
  c->fillRect(0, 58, 80, 22, C565(228, 192, 124));
  c->drawFastHLine(0, 58, 80, C565(140, 98, 48)); c->drawFastHLine(0, 59, 80, C565(140, 98, 48));
  const uint16_t cv1 = dino::C_CACTO0, cv2 = dino::C_CACTO_S0;
  c->fillRect(58, 38, 6, 21, cv1); c->fillRect(58, 38, 2, 21, cv2);
  c->fillRect(52, 46, 6, 3, cv1);  c->fillRect(52, 41, 3, 8, cv1);
  c->fillRect(64, 43, 5, 3, cv1);  c->fillRect(67, 38, 3, 8, cv1);
  c->fillRect(73, 46, 4, 13, cv1); c->fillRect(73, 46, 1, 13, cv2);
  const uint16_t d = dino::C_DINO0, ds = dino::C_DINO_S0;
  c->fillRect(16, 44, 13, 13, d);
  c->fillRect(22, 33, 13, 10, d);
  c->fillRect(18, 51, 8, 4, dino::C_PANZA0);
  c->fillTriangle(16, 45, 16, 54, 6, 56, d);
  c->fillRect(17, 57, 4, 5, ds); c->fillRect(24, 57, 4, 3, ds);
  c->fillRect(29, 48, 4, 2, d);
  c->fillRect(30, 35, 3, 3, 0xFFFF); c->drawPixel(32, 36, 0);
  c->drawFastHLine(26, 41, 8, ds);
}

// >>> NUEVO: escenas de los juegos descargados y de AGREGAR (lienzo 80x80)
static void ptEscExtra(int idx, GFXcanvas16* c) {
  int k = idx - NUM_JUEGOS;
  if (k >= 0 && k < agm::n) { agm::portada(agm::desc[k], c); return; }
  c->fillScreen(C565(24, 14, 0));
  for (int r = 14; r <= 38; r += 12) c->drawCircle(40, 40, r, mezclar565(0x0000, agr::AC, 255 - r * 4));
  c->fillRoundRect(26, 30, 28, 20, 3, C565(60, 36, 0));
  c->drawRoundRect(26, 30, 28, 20, 3, agr::AC);
  c->fillRect(38, 36, 4, 8, agr::AC);
  c->fillRect(36, 38, 8, 4, agr::AC);
}

static void ptEscena(int idx, GFXcanvas16* c) {
  switch (idx) {
    case 0:  ptEscPacman(c);   break;
    case 1:  ptEscTetris(c);   break;
    case 2:  ptEscInvaders(c); break;
    case 3:  ptEscDino(c);     break;
    default: ptEscExtra(idx, c); break;     // >>> NUEVO
  }
  ptDifuminar(c->getBuffer(), idx == 3 ? 14 : 21);   // el dino (cielo claro) se oscurece mas para que el titulo se lea
}

// ----- composicion -----
// Rellena dst (240x240) con el fondo: A en reposo, o A y B deslizandose (shift 0..240, dir +1 = entra B por la derecha)
static void ptRenderBg(uint16_t* dst, const uint16_t* A, const uint16_t* B, int dir, int shift, int y0, int y1, int x0, int x1) {
  for (int y = y0; y < y1; y++) {
    int dy = y - 120, dy2 = dy * dy;
    uint16_t* row = dst + y * 240;
    uint8_t wy = ptWX[y];
    int ya = ptX0[y] * PT_W, yb = ptX1[y] * PT_W;
    for (int x = x0; x < x1; x++) {
      int dx = x - 120, d2 = dx * dx + dy2;
      if (d2 > 14641) { row[x] = 0; continue; }
      const uint16_t* S = A; int cx = x;
      if (shift) {
        if (dir > 0) { int xv = x + shift; if (xv < 240) cx = xv; else { S = B; cx = xv - 240; } }
        else         { int xv = x - shift; if (xv >= 0) cx = xv; else { S = B; cx = xv + 240; } }
      }
      int a0 = ptX0[cx], a1 = ptX1[cx]; uint8_t wx = ptWX[cx];
      uint16_t top = lerp565(S[ya + a0], S[ya + a1], wx);
      uint16_t bot = lerp565(S[yb + a0], S[yb + a1], wx);
      row[x] = mul565(lerp565(top, bot, wy), ptVig[d2 >> 7]);
    }
  }
}

static void ptEmpujar(int x, int y, int w, int h) {
  uint16_t* buf = cvM->getBuffer();
  tft.startWrite();
  tft.setAddrWindow(x, y, w, h);
  for (int r = 0; r < h; r++) tft.writePixels(buf + (size_t)(y + r) * 240 + x, w);
  tft.endWrite();
}

static void ptTextoC(const char* s, int cx, int y, uint8_t sz, uint16_t col) {
  int w = strlen(s) * 6 * sz;
  cvM->setTextSize(sz); cvM->setTextColor(col);
  cvM->setCursor(cx - w / 2, y); cvM->print(s);
}

// Titulo con contorno oscuro suave + record
static void ptTitulo(int idx, int cx) {
  if (cx < -130 || cx > 370) return;
  const uint16_t ac = jColor(idx);          // >>> NUEVO (antes JUEGOS[idx].color)
  const char* t = jNombre(idx);
  for (int oy = -2; oy <= 2; oy++) for (int ox = -2; ox <= 2; ox++)
    if ((ox || oy) && ox * ox + oy * oy <= 5) ptTextoC(t, cx + ox, 90 + oy, 3, 0x0000);
  ptTextoC(t, cx, 90, 3, mezclar565(ac, 0xFFFF, 45));
  char b[24];
  if (esAgregar(idx)) snprintf(b, sizeof(b), "ETIQUETA NFC");   // >>> NUEVO
  else snprintf(b, sizeof(b), "RECORD %lu", (unsigned long)recJuego[idx]);
  ptTextoC(b, cx + 1, 119, 1, 0x0000);
  ptTextoC(b, cx, 118, 1, mezclar565(ac, 0xFFFF, 110));
}

static void ptIndicadores(int idx) {
  const int N = numJuegos();                // >>> NUEVO: cantidad dinamica
  const int sp = (N > 10) ? 12 : 14;        // los puntos se juntan un poco si hay muchos
  int x0 = 120 - (N - 1) * sp / 2;
  for (int i = 0; i < N; i++) {
    if (i == idx) cvM->fillCircle(x0 + i * sp, 32, 3, 0xFFFF);
    else          cvM->fillCircle(x0 + i * sp, 32, 2, C565(105, 105, 125));
  }
  const uint16_t fl = C565(150, 150, 170);
  cvM->fillTriangle(22, 120, 31, 113, 31, 127, fl);
  cvM->fillTriangle(218, 120, 209, 113, 209, 127, fl);
}

static void ptComponer(int idx) {
  ptRenderBg(cvM->getBuffer(), cvA->getBuffer(), nullptr, 0, 0, 0, 240, 0, 240);
  ptIndicadores(idx);
  ptTitulo(idx, 120);
}

// Boton START: cristal oscuro con borde y resplandor suaves que "respiran" + brillo que lo cruza.
// apar = 0..256 (aparicion), flash = realce al pulsar
static void ptBoton(uint32_t now, int apar, int flash) {
  const uint16_t ac = jColor(selJuego);      // >>> NUEVO
  uint16_t* buf = cvM->getBuffer();
  ptRenderBg(buf, cvA->getBuffer(), nullptr, 0, 0, PT_BY0, PT_BY1, PT_BX0, PT_BX1);
  float fase = 0.5f + 0.5f * sinf(now * 0.005f);
  float cyc = fmodf(now * 0.00055f, 1.0f);
  float brillo = (cyc < 0.55f) ? (-30.0f + cyc / 0.55f * 200.0f) : -999.0f;
  float ap = apar / 256.0f;
  for (int y = PT_BY0; y < PT_BY1; y++) {
    for (int x = PT_BX0; x < PT_BX1; x++) {
      float px = x + 0.5f - 120.0f, py = y + 0.5f - 172.0f;
      float qx = fabsf(px) - 42.0f, qy = fabsf(py) - 2.0f;
      if (qx < 0) qx = 0;
      if (qy < 0) qy = 0;
      float d = sqrtf(qx * qx + qy * qy) - 14.0f;
      float a = 0;
      uint16_t* p = &buf[y * 240 + x];
      if (d < 0) {
        *p = mul565(*p, 32 - (int)(9 * ap));
        a = (46 + 36 * fase + flash) * ap;
        float s = fabsf((px + 56.0f) - (py + 16.0f) * 0.6f - brillo);
        if (s < 10.0f) a += (10.0f - s) * 5.0f * ap;
      }
      float ad = fabsf(d);
      if (ad < 1.6f) { float b = (70.0f + 70.0f * fase + flash) * (1.0f - ad / 1.6f) * ap; if (b > a) a = b; }
      else if (d > 0 && d < 8.0f) { float g = (1.0f - d / 8.0f); g = 60.0f * g * g * (0.5f + 0.5f * fase) * ap; if (g > a) a = g; }
      if (a >= 8.0f) { if (a > 255.0f) a = 255.0f; *p = lerp565(*p, ac, (uint8_t)((int)a >> 3)); }
    }
  }
  if (ap > 0.5f) {
    uint16_t tc = mezclar565(0xFFFF, ac, 30 + (int)(70 * (1.0f - fase)));
    cvM->fillTriangle(86, 166, 86, 178, 95, 172, tc);
    cvM->setTextSize(2); cvM->setTextColor(tc); cvM->setCursor(102, 165); cvM->print(esAgregar(selJuego) ? "NUEVO" : "START");   // >>> NUEVO
  }
  ptEmpujar(PT_BX0, PT_BY0, PT_BX1 - PT_BX0, PT_BY1 - PT_BY0);
}

// Desliza a la portada anterior (dir = -1) o siguiente (dir = +1)
static void ptDeslizar(int dir) {
  int nuevo = (selJuego + dir + numJuegos()) % numJuegos();   // >>> NUEVO
  ptEscena(nuevo, cvB);
  const int N = 8;
  for (int k = 1; k <= N; k++) {
    float p = (float)k / N, e = 1.0f - (1.0f - p) * (1.0f - p) * (1.0f - p);
    int shift = (int)(240.0f * e + 0.5f);
    ptRenderBg(cvM->getBuffer(), cvA->getBuffer(), cvB->getBuffer(), dir, shift, 0, 240, 0, 240);
    ptIndicadores(nuevo);
    ptTitulo(selJuego, 120 - dir * shift);
    ptTitulo(nuevo, 120 + dir * (240 - shift));
    ptEmpujar(0, 0, 240, 240);
    updateSound(millis());
  }
  GFXcanvas16* t = cvA; cvA = cvB; cvB = t;
  selJuego = nuevo;
}

static bool ptAbrir() {
  ptIniciarTablas();
  cvM = crearLienzo(240, 240);
  if (!cvM) return false;
  cvA = crearLienzo(PT_W, PT_H);
  if (!cvA) { delete cvM; cvM = nullptr; return false; }
  cvB = crearLienzo(PT_W, PT_H);
  if (!cvB) { delete cvM; delete cvA; cvM = cvA = nullptr; return false; }
  return true;
}
static void ptCerrar() {
  delete cvM; delete cvA; delete cvB;
  cvM = cvA = cvB = nullptr;
}

void arcadeMenu() {
  prefsA.begin("arcade", false);
  cargarRecords();
  if (!ptAbrir()) { delay(300); return; }              // sin memoria: loop() lo vuelve a intentar
  ptEscena(selJuego, cvA);
  ptComponer(selJuego);
  ptEmpujar(0, 0, 240, 240);
  clearPresses();
  uint32_t tIni = millis(), last = 0;
  int flashN = 0;
  bool lanzar = false;
  for (;;) {
    uint32_t now = millis();
    updateSound(now);
    readButtons(now);
    if (now - last < 33) { delay(1); continue; }
    last = now;
    if (!lanzar) {
      if (btnPress[B_LEFT])       { click(); ptDeslizar(-1); tIni = millis(); }
      else if (btnPress[B_RIGHT]) { click(); ptDeslizar(1);  tIni = millis(); }
      else if (btnPress[B_OK])    { click(); lanzar = true; flashN = 0; }
    }
    clearPresses();
    now = millis();
    int apar = (int)((now - tIni) * 256UL / 300UL);
    if (apar > 256) apar = 256;
    ptBoton(now, apar, lanzar ? 130 : 0);
    if (lanzar && ++flashN >= 4) {                     // destello del boton y a jugar
      lanzar = false;
      ptCerrar();                                      // libera ~140 KB de RAM para el juego
      clearPresses();
      jLanzar(selJuego);                               // >>> NUEVO (juegos incluidos, descargados o AGREGAR)
      buzz(0);
      cargarRecords();
      clearPresses();
      if (!ptAbrir()) return;
      ptEscena(selJuego, cvA);
      ptComponer(selJuego);
      ptEmpujar(0, 0, 240, 240);
      tIni = millis();
    }
  }
}

