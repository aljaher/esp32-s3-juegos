// ===== inicio de agregar_juego.h =====
// =====================================================================
//  PANTALLA "AGREGAR JUEGO" (la ultima caratula del arcade)
//  Espera una etiqueta NFC y, segun lo que lleve:
//    - texto  WIFI:S:red;P:clave;;   -> guarda las credenciales WiFi
//    - texto  ID  (o  juego:ID)      -> descarga https://HOST/RUTA/ID.agm
//    - URI    https://...            -> descarga esa URL (dominio permitido)
//  Controles: IZQUIERDA sale, ARRIBA abre BORRAR JUEGO.
// =====================================================================
namespace agr {

const uint16_t AC = C565(255, 170, 30);
const uint16_t GRIS = C565(150, 150, 150);
int selNuevo = -1;               // indice (en agm::desc) del juego recien instalado
const char* eA = "";
const char* eB = "";
char eBuf[28];

enum { K_NADA, K_WIFI, K_ID, K_URL };

// ---------- dibujo ----------
void anillo(int pct, int giro) {
  for (int k = 0; k < 36; k++) {
    float a = (-90 + k * 10) * 0.0174533f;
    int x = 120 + (int)(46 * cosf(a)), y = 100 + (int)(46 * sinf(a));
    bool on;
    if (pct >= 0) on = k < pct * 36 / 100;
    else          on = ((giro - k + 36) % 36) < 8;
    tft.fillCircle(x, y, 3, on ? AC : C565(50, 36, 0));
  }
}
void trabajo(const char* t1, const char* t2) {
  tft.fillScreen(NEGRO);
  anillo(0, 0);
  printC(t1, 96, 1, BLANCO);
  printC(t2, 164, 1, GRIS);
}
void tickRed() {
  static uint32_t t = 0;
  static int g = 0;
  updateSound(millis());
  if (millis() - t > 90) { t = millis(); g = (g + 1) % 36; anillo(-1, g); }
}
void progCb(int pct) {
  static int ult = -1;
  if (pct < ult) ult = -1;
  if (pct / 3 != ult) { ult = pct / 3; anillo(pct, 0); }
  updateSound(millis());
}
void icono(bool ok, uint16_t col) {
  tft.drawCircle(120, 80, 34, col);
  tft.drawCircle(120, 80, 33, col);
  for (int o = -1; o <= 1; o++) {
    if (ok) {
      tft.drawLine(104, 80 + o, 116, 92 + o, col);
      tft.drawLine(116, 92 + o, 138, 66 + o, col);
    } else {
      tft.drawLine(106, 66 + o, 134, 94 + o, col);
      tft.drawLine(134, 66 + o, 106, 94 + o, col);
    }
  }
}
void textos(const char* a, const char* b, uint16_t col) {
  printC(a, 128, strlen(a) <= 14 ? 2 : 1, col);
  printC(b, 152, 1, BLANCO);
}
void exito(const char* a, const char* b) {
  tft.fillScreen(NEGRO);
  icono(true, AC);
  textos(a, b, AC);
  playSeq(SND_LEVEL, NN(SND_LEVEL), 3);
  esperar(1800);
}
// Pantalla de error. true = reintentar (OK), false = salir (IZQUIERDA)
bool error(const char* a, const char* b) {
  tft.fillScreen(NEGRO);
  icono(false, C_RED);
  textos(a, b, C_RED);
  printC("OK: REINTENTAR", 184, 1, BLANCO);
  printC("<: SALIR", 198, 1, BLANCO);
  playSeq(SND_OVER, NN(SND_OVER), 3);
  uint32_t t0 = millis();
  clearPresses();
  for (;;) {
    uint32_t now = millis();
    readButtons(now);
    updateSound(now);
    if (now - t0 > 600) {
      if (btnPress[B_OK])   { clearPresses(); return true; }
      if (btnPress[B_LEFT]) { clearPresses(); return false; }
    }
    clearPresses();
    delay(5);
  }
}

void fondoEspera() {
  tft.fillScreen(NEGRO);
  printC("AGREGAR JUEGO", 26, 1, AC);
  printC("ACERCA LA ETIQUETA", 156, 1, BLANCO);
  printC("AL LECTOR", 170, 1, GRIS);
  printC("^ BORRAR    < SALIR", 200, 1, GRIS);
}
// Ondas de NFC alrededor de una tarjeta (lienzo 120x100)
void animEspera(GFXcanvas16* c, int fr) {
  c->fillScreen(0);
  for (int k = 0; k < 3; k++) {
    int ph = (fr * 2 + k * 20) % 60;
    uint8_t fade = 255 - ph * 255 / 60;
    c->drawCircle(60, 50, 16 + ph, mezclar565(0x0000, AC, fade));
  }
  c->fillRoundRect(40, 38, 40, 26, 4, C565(40, 26, 0));
  c->drawRoundRect(40, 38, 40, 26, 4, AC);
  c->drawRect(46, 44, 10, 8, AC);
  c->drawFastHLine(46, 57, 28, AC);
}

// ---------- lectura de la etiqueta ----------
int clasificar(char* out) {                          // out: 170 bytes
  if (strncmp(ndef::txt, "WIFI:", 5) == 0) { strcpy(out, ndef::txt); return K_WIFI; }
  if (ndef::uri[0]) { strcpy(out, ndef::uri); return K_URL; }
  const char* t = ndef::txt;
  while (*t == ' ' || *t == '\n' || *t == '\r') t++;
  if (strncasecmp(t, "juego:", 6) == 0) t += 6;
  size_t l = strlen(t);
  while (l > 0 && (t[l - 1] == ' ' || t[l - 1] == '\n' || t[l - 1] == '\r')) l--;
  if (l < 1 || l > 24) return K_NADA;
  for (size_t i = 0; i < l; i++) out[i] = tolower((unsigned char)t[i]);
  out[l] = 0;
  return agm::idValido(out) ? K_ID : K_NADA;
}

// "WIFI:T:WPA;S:red;P:clave;;"  (formato estandar de los QR; ; , : y \ se escapan con \)
bool parseWifi(const char* s, char* ssid, char* pass) {
  ssid[0] = pass[0] = 0;
  bool exceso = false;
  s += 5;
  while (*s) {
    char k = *s;
    char* dst = nullptr;
    int cap = 0;
    if (s[1] == ':') {
      if (k == 'S') { dst = ssid; cap = 33; }
      else if (k == 'P') { dst = pass; cap = 64; }
      s += 2;
    }
    int n = 0;
    while (*s && *s != ';') {
      char c = *s++;
      if (c == '\\' && *s) c = *s++;
      if (dst) { if (n < cap - 1) dst[n++] = c; else exceso = true; }
    }
    if (dst) dst[n] = 0;
    if (*s == ';') s++;
  }
  return ssid[0] && !exceso;
}

// Saca el id del nombre del archivo de una URL (.../id.agm)
bool idDeUrl(const char* url, char* id) {
  const char* p = strchr(url + 8, '/');
  if (!p) return false;
  const char* nom = strrchr(p, '/') + 1;
  char tmp[40];
  size_t k = 0;
  while (nom[k] && nom[k] != '?' && nom[k] != '#' && k < sizeof(tmp) - 1) { tmp[k] = tolower((unsigned char)nom[k]); k++; }
  tmp[k] = 0;
  if (k < 5 || strcmp(tmp + k - 4, ".agm") != 0) return false;
  tmp[k - 4] = 0;
  if (!agm::idValido(tmp)) return false;
  strcpy(id, tmp);
  return true;
}

void esperarRetirar() {
  uint32_t t0 = millis();
  int libres = 0;
  while (millis() - t0 < 4000 && libres < 3) {
    if (rc::detectar()) { rc::detener(); libres = 0; } else libres++;
    waitMs(120);
  }
}

// ---------- descarga e instalacion ----------
bool instalar(const char* url, const char* id) {
  bool nuevo = agm::buscar(id) < 0;
  if (nuevo && agm::n >= ARC_MAX_DESC) { eA = "LISTA LLENA"; eB = "BORRA UN JUEGO CON ^"; return false; }
  if (!agm::montar()) { eA = "ERROR DE MEMORIA FLASH"; eB = "NO SE PUDO MONTAR"; return false; }
  uint8_t* buf = (uint8_t*)malloc(ARC_MAX_BYTES + 1);
  if (!buf) { eA = "SIN MEMORIA"; eB = "REINICIA EL ARCADE"; return false; }
  bool ok = false;
  trabajo("WIFI", "CONECTANDO");
  int c = red::conectar(tickRed);
  if (c == 1)      { eA = "SIN WIFI GUARDADO"; eB = "LEE LA ETIQUETA WIFI"; }
  else if (c == 2) { eA = "NO CONECTA"; eB = "REVISA LA RED Y LA CLAVE"; }
  else if (c == 3) { eA = "SIN HORA DE INTERNET"; eB = "NECESARIA PARA HTTPS"; }
  else {
    trabajo("DESCARGANDO", "ESPERA...");
    size_t n = 0;
    int hc = 0;
    int r = red::descargar(url, buf, ARC_MAX_BYTES, &n, &hc, progCb);
    red::apagar();
    switch (r) {
      case 0: break;
      case 10: eA = "URL NO VALIDA"; eB = "DEBE SER HTTPS"; break;
      case 11: eA = "DOMINIO NO PERMITIDO"; eB = "NO ESTA EN LA LISTA"; break;
      case 12: eA = "SIN CONEXION"; eB = "O FALLA EL CERTIFICADO"; break;
      case 13: snprintf(eBuf, sizeof(eBuf), "RESPUESTA HTTP %d", hc); eA = "NO SE ENCONTRO"; eB = eBuf; break;
      case 14: eA = "ARCHIVO MUY GRANDE"; eB = "MAXIMO 12 KB"; break;
      case 15: eA = "DESCARGA INCOMPLETA"; eB = "INTENTA DE NUEVO"; break;
      default: eA = "FALTA EL CERTIFICADO"; eB = "VER ARC_CA_PEM EN EL CODIGO"; break;
    }
    if (r == 0) {
      buf[n] = 0;
      agm::Desc d;
      memset(&d, 0, sizeof(d));
      strcpy(d.id, id);
      int v = agm::validar((const char*)buf, (int)n, d);
      if (v == 1)      { eA = "ARCHIVO INVALIDO"; eB = "FORMATO NO RECONOCIDO"; }
      else if (v == 2) { eA = "CABECERA INVALIDA"; eB = "REVISA TIPO, TITULO, COLOR"; }
      else if (v == 3) { eA = "NIVELES INVALIDOS"; eB = "REVISA LOS MAPAS"; }
      else {
        int g = agm::guardar(id, buf, (int)n);
        if (g == 1)      { eA = "SIN ESPACIO"; eB = "BORRA UN JUEGO CON ^"; }
        else if (g == 2) { eA = "ERROR AL GUARDAR"; eB = "INTENTA DE NUEVO"; }
        else {
          agm::indexar();
          selNuevo = agm::buscar(id);
          exito("JUEGO AGREGADO", d.titulo);
          ok = true;
        }
      }
    }
  }
  red::apagar();
  free(buf);
  return ok;
}

// ---------- borrar juegos ----------
void pintarBorrar(int i) {
  tft.fillScreen(NEGRO);
  printC("BORRAR JUEGO", 30, 1, C_RED);
  printC(agm::desc[i].titulo, 86, 3, agm::desc[i].color);
  char b[24];
  snprintf(b, sizeof(b), "%d / %d", i + 1, agm::n);
  printC(b, 124, 1, GRIS);
  printC("< > ELEGIR   OK BORRAR", 160, 1, BLANCO);
  printC("^ VOLVER", 176, 1, GRIS);
}
void menuBorrar() {
  if (agm::n == 0) {
    tft.fillScreen(NEGRO);
    printC("NO HAY JUEGOS", 104, 1, GRIS);
    esperar(1200);
    return;
  }
  int i = 0;
  pintarBorrar(i);
  clearPresses();
  for (;;) {
    uint32_t now = millis();
    readButtons(now);
    updateSound(now);
    if (btnPress[B_UP]) { click(); clearPresses(); return; }
    if (btnPress[B_LEFT])  { click(); i = (i + agm::n - 1) % agm::n; pintarBorrar(i); }
    if (btnPress[B_RIGHT]) { click(); i = (i + 1) % agm::n; pintarBorrar(i); }
    if (btnPress[B_OK]) {
      click();
      tft.fillScreen(NEGRO);
      char b[24];
      snprintf(b, sizeof(b), "BORRAR %s?", agm::desc[i].titulo);
      printC(b, 96, 2, C_RED);
      printC("OK: SI     <: NO", 140, 1, BLANCO);
      clearPresses();
      bool decidido = false, si = false;
      while (!decidido) {
        readButtons(millis());
        updateSound(millis());
        if (btnPress[B_OK])   { decidido = true; si = true; }
        if (btnPress[B_LEFT]) { decidido = true; }
        clearPresses();
        delay(5);
      }
      if (si) {
        char id[25];
        strcpy(id, agm::desc[i].id);
        agm::borrar(id);
        tft.fillScreen(NEGRO);
        printC("BORRADO", 104, 2, AC);
        esperar(1000);
        return;
      }
      pintarBorrar(i);
    }
    clearPresses();
    delay(5);
  }
}

// ---------- flujo principal ----------
// Devuelve 0 = seguir esperando, 1 = salir de la pantalla
int err(const char* a, const char* b) {
  bool otra = error(a, b);
  esperarRetirar();
  return otra ? 0 : 1;
}

int procesar() {
  int r = rc::leerNdef();
  rc::detener();
  if (r == -2) return err("ETIQUETA NO VALIDA", "USA NTAG213 / NTAG215");
  if (r == -1) return err("ERROR DE LECTURA", "ACERCA MAS LA ETIQUETA");
  if (r == 0)  return err("ETIQUETA VACIA", "ESCRIBE UN ID O UNA URL");
  if (!ndef::parsear(rc::datos + rc::ndefOff, rc::ndefLen)) return err("NO ES UN JUEGO", "FORMATO NO RECONOCIDO");
  char dato[170];
  int k = clasificar(dato);
  if (k == K_NADA) return err("NO ES UN JUEGO", "FORMATO NO RECONOCIDO");
  if (k == K_WIFI) {
    char s[40], p[70];
    if (!parseWifi(dato, s, p)) return err("WIFI NO VALIDO", "REVISA LA ETIQUETA");
    red::guardarCred(s, p);
    exito("WIFI GUARDADO", s);
    esperarRetirar();
    return 0;
  }
  char id[25], url[200];
  if (k == K_ID) {
    strcpy(id, dato);
    snprintf(url, sizeof(url), "https://%s%s%s.agm", ARC_HOST, ARC_RUTA, id);
  } else {
    if (!idDeUrl(dato, id)) return err("URL NO VALIDA", "DEBE TERMINAR EN .agm");
    strncpy(url, dato, sizeof(url) - 1);
    url[sizeof(url) - 1] = 0;
  }
  if (!instalar(url, id)) return err(eA, eB);
  return 1;
}

void agregar() {
  selNuevo = -1;
  GFXcanvas16* cv = crearLienzo(120, 100);
  if (!cv) return;
  bool lector = rc::iniciar();
  bool salir = false;
  while (!salir) {
    if (!lector) {
      if (!error("SIN LECTOR", "REVISA EL CABLEADO DEL RC522")) break;
      lector = rc::iniciar();
      continue;
    }
    fondoEspera();
    clearPresses();
    uint32_t last = 0, poll = 0;
    int fr = 0;
    bool leido = false;
    while (!leido && !salir) {
      uint32_t now = millis();
      updateSound(now);
      readButtons(now);
      if (btnPress[B_LEFT]) { click(); salir = true; }
      else if (btnPress[B_UP]) { click(); clearPresses(); menuBorrar(); fondoEspera(); }
      clearPresses();
      if (salir) break;
      if (now - last >= FRAME_MS) { last = now; animEspera(cv, fr++); empujarLienzo(cv, 60, 44); }
      if (now - poll >= 120) { poll = now; if (rc::detectar()) leido = true; }
      delay(1);
    }
    if (salir) break;
    playSeq(SND_LIFE, NN(SND_LIFE), 2);
    if (procesar()) salir = true;
  }
  rc::apagar();
  red::apagar();
  delete cv;
  clearPresses();
}

