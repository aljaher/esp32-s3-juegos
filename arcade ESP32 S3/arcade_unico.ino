// =====================================================================
//  MOTOR SOKOBAN: ejecuta los niveles de un .agm de tipo sokoban.
//  Flechas = mover, OK = pausa (OK sigue, ARRIBA reinicia el nivel, IZQ sale)
// =====================================================================
namespace sok {

const int CEL = 12;
uint8_t t[ARC_DIM][ARC_DIM];          // bit0 pared, bit1 meta, bit2 caja
int w, h, px, py, ox, oy, pasos;
uint16_t cCaja, cAc;

void celda(int c, int r) {
  int x = ox + c * CEL, y = oy + r * CEL;
  uint8_t v = t[r][c];
  tft.fillRect(x, y, CEL, CEL, NEGRO);
  if (v & 1) {
    tft.fillRect(x, y, CEL, CEL, SK.wallFill);
    tft.drawRect(x, y, CEL, CEL, SK.wallLine);
  } else {
    if (v & 2) tft.fillRect(x + 4, y + 4, 4, 4, SK.dot);
    if (v & 4) {
      uint16_t cc = (v & 2) ? aclarar(cCaja) : cCaja;
      tft.fillRect(x + 1, y + 1, CEL - 2, CEL - 2, cc);
      tft.drawRect(x + 1, y + 1, CEL - 2, CEL - 2, oscurecer(cc));
    }
  }
  if (c == px && r == py) tft.fillCircle(x + 6, y + 6, 4, SK.pac);
}
void hud(int k, int total) {
  char b[24];
  tft.fillRect(60, 18, 120, 12, NEGRO);
  snprintf(b, sizeof(b), "NIVEL %d/%d", k + 1, total);
  printC(b, 22, 1, cAc);
  tft.fillRect(60, 204, 120, 12, NEGRO);
  snprintf(b, sizeof(b), "PASOS %d", pasos);
  printC(b, 206, 1, BLANCO);
}
void dibujarTodo(int k, int total) {
  tft.fillScreen(NEGRO);
  for (int r = 0; r < h; r++) for (int c = 0; c < w; c++) celda(c, r);
  hud(k, total);
}
bool cargar(const char* b, int k) {
  static char f[ARC_DIM][ARC_DIM + 1];
  if (!agm::nivel(b, k, f, &w, &h)) return false;
  for (int r = 0; r < h; r++) for (int c = 0; c < w; c++) {
    char ch = f[r][c];
    uint8_t v = 0;
    if (ch == '#') v = 1;
    else if (ch == '.') v = 2;
    else if (ch == '$') v = 4;
    else if (ch == '*') v = 6;
    else if (ch == '+') { v = 2; px = c; py = r; }
    else if (ch == '@') { px = c; py = r; }
    t[r][c] = v;
  }
  ox = (240 - w * CEL) / 2;
  oy = (240 - h * CEL) / 2;
  pasos = 0;
  return true;
}
bool resuelto() {
  for (int r = 0; r < h; r++) for (int c = 0; c < w; c++)
    if ((t[r][c] & 4) && !(t[r][c] & 2)) return false;
  return true;
}
bool mover(int dx, int dy) {
  int nx = px + dx, ny = py + dy;
  if (nx < 0 || ny < 0 || nx >= w || ny >= h || (t[ny][nx] & 1)) return false;
  if (t[ny][nx] & 4) {
    int bx = nx + dx, by = ny + dy;
    if (bx < 0 || by < 0 || bx >= w || by >= h || (t[by][bx] & 5)) return false;
    t[ny][nx] &= ~4;
    t[by][bx] |= 4;
    int ox0 = px, oy0 = py;
    px = nx; py = ny;
    celda(ox0, oy0); celda(nx, ny); celda(bx, by);
    click();
  } else {
    int ox0 = px, oy0 = py;
    px = nx; py = ny;
    celda(ox0, oy0); celda(nx, ny);
  }
  pasos++;
  return true;
}
// 0 = seguir, 1 = reiniciar nivel, 2 = salir
int pausa() {
  buzz(0);
  tft.fillRoundRect(40, 84, 160, 78, 6, NEGRO);
  tft.drawRoundRect(40, 84, 160, 78, 6, cAc);
  printC("PAUSA", 90, 2, cAc);
  printC("OK: SEGUIR", 114, 1, BLANCO);
  printC("^: REINICIAR", 128, 1, BLANCO);
  printC("<: SALIR", 142, 1, BLANCO);
  clearPresses();
  for (;;) {
    uint32_t now = millis();
    readButtons(now);
    updateSound(now);
    if (btnPress[B_OK])   { clearPresses(); return 0; }
    if (btnPress[B_UP])   { clearPresses(); return 1; }
    if (btnPress[B_LEFT]) { clearPresses(); return 2; }
    clearPresses();
    delay(5);
  }
}

// Juega los niveles. Devuelve cuantos se superaron en esta partida.
int partida(const char* b, int total, uint16_t ac) {
  cAc = ac;
  cCaja = skinTinte(ac);
  int hecho = 0;
  int k = 0;
  while (k < total) {
    if (!cargar(b, k)) return hecho;
    dibujarTodo(k, total);
    clearPresses();
    uint32_t last = 0;
    for (;;) {
      uint32_t now = millis();
      updateSound(now);
      readButtons(now);
      if (now - last < FRAME_MS) { delay(1); continue; }
      last = now;
      for (int d = 0; d < 4; d++)
        if (btnPress[d]) { if (mover(BDX[d], BDY[d])) hud(k, total); break; }
      if (btnPress[B_OK]) {
        int r = pausa();
        if (r == 2) return hecho;
        if (r == 1) { cargar(b, k); }
        dibujarTodo(k, total);
      }
      clearPresses();
      if (resuelto()) break;
    }
    playSeq(SND_LEVEL, NN(SND_LEVEL), 3);
    hecho++;
    k++;
    printC("NIVEL SUPERADO!", 104, 1, cAc);
    esperar(1100);
  }
  tft.fillScreen(NEGRO);
  printC("COMPLETADO!", 100, 2, cAc);
  playSeq(SND_LEVEL, NN(SND_LEVEL), 3);
  esperar(2000);
  return hecho;
}

