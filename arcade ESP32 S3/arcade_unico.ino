// ===== inicio de arcade_menu.h =====
// =====================================================================
//  MENU PRINCIPAL DEL ARCADE (por caratulas)
//  Cada juego es una caratula a pantalla completa: fondo = escena del juego
//  difuminada, titulo y boton START animado.
//  Controles: IZQUIERDA / DERECHA cambian de juego, OK entra al juego
// =====================================================================

struct JuegoInfo { const char* nombre; uint16_t color; void (*jugar)(); };

const JuegoInfo JUEGOS[] = {
  {"PAC-MAN",  C565(255, 230, 0),   runPacman},
  {"TETRIS",   C565(0, 230, 240),   tet::jugar},
  {"INVADERS", C565(80, 255, 100),  inv::jugar},
  {"DINO RUN", C565(120, 230, 120), dino::jugar},
};
const int NUM_JUEGOS = sizeof(JUEGOS) / sizeof(JUEGOS[0]);

int      selJuego = 0;
uint32_t recJuego[NUM_JUEGOS + ARC_MAX_DESC + 1];   // >>> NUEVO: + descargados + AGREGAR

void cargarRecords() {
  recJuego[0] = hiScore;
  recJuego[1] = prefsA.getUInt("hiTet", 0);
  recJuego[2] = prefsA.getUInt("hiInv", 0);
  recJuego[3] = prefsA.getUInt("hiDino", 0);
  // >>> NUEVO: juegos descargados (AGREGAR, la ultima caratula, no tiene record)
  for (int i = 0; i < agm::n; i++) {
    char k[12];
    agm::claveRec(agm::desc[i].id, k);
    recJuego[NUM_JUEGOS + i] = prefsA.getUInt(k, 0);
  }
  recJuego[NUM_JUEGOS + agm::n] = 0;
}

// >>> NUEVO: lista dinamica de caratulas = juegos incluidos + descargados + AGREGAR
int numJuegos() { return NUM_JUEGOS + agm::n + 1; }
bool esAgregar(int i) { return i == NUM_JUEGOS + agm::n; }
const char* jNombre(int i) {
  if (i < NUM_JUEGOS) return JUEGOS[i].nombre;
  if (i < NUM_JUEGOS + agm::n) return agm::desc[i - NUM_JUEGOS].titulo;
  return "AGREGAR";
}
uint16_t jColor(int i) {
  if (i < NUM_JUEGOS) return JUEGOS[i].color;
  if (i < NUM_JUEGOS + agm::n) return agm::desc[i - NUM_JUEGOS].color;
  return agr::AC;
}
void jLanzar(int i) {
  if (i < NUM_JUEGOS) {
    JUEGOS[i].jugar();
  } else if (i < NUM_JUEGOS + agm::n) {
    mot::sel = i - NUM_JUEGOS;
    mot::jugar();
  } else {
    agr::agregar();
    if (agr::selNuevo >= 0) { selJuego = NUM_JUEGOS + agr::selNuevo; agr::selNuevo = -1; }
  }
  if (selJuego >= numJuegos()) selJuego = numJuegos() - 1;
}


// ---------------------------------------------------------------------
//  PORTADAS: fondo = escena del juego en 80x80, difuminada y ampliada x3
//  (la ampliacion bilineal ya aporta el desenfoque). Se compone en un
//  lienzo de 240x240 y solo el boton START se repinta en cada cuadro.
// ---------------------------------------------------------------------
#define PT_W 80
#define PT_H 80
#define PT_BX0 54
#define PT_BX1 186
#define PT_BY0 146
#define PT_BY1 198

static GFXcanvas16 *cvM = nullptr, *cvA = nullptr, *cvB = nullptr;
static uint8_t ptX0[240], ptX1[240], ptWX[240], ptVig[120];
static bool    ptListo = false;

// mezcla a->b con w = 0..32 (truco RGB565 "separado")
static inline uint16_t lerp565(uint16_t a, uint16_t b, uint8_t w) {
  uint32_t A = (a | (uint32_t)a << 16) & 0x07E0F81F;
  uint32_t B = (b | (uint32_t)b << 16) & 0x07E0F81F;
  uint32_t r = ((((B - A) * w) >> 5) + A) & 0x07E0F81F;
  return (uint16_t)(r | (r >> 16));
}
// oscurece c con f = 0..32 (32 = igual)
static inline uint16_t mul565(uint16_t c, uint8_t f) {
  uint32_t A = (c | (uint32_t)c << 16) & 0x07E0F81F;
  A = ((A * f) >> 5) & 0x07E0F81F;
  return (uint16_t)(A | (A >> 16));
}

static void ptIniciarTablas() {
  if (ptListo) return;
  for (int i = 0; i < 240; i++) {
    int u = i - 1, i0, f;
    if (u < 0) { i0 = 0; f = 0; } else { i0 = u / 3; f = u % 3; }
    if (i0 > PT_W - 1) i0 = PT_W - 1;
    int i1 = i0 + 1; if (i1 > PT_W - 1) i1 = PT_W - 1;
    ptX0[i] = i0; ptX1[i] = i1; ptWX[i] = f * 32 / 3;   // las filas usan la misma tabla (80x80 -> 240x240)
  }
  for (int k = 0; k < 120; k++) {                         // viñeta: oscurece hacia el borde redondo
    float r = sqrtf((float)(k * 128 + 64));
    float f = (r < 64.0f) ? 32.0f : 32.0f - (r - 64.0f) * 20.0f / 56.0f;
    if (f < 12.0f) f = 12.0f;
    ptVig[k] = (uint8_t)f;
  }
  ptListo = true;
}

// Desenfoque 3x3 + oscurecido (para que el titulo se lea bien encima)
static void ptDifuminar(uint16_t* b, uint8_t dim) {
  static uint16_t tmp[PT_W * PT_H];
  for (int y = 0; y < PT_H; y++) for (int x = 0; x < PT_W; x++) {
    int sr = 0, sg = 0, sb = 0;
    for (int dy = -1; dy <= 1; dy++) {
      int yy = y + dy; if (yy < 0) yy = 0; if (yy > PT_H - 1) yy = PT_H - 1;
      for (int dx = -1; dx <= 1; dx++) {
        int xx = x + dx; if (xx < 0) xx = 0; if (xx > PT_W - 1) xx = PT_W - 1;
        uint16_t c = b[yy * PT_W + xx];
        sr += (c >> 11) & 31; sg += (c >> 5) & 63; sb += c & 31;
      }
    }
    uint16_t c = (uint16_t)((((sr * 57) >> 9) << 11) | (((sg * 57) >> 9) << 5) | ((sb * 57) >> 9));
    tmp[y * PT_W + x] = mul565(c, dim);
  }
  memcpy(b, tmp, sizeof(tmp));
}

// ----- ESCENAS (se dibujan a 80x80; todo es aproximado, luego se difumina) -----
static void ptSprite(GFXcanvas16* c, int x, int y, const char* const* f, int w, int h, uint16_t col) {
  for (int j = 0; j < h; j++) for (int i = 0; i < w; i++) if (f[j][i] == '#') c->drawPixel(x + i, y + j, col);
}
static void ptFantasma(GFXcanvas16* c, int cx, int cy, uint16_t col, uint16_t fondo) {
  c->fillCircle(cx, cy, 9, col);
  c->fillRect(cx - 9, cy, 19, 10, col);
  c->fillTriangle(cx - 6, cy + 9, cx - 2, cy + 9, cx - 4, cy + 5, fondo);
  c->fillTriangle(cx + 2, cy + 9, cx + 6, cy + 9, cx + 4, cy + 5, fondo);
  c->fillCircle(cx - 3, cy - 2, 3, 0xFFFF);
  c->fillCircle(cx + 4, cy - 2, 3, 0xFFFF);
  c->fillCircle(cx - 2, cy - 2, 1, C565(20, 20, 255));
  c->fillCircle(cx + 5, cy - 2, 1, C565(20, 20, 255));
}

static void ptEscPacman(GFXcanvas16* c) {
  const uint16_t fondo = C565(0, 0, 30), az = C565(50, 70, 255), pun = C565(255, 190, 180);
  c->fillScreen(fondo);
  c->drawRoundRect(5, 4, 30, 14, 5, az);   c->drawRoundRect(45, 4, 30, 14, 5, az);
  c->drawRoundRect(5, 64, 30, 14, 5, az);  c->drawRoundRect(45, 64, 30, 14, 5, az);
  for (int x = 6; x < 76; x += 8) c->fillRect(x, 56, 2, 2, pun);
  for (int x = 6; x < 76; x += 8) c->fillRect(x, 22, 2, 2, pun);
  c->fillCircle(24, 39, 15, C565(255, 230, 0));
  c->fillTriangle(24, 39, 44, 26, 44, 52, fondo);
  c->fillCircle(25, 31, 2, fondo);
  c->fillRect(45, 38, 3, 3, pun); c->fillRect(53, 38, 3, 3, pun);
  ptFantasma(c, 67, 39, C565(255, 30, 30), fondo);
}

static void ptCelda(GFXcanvas16* c, int x, int y, uint16_t col) {
  c->fillRect(x, y, 6, 6, col);
  c->drawFastHLine(x, y, 6, aclarar(col));
  c->drawFastVLine(x, y, 6, aclarar(col));
}
static void ptEscTetris(GFXcanvas16* c) {
  c->fillScreen(C565(0, 0, 24));
  const uint16_t rej = C565(16, 16, 56);
  for (int i = 0; i <= 10; i++) c->drawFastVLine(10 + i * 6, 2, 78, rej);
  for (int j = 0; j <= 13; j++) c->drawFastHLine(10, 2 + j * 6, 60, rej);
  static const char* const TP[6] = {
    "...5......",
    "..55..2...",
    "1.5.4422.7",
    "113.44.277",
    "1332.6677.",
    "1332666.77"
  };
  for (int j = 0; j < 6; j++) for (int i = 0; i < 10; i++) {
    char ch = TP[j][i];
    if (ch >= '1' && ch <= '7') ptCelda(c, 10 + i * 6, 2 + (7 + j) * 6, tet::COLORES0[ch - '0']);
  }
  // pieza T cayendo y palo I
  for (int i = 6; i <= 8; i++) ptCelda(c, 10 + i * 6, 2 + 2 * 6, tet::COLORES0[3]);
  ptCelda(c, 10 + 7 * 6, 2 + 1 * 6, tet::COLORES0[3]);
  for (int j = 0; j < 4; j++) ptCelda(c, 10 + 1 * 6, 2 + (1 + j) * 6, tet::COLORES0[1]);
}

static void ptEscInvaders(GFXcanvas16* c) {
  c->fillScreen(C565(0, 0, 12));
  static const uint8_t est[][2] = {{6,5},{20,22},{33,9},{47,27},{58,6},{70,20},{12,45},{74,48},{28,40},{52,44},{66,36},{40,2}};
  for (unsigned i = 0; i < sizeof(est) / 2; i++) c->drawPixel(est[i][0], est[i][1], C565(150, 150, 190));
  for (int i = 0; i < 4; i++) {
    ptSprite(c, 8 + i * 16 + 4, 8,  inv::SQUID_A, 8, 8,  inv::C_FILA0[0]);
    ptSprite(c, 8 + i * 16 + 2, 20, inv::CRAB_A, 11, 8,  inv::C_FILA0[1]);
    ptSprite(c, 8 + i * 16 + 2, 32, inv::OCTO_A, 12, 8, inv::C_FILA0[3]);
  }
  for (int s = 0; s < 3; s++) ptSprite(c, 7 + s * 28, 52, inv::FORMA_ESC, 11, 6, inv::C_ESC0);
  ptSprite(c, 14, 66, inv::NAVE, 13, 8, inv::C_NAVE0);
  c->fillRect(20, 44, 1, 18, inv::C_BALA0);
}

