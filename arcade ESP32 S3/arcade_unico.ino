// ===== inicio de rfid_rc522.h =====
// =====================================================================
//  Driver minimo del lector RC522 (MFRC522) por SPI, sin librerias.
//  Solo lo necesario: detectar etiquetas tipo 2 (NTAG / Ultralight) y
//  leer sus paginas. Comparte SCK y MOSI con la pantalla; usa su propio
//  SS (pin 7), MISO (pin 13) y RST (pin 43). Va a 4 MHz con transacciones.
// =====================================================================
namespace rc {

const uint8_t CmdReg = 0x01, ComIrqReg = 0x04, DivIrqReg = 0x05, ErrorReg = 0x06,
              FifoDataReg = 0x09, FifoLevelReg = 0x0A, BitFramingReg = 0x0D, CollReg = 0x0E,
              ModeReg = 0x11, TxControlReg = 0x14, TxASKReg = 0x15, CrcResH = 0x21, CrcResL = 0x22,
              TModeReg = 0x2A, TPrescalerReg = 0x2B, TReloadH = 0x2C, TReloadL = 0x2D, VersionReg = 0x37;

bool    listo = false;
uint8_t sak = 0;
uint8_t uid[10];
uint8_t uidLen = 0;
uint8_t datos[528];          // area de datos de la etiqueta (desde la pagina 4)
int     datosLen = 0;
int     ndefOff = 0, ndefLen = 0;

void wr(uint8_t r, uint8_t v) {
  SPI.beginTransaction(SPISettings(4000000, MSBFIRST, SPI_MODE0));
  digitalWrite(RC_SS, LOW);
  SPI.transfer((r << 1) & 0x7E);
  SPI.transfer(v);
  digitalWrite(RC_SS, HIGH);
  SPI.endTransaction();
}
uint8_t rd(uint8_t r) {
  SPI.beginTransaction(SPISettings(4000000, MSBFIRST, SPI_MODE0));
  digitalWrite(RC_SS, LOW);
  SPI.transfer(((r << 1) & 0x7E) | 0x80);
  uint8_t v = SPI.transfer(0);
  digitalWrite(RC_SS, HIGH);
  SPI.endTransaction();
  return v;
}

// Reinicia el chip y comprueba que responde. false = no hay lector.
bool iniciar() {
  pinMode(RC_SS, OUTPUT);  digitalWrite(RC_SS, HIGH);
  pinMode(RC_RST, OUTPUT);
  digitalWrite(RC_RST, LOW);  delay(10);
  digitalWrite(RC_RST, HIGH); delay(50);
  wr(CmdReg, 0x0F);                                   // reset por software
  uint32_t t = millis();
  while ((rd(CmdReg) & 0x10) && millis() - t < 100) delay(2);
  uint8_t v = rd(VersionReg);
  listo = !(v == 0x00 || v == 0xFF);
  if (!listo) return false;
  wr(TModeReg, 0x80); wr(TPrescalerReg, 0xA9);        // temporizador ~25 ms
  wr(TReloadH, 0x03); wr(TReloadL, 0xE8);
  wr(TxASKReg, 0x40); wr(ModeReg, 0x3D);
  if ((rd(TxControlReg) & 3) != 3) wr(TxControlReg, rd(TxControlReg) | 3);   // antena ON
  return true;
}
// Apaga la antena y deja el chip dormido (RST bajo)
void apagar() {
  if (listo) wr(TxControlReg, rd(TxControlReg) & ~3);
  digitalWrite(RC_RST, LOW);
  listo = false;
}

// Envia n bytes y recibe hasta rmax. Devuelve los bytes recibidos o -1.
int trx(const uint8_t* s, uint8_t n, uint8_t* r, uint8_t rmax, uint8_t bitsUlt) {
  wr(CmdReg, 0x00);
  wr(ComIrqReg, 0x7F);
  wr(FifoLevelReg, 0x80);
  for (uint8_t i = 0; i < n; i++) wr(FifoDataReg, s[i]);
  wr(BitFramingReg, bitsUlt);
  wr(CmdReg, 0x0C);                                   // Transceive
  wr(BitFramingReg, bitsUlt | 0x80);                  // StartSend
  uint32_t t = millis();
  uint8_t irq;
  for (;;) {
    irq = rd(ComIrqReg);
    if (irq & 0x31) break;
    if (millis() - t > 30) { wr(CmdReg, 0x00); return -1; }
  }
  wr(BitFramingReg, bitsUlt);
  if ((irq & 0x01) && !(irq & 0x20)) return -1;       // sin respuesta
  if (rd(ErrorReg) & 0x13) return -1;                 // desbordamiento, paridad o protocolo
  uint8_t k = rd(FifoLevelReg);
  if (k > rmax) k = rmax;
  for (uint8_t i = 0; i < k; i++) r[i] = rd(FifoDataReg);
  return k;
}

bool crc(const uint8_t* d, uint8_t n, uint8_t* out) {
  wr(CmdReg, 0x00); wr(DivIrqReg, 0x04); wr(FifoLevelReg, 0x80);
  for (uint8_t i = 0; i < n; i++) wr(FifoDataReg, d[i]);
  wr(CmdReg, 0x03);
  uint32_t t = millis();
  while (!(rd(DivIrqReg) & 0x04)) if (millis() - t > 20) return false;
  wr(CmdReg, 0x00);
  out[0] = rd(CrcResL); out[1] = rd(CrcResH);
  return true;
}

// Despierta y selecciona una etiqueta (WUPA + anticolision). true = hay una y queda en uid/sak.
bool detectar() {
  if (!listo) return false;
  wr(CollReg, rd(CollReg) & 0x7F);
  uint8_t b[18], q = 0x52;                            // WUPA
  if (trx(&q, 1, b, 18, 7) != 2) return false;
  uidLen = 0;
  for (uint8_t nivel = 0; nivel < 3; nivel++) {
    uint8_t sel = (nivel == 0) ? 0x93 : (nivel == 1) ? 0x95 : 0x97;
    uint8_t a[2] = {sel, 0x20};
    if (trx(a, 2, b, 18, 0) != 5) return false;
    if ((uint8_t)(b[0] ^ b[1] ^ b[2] ^ b[3]) != b[4]) return false;
    uint8_t u[5]; memcpy(u, b, 5);
    uint8_t s[9] = {sel, 0x70, u[0], u[1], u[2], u[3], u[4], 0, 0};
    if (!crc(s, 7, s + 7)) return false;
    if (trx(s, 9, b, 18, 0) != 3) return false;
    sak = b[0];
    if (u[0] == 0x88) { memcpy(uid + uidLen, u + 1, 3); uidLen += 3; }
    else              { memcpy(uid + uidLen, u, 4);     uidLen += 4; break; }
    if (!(sak & 0x04)) break;
  }
  return uidLen > 0;
}

// Pone la etiqueta en HALT (para poder volver a detectarla con WUPA)
void detener() {
  uint8_t h[4] = {0x50, 0x00, 0, 0}, b[4];
  crc(h, 2, h + 2);
  trx(h, 4, b, 4, 0);
}

bool leerPag(uint8_t pag, uint8_t* out16) {
  uint8_t c[4] = {0x30, pag, 0, 0}, b[18], cc[2];
  crc(c, 2, c + 2);
  if (trx(c, 4, b, 18, 0) != 18) return false;
  if (!crc(b, 16, cc) || cc[0] != b[16] || cc[1] != b[17]) return false;
  memcpy(out16, b, 16);
  return true;
}

// Lee el area NDEF de una etiqueta tipo 2. Deja el mensaje en datos[ndefOff .. ndefOff+ndefLen).
//  1 = ok, 0 = vacia o sin NDEF, -1 = error de lectura, -2 = tipo no soportado (no es NTAG/Ultralight)
int leerNdef() {
  if (sak != 0x00) return -2;
  uint8_t p[16];
  if (!leerPag(0, p)) return -1;                      // pag 0-3: el byte 12 es el CC
  if (p[12] != 0xE1) return 0;                        // sin formato NDEF
  int tam = p[14] * 8;
  if (tam < 16) return 0;
  if (tam > 512) tam = 512;
  for (int off = 0; off < tam; off += 16)
    if (!leerPag(4 + off / 4, datos + off)) return -1;
  datosLen = tam;
  int i = 0;
  ndefOff = ndefLen = 0;
  while (i < datosLen) {                              // recorre los TLV
    uint8_t t = datos[i++];
    if (t == 0x00) continue;
    if (t == 0xFE || i >= datosLen) break;
    int len = datos[i++];
    if (len == 0xFF) { if (i + 1 >= datosLen) break; len = (datos[i] << 8) | datos[i + 1]; i += 2; }
    if (t == 0x03) {
      if (len == 0 || i + len > datosLen) return 0;
      ndefOff = i; ndefLen = len;
      return 1;
    }
    i += len;
  }
  return 0;
}

}  // namespace rc

// ===== fin de rfid_rc522.h =====


// ===== inicio de ndef.h =====
// =====================================================================
//  Lector de mensajes NDEF: se queda con el primer registro URI y el
//  primer registro de texto (lo que escriben las apps de celular).
// =====================================================================
namespace ndef {

char uri[161];
char txt[161];

bool parsear(const uint8_t* m, int n) {
  uri[0] = txt[0] = 0;
  int i = 0;
  while (i < n) {
    uint8_t h = m[i++];
    bool sr = h & 0x10, il = h & 0x08;
    uint8_t tnf = h & 7;
    if (h & 0x20) break;                              // registros en trozos: no soportado
    if (i >= n) break;
    uint8_t tl = m[i++];
    uint32_t pl;
    if (sr) { if (i >= n) break; pl = m[i++]; }
    else {
      if (i + 4 > n) break;
      pl = ((uint32_t)m[i] << 24) | ((uint32_t)m[i + 1] << 16) | ((uint32_t)m[i + 2] << 8) | m[i + 3];
      i += 4;
    }
    uint8_t idl = 0;
    if (il) { if (i >= n) break; idl = m[i++]; }
    if (pl > (uint32_t)n || i + tl + idl + (int)pl > n) break;
    const uint8_t* ty = m + i;
    const uint8_t* pa = m + i + tl + idl;
    if (tnf == 1 && tl == 1 && ty[0] == 'U' && pl >= 1 && !uri[0]) {
      static const char* const PRE[5] = {"", "http://www.", "https://www.", "http://", "https://"};
      uint8_t c = pa[0];
      if (c <= 4) {
        size_t k = strlen(PRE[c]);
        strcpy(uri, PRE[c]);
        for (uint32_t j = 1; j < pl && k < sizeof(uri) - 1; j++) uri[k++] = (char)pa[j];
        uri[k] = 0;
      }
    } else if (tnf == 1 && tl == 1 && ty[0] == 'T' && pl >= 1 && !txt[0]) {
      uint8_t st = pa[0];
      uint8_t ll = st & 0x3F;
      if (!(st & 0x80) && (uint32_t)(1 + ll) <= pl) {         // solo UTF-8
        size_t k = 0;
        for (uint32_t j = 1 + ll; j < pl && k < sizeof(txt) - 1; j++) txt[k++] = (char)pa[j];
        txt[k] = 0;
      }
    }
    i += tl + idl + (int)pl;
    if (h & 0x40) break;                              // ME: ultimo registro
  }
  return uri[0] || txt[0];
}

}  // namespace ndef

// ===== fin de ndef.h =====


// ===== inicio de juegos_datos.h =====
// =====================================================================
//  Juegos descargados (.agm): formato, validacion y almacen en LittleFS.
//
//  FORMATO .agm (texto, ASCII, maximo 12 KB):
//     ARCGAME1
//     tipo=sokoban              (o snake)
//     titulo=CAJAS              (1 a 8 letras/numeros/espacio/guion)
//     color=FF8800              (RRGGBB)
//     portada=r,10,50,60,20,FF8800;c,40,30,12,FFFF00     (opcional, lienzo 80x80)
//     vel=150                   (solo snake: ms por paso, 60..500)
//     meta=8                    (solo snake: manzanas por nivel, 3..50)
//     [nivel]
//     #####
//     #@$.#
//     #####
//     [nivel]
//     ...
//  Portada: r,x,y,w,h,color | c,x,y,radio,color | l,x0,y0,x1,y1,color | t,x0,y0,x1,y1,x2,y2,color
//  Sokoban: # pared, @ jugador, + jugador sobre meta, $ caja, . meta, * caja en meta, espacio = suelo
//  Snake  : # pared, S inicio (obligatorio, uno solo), . o espacio = suelo
//  Maximo 13x13 por nivel y 12 niveles.
// =====================================================================
#define ARC_MAX_DESC   6        // juegos descargados como maximo
#define ARC_MAX_BYTES  12288    // tamano maximo de un .agm
#define ARC_MAX_NIV    12
#define ARC_DIM        13

namespace agm {

struct Desc {
  char     id[25];
  char     titulo[9];
  uint16_t color;
  uint8_t  tipo;               // 1 = sokoban, 2 = snake
  char     portada[200];
};

Desc    desc[ARC_MAX_DESC];
uint8_t n = 0;
bool    fsOk = false;

bool montar() {
  if (fsOk) return true;
  fsOk = LittleFS.begin(true);
  if (fsOk) LittleFS.mkdir("/g");
  return fsOk;
}

bool idValido(const char* s) {
  size_t l = strlen(s);
  if (l < 1 || l > 24) return false;
  for (size_t i = 0; i < l; i++) {
    char c = s[i];
    if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_' || c == '-')) return false;
  }
  return true;
}

int hexv(char c) {
  if (c >= '0' && c <= '9') return c - '0';
  if (c >= 'a' && c <= 'f') return c - 'a' + 10;
  if (c >= 'A' && c <= 'F') return c - 'A' + 10;
  return -1;
}
bool hex565(const char* s, uint16_t* out) {
  int v[6];
  for (int i = 0; i < 6; i++) { v[i] = hexv(s[i]); if (v[i] < 0) return false; }
  *out = C565(v[0] * 16 + v[1], v[2] * 16 + v[3], v[4] * 16 + v[5]);
  return true;
}

// Clave de Preferences para el record de un juego (hash FNV-1a del id)
void claveRec(const char* id, char* k) {
  uint32_t h = 2166136261UL;
  for (const char* p = id; *p; p++) { h ^= (uint8_t)*p; h *= 16777619UL; }
  snprintf(k, 12, "h%08lx", (unsigned long)h);
}

// Siguiente linea: devuelve su inicio y deja en *len su largo sin \r\n; avanza *p. nullptr = fin
const char* linea(const char** p, int* len) {
  const char* s = *p;
  if (!*s) return nullptr;
  const char* e = s;
  while (*e && *e != '\n') e++;
  int l = e - s;
  if (l > 0 && s[l - 1] == '\r') l--;
  *len = l;
  *p = *e ? e + 1 : e;
  return s;
}

// Valor de una clave de la cabecera (antes del primer '['), copiado en out. false si no esta.
bool valor(const char* b, const char* clave, char* out, int cap) {
  const char* p = b;
  int l;
  size_t kl = strlen(clave);
  const char* s;
  while ((s = linea(&p, &l)) != nullptr) {
    if (l > 0 && s[0] == '[') return false;
    if ((size_t)l > kl && strncmp(s, clave, kl) == 0 && s[kl] == '=') {
      int vl = l - kl - 1;
      if (vl >= cap) vl = cap - 1;
      memcpy(out, s + kl + 1, vl);
      out[vl] = 0;
      return true;
    }
  }
  return false;
}
int valorInt(const char* b, const char* clave, int def) {
  char t[12];
  if (!valor(b, clave, t, sizeof(t))) return def;
  return atoi(t);
}

// Lee la cabecera. b debe terminar en 0. true si es valida.
bool cabecera(const char* b, Desc& d) {
  if (strncmp(b, "ARCGAME1", 8) != 0 || (b[8] != '\n' && b[8] != '\r')) return false;
  char t[200];
  if (!valor(b, "tipo", t, sizeof(t))) return false;
  if (!strcmp(t, "sokoban")) d.tipo = 1; else if (!strcmp(t, "snake")) d.tipo = 2; else return false;
  if (!valor(b, "titulo", t, sizeof(t))) return false;
  size_t l = strlen(t);
  if (l < 1 || l > 8) return false;
  for (size_t i = 0; i < l; i++) {
    char c = t[i];
    if (c >= 'a' && c <= 'z') c -= 32;
    if (!((c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == ' ' || c == '-')) return false;
    d.titulo[i] = c;
  }
  d.titulo[l] = 0;
  if (!valor(b, "color", t, sizeof(t)) || strlen(t) != 6 || !hex565(t, &d.color)) return false;
  d.portada[0] = 0;
  if (valor(b, "portada", t, sizeof(t))) {
    if (strlen(t) >= sizeof(d.portada)) return false;
    for (const char* q = t; *q; q++) {
      char c = *q;
      if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F') ||
            c == ',' || c == ';' || c == 'r' || c == 'c' || c == 'l' || c == 't')) return false;
    }
    strcpy(d.portada, t);
  }
  return true;
}

// Copia el nivel k (0..) a filas[ARC_DIM][ARC_DIM + 1]; rellena con '#'. false si no existe o es invalido.
bool nivel(const char* b, int k, char filas[ARC_DIM][ARC_DIM + 1], int* w, int* h) {
  const char* p = b;
  int l, cuenta = -1;
  const char* s;
  *w = 0; *h = 0;
  bool dentro = false;
  while ((s = linea(&p, &l)) != nullptr) {
    if (l > 0 && s[0] == '[') {
      if (dentro) break;
      if (l == 7 && strncmp(s, "[nivel]", 7) == 0) { cuenta++; dentro = (cuenta == k); }
      continue;
    }
    if (!dentro) continue;
    if (l == 0) { if (*h > 0) break; else continue; }
    if (l > ARC_DIM || *h >= ARC_DIM) return false;
    memcpy(filas[*h], s, l);
    filas[*h][l] = 0;
    if (l > *w) *w = l;
    (*h)++;
  }
  if (!dentro || *w < 3 || *h < 3) return false;
  for (int r = 0; r < *h; r++) {
    int l2 = strlen(filas[r]);
    for (int c = l2; c < *w; c++) filas[r][c] = '#';
    filas[r][*w] = 0;
  }
  return true;
}

int contarNiveles(const char* b) {
  const char* p = b;
  int l, c = 0;
  const char* s;
  while ((s = linea(&p, &l)) != nullptr)
    if (l == 7 && strncmp(s, "[nivel]", 7) == 0) c++;
  return c;
}

// Validacion completa de un archivo descargado (b termina en 0, len = bytes). 0 = ok
//  1 = formato general, 2 = cabecera, 3 = niveles
int validar(const char* b, int len, Desc& d) {
  if (len < 20 || len > ARC_MAX_BYTES) return 1;
  for (int i = 0; i < len; i++) {
    uint8_t c = b[i];
    if (c == '\n' || c == '\r') continue;
    if (c < 32 || c > 126) return 1;
  }
  if (strlen(b) != (size_t)len) return 1;
  const char* c1 = strchr(b, '[');
  if (!c1 || c1 - b > 600) return 2;
  if (!cabecera(b, d)) return 2;
  if (d.tipo == 2) {
    int v = valorInt(b, "vel", 150), m = valorInt(b, "meta", 8);
    if (v < 60 || v > 500 || m < 3 || m > 50) return 2;
  }
  int nn = contarNiveles(b);
  if (nn < 1 || nn > ARC_MAX_NIV) return 3;
  static char f[ARC_DIM][ARC_DIM + 1];
  for (int k = 0; k < nn; k++) {
    int w, h;
    if (!nivel(b, k, f, &w, &h)) return 3;
    int jug = 0, cajas = 0, metas = 0, libres = 0;
    for (int r = 0; r < h; r++) for (int c = 0; c < w; c++) {
      char ch = f[r][c];
      if (d.tipo == 1) {
        if (!strchr("#@+$.* ", ch)) return 3;
        if (ch == '@' || ch == '+') jug++;
        if (ch == '$' || ch == '*') cajas++;
        if (ch == '.' || ch == '*' || ch == '+') metas++;
      } else {
        if (!strchr("#S. ", ch)) return 3;
        if (ch == 'S') jug++;
        if (ch != '#') libres++;
      }
    }
    if (jug != 1) return 3;
    if (d.tipo == 1 && (cajas < 1 || cajas != metas)) return 3;
    if (d.tipo == 2 && libres < 8) return 3;
  }
  return 0;
}

int buscar(const char* id) {
  for (int i = 0; i < n; i++) if (!strcmp(desc[i].id, id)) return i;
  return -1;
}

// Lee /g y reconstruye la lista de juegos instalados (ordenada por id)
void indexar() {
  n = 0;
  if (!montar()) return;
  File dir = LittleFS.open("/g");
  if (!dir) return;
  File f;
  while ((f = dir.openNextFile()) && n < ARC_MAX_DESC) {
    if (f.isDirectory()) { f.close(); continue; }
    String nm = f.name();
    if (!nm.endsWith(".agm")) { f.close(); continue; }
    nm = nm.substring(0, nm.length() - 4);
    char b[704];
    int k = f.read((uint8_t*)b, 700);
    f.close();
    if (k < 20 || nm.length() > 24) continue;
    b[k] = 0;
    Desc d;
    memset(&d, 0, sizeof(d));
    strcpy(d.id, nm.c_str());
    if (!idValido(d.id) || !cabecera(b, d)) continue;
    desc[n++] = d;
  }
  dir.close();
  for (int i = 1; i < n; i++)                          // orden por id (insercion)
    for (int j = i; j > 0 && strcmp(desc[j - 1].id, desc[j].id) > 0; j--) {
      Desc t = desc[j]; desc[j] = desc[j - 1]; desc[j - 1] = t;
    }
}

// Guarda un archivo ya validado. 0 = ok, 1 = sin espacio, 2 = error al escribir
int guardar(const char* id, const uint8_t* b, int len) {
  if (!montar()) return 2;
  if (LittleFS.totalBytes() - LittleFS.usedBytes() < (size_t)len + 4096) return 1;
  char ruta[40];
  snprintf(ruta, sizeof(ruta), "/g/%s.agm", id);
  File f = LittleFS.open(ruta, "w");
  if (!f) return 2;
  size_t w = f.write(b, len);
  f.close();
  if (w != (size_t)len) { LittleFS.remove(ruta); return 2; }
  return 0;
}

void borrar(const char* id) {
  char ruta[40];
  snprintf(ruta, sizeof(ruta), "/g/%s.agm", id);
  LittleFS.remove(ruta);
  char k[12]; claveRec(id, k);
  prefsA.remove(k);
  indexar();
}

// Carga el archivo completo en memoria (liberar con free). nullptr si falla.
char* cargar(const char* id, int* len) {
  char ruta[40];
  snprintf(ruta, sizeof(ruta), "/g/%s.agm", id);
  File f = LittleFS.open(ruta, "r");
  if (!f) return nullptr;
  int sz = f.size();
  if (sz < 20 || sz > ARC_MAX_BYTES) { f.close(); return nullptr; }
  char* b = (char*)malloc(sz + 1);
  if (!b) { f.close(); return nullptr; }
  int k = f.read((uint8_t*)b, sz);
  f.close();
  if (k != sz) { free(b); return nullptr; }
  b[sz] = 0;
  *len = sz;
  return b;
}

// Dibuja la portada (lienzo 80x80) a partir de la cadena "portada"
void portada(const Desc& d, GFXcanvas16* c) {
  c->fillScreen(mezclar565(d.color, 0x0000, 215));
  if (!d.portada[0]) {                                // portada por defecto segun el tipo
    uint16_t col = d.color;
    if (d.tipo == 1) {
      c->fillRect(18, 38, 18, 18, col); c->drawRect(18, 38, 18, 18, 0xFFFF);
      c->fillRect(44, 22, 18, 18, col); c->drawRect(44, 22, 18, 18, 0xFFFF);
      c->fillCircle(54, 58, 6, 0xFFFF);
    } else {
      for (int i = 0; i < 6; i++) c->fillRect(12 + i * 8, 44 - (i % 2) * 6, 8, 8, i == 5 ? 0xFFFF : col);
      c->fillCircle(66, 24, 5, C_RED);
    }
    return;
  }
  char tmp[200];
  strcpy(tmp, d.portada);
  char* p = tmp;
  for (int it = 0; it < 24 && *p; it++) {
    char* fin = strchr(p, ';');
    if (fin) *fin = 0;
    char* campos[9];
    int nc = 0;
    char* q = p;
    while (nc < 9) {
      campos[nc++] = q;
      char* co = strchr(q, ',');
      if (!co) break;
      *co = 0; q = co + 1;
    }
    if (nc >= 5) {
      uint16_t col;
      char tipo = campos[0][0];
      int v[8];
      for (int i = 1; i < nc - 1; i++) v[i - 1] = atoi(campos[i]);
      if (strlen(campos[nc - 1]) == 6 && hex565(campos[nc - 1], &col)) {
        if (tipo == 'r' && nc == 6)      c->fillRect(v[0], v[1], v[2], v[3], col);
        else if (tipo == 'c' && nc == 5) c->fillCircle(v[0], v[1], v[2], col);
        else if (tipo == 'l' && nc == 6) c->drawLine(v[0], v[1], v[2], v[3], col);
        else if (tipo == 't' && nc == 8) c->fillTriangle(v[0], v[1], v[2], v[3], v[4], v[5], col);
      }
    }
    if (!fin) break;
    p = fin + 1;
  }
}

