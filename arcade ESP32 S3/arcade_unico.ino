// Lanza un juego descargado (tipo sokoban / snake) con su menu JUGAR / OPCIONES de siempre
namespace mot {

int sel = 0;                       // indice en agm::desc

void jugar() {
  if (sel < 0 || sel >= agm::n) return;
  agm::Desc d = agm::desc[sel];
  int len = 0;
  char* b = agm::cargar(d.id, &len);
  if (!b) {
    tft.fillScreen(NEGRO);
    printC("ARCHIVO ILEGIBLE", 104, 1, C_RED);
    esperar(1500);
    return;
  }
  int total = agm::contarNiveles(b);
  char key[12];
  agm::claveRec(d.id, key);
  uint32_t rec = prefsA.getUInt(key, 0);
  for (;;) {
    rec = prefsA.getUInt(key, 0);
    if (!menuJuego(d.titulo, d.color, rec, d.tipo == 1 ? 0 : 1)) break;
    if (d.tipo == 1) {
      uint32_t hecho = sok::partida(b, total, d.color);
      if (hecho > rec) prefsA.putUInt(key, hecho);
    } else {
      for (;;) {
        bool perdio = snk::partida(b, total, d.color);
        if (!perdio) break;
        bool nuevo = snk::puntos > rec;
        if (nuevo) { rec = snk::puntos; prefsA.putUInt(key, rec); }
        if (!pantallaFin(snk::puntos, rec, nuevo, skinTinte(d.color))) break;
      }
    }
  }
  free(b);
}

}  // namespace mot

