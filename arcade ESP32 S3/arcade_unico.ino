// ---------- Utilidades de color ----------
static inline uint16_t rgb565(uint8_t r, uint8_t g, uint8_t b) {
  return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
}

// Escala el brillo de un color RGB565 (b = 0..255)
static inline uint16_t escalar565(uint16_t c, int b) {
  int r = (c >> 11) & 31, g = (c >> 5) & 63, bl = c & 31;
  r = (r * (b + 1)) >> 8;
  g = (g * (b + 1)) >> 8;
  bl = (bl * (b + 1)) >> 8;
  return (r << 11) | (g << 5) | bl;
}

// ---------- Logo VEX (imagen) ----------
// Dibuja el logo (sin fondo) con un brillo 0..255, solo los píxeles opacos.
// Sirve para el fundido de la pantalla de arranque.
void dibujarLogoVEX(int x0, int y0, int brillo) {
  static uint16_t fila[VEXIMG_W];
  tft.startWrite();
  for (int y = 0; y < VEXIMG_H; y++) {
    int py = y0 + y;
    if (py < 0 || py >= 240) continue;
    int x = 0;
    while (x < VEXIMG_W) {
      if (!pgm_read_word(&VEXIMG[y * VEXIMG_W + x])) { x++; continue; }
      int ini = x, n = 0;
      while (x < VEXIMG_W) {
        uint16_t c = pgm_read_word(&VEXIMG[y * VEXIMG_W + x]);
        if (!c) break;
        fila[n++] = escalar565(c, brillo);
        x++;
      }
      tft.setAddrWindow(x0 + ini, py, n, 1);
      tft.writePixels(fila, n);
    }
  }
  tft.endWrite();
}

void aparecerVEX(int x0, int y0) {
  for (int b = 0; b < 255; b += 15) {
    dibujarLogoVEX(x0, y0, b);
    delay(10);
  }
  dibujarLogoVEX(x0, y0, 255);
}

// ---------- Robot sin fondo (máscara) ----------
static uint8_t FONDO[ROBOT_W * ROBOT_H];   // 1 = transparente

bool esOscuro(uint16_t c) {
  int r = (c >> 11) & 31, g = (c >> 5) & 63, b = c & 31;
  return (r + g / 2 + b) <= 3;             // negro o casi negro
}

// Marca como transparente solo el negro conectado con el borde de la imagen,
// así los negros internos del robot se conservan.
void prepararMascaraRobot() {
  memset(FONDO, 0, sizeof(FONDO));
  bool cambio = true;
  while (cambio) {
    cambio = false;
    for (int y = 0; y < ROBOT_H; y++) {
      for (int x = 0; x < ROBOT_W; x++) {
        int i = y * ROBOT_W + x;
        if (FONDO[i]) continue;
        if (!esOscuro(pgm_read_word(&ROBOT[i]))) continue;
        bool borde = (x == 0 || y == 0 || x == ROBOT_W - 1 || y == ROBOT_H - 1);
        if (borde ||
            (x > 0 && FONDO[i - 1]) || (x < ROBOT_W - 1 && FONDO[i + 1]) ||
            (y > 0 && FONDO[i - ROBOT_W]) || (y < ROBOT_H - 1 && FONDO[i + ROBOT_W])) {
          FONDO[i] = 1;
          cambio = true;
        }
      }
    }
  }
}

// Dibuja solo las primeras 'filas' del robot (de arriba hacia abajo).
// 'yAbajo' es la coordenada donde termina la última fila dibujada.
void dibujarRobot(int cx, int yAbajo, int filas) {
  int x0 = cx - ROBOT_W / 2;
  int y0 = yAbajo - filas;
  tft.startWrite();
  for (int y = 0; y < filas; y++) {
    int py = y0 + y;
    if (py < 0 || py >= 240) continue;
    for (int x = 0; x < ROBOT_W; x++) {
      int i = y * ROBOT_W + x;
      if (FONDO[i]) continue;
      tft.writePixel(x0 + x, py, pgm_read_word(&ROBOT[i]));
    }
  }
  tft.endWrite();
}

// =====================================================================
//  HALO RGB pegado al borde de la pantalla, difuminado hacia adentro
// =====================================================================
#define HALO_PROF        40     // profundidad del difuminado en px (mas = mas ancho y suave)
#define HALO_PICO        175    // brillo maximo en el borde (0..255; menos = menos solido)
#define HALO_CAIDA       5.0f   // rapidez con que se desvanece hacia adentro (menos = mas largo)
#define MS_POR_PASO_RGB  12     // más pequeño = el arcoíris gira más rápido (12 ms/paso -> ~3 s por vuelta)
#define MS_ENCENDIDO     900    // tiempo en que el halo se enciende de los bordes hacia adentro
#define MS_ENTRADA_LOGO  450    // tiempo que tarda el logo en cruzar de derecha a izquierda

const float R_OUT = 120.5f;
const float R_IN  = R_OUT - HALO_PROF;

#define MAX_ANILLO 26500
// Se reservan en el heap solo durante el arranque y se liberan despues (ver liberarAnillo)
static uint8_t *aBase = nullptr;     // brillo base (difuminado: maximo en el borde, 0 adentro)
static uint8_t *aProf = nullptr;     // profundidad: 0 = borde, 255 = parte más interna
static uint8_t *aTono = nullptr;     // tono (0..255) según el ángulo
static uint16_t filaIni[240];        // índice del primer píxel del anillo en cada fila
static int16_t  xi0[240], xi1[240];  // tramo izquierdo  [xi0, xi1)
static int16_t  xd0[240], xd1[240];  // tramo derecho    [xd0, xd1)
static uint8_t  PAL[256][3];         // rueda de colores RGB

void tonoRGB(uint8_t h, uint8_t &r, uint8_t &g, uint8_t &b) {
  uint8_t region = h / 43;
  uint8_t rem = (h - region * 43) * 6;
  uint8_t q = 255 - rem, t = rem;
  switch (region) {
    case 0:  r = 255; g = t;   b = 0;   break;
    case 1:  r = q;   g = 255; b = 0;   break;
    case 2:  r = 0;   g = 255; b = t;   break;
    case 3:  r = 0;   g = q;   b = 255; break;
    case 4:  r = t;   g = 0;   b = 255; break;
    default: r = 255; g = 0;   b = q;   break;
  }
}

void liberarAnillo() {
  free(aBase); free(aProf); free(aTono);
  aBase = aProf = aTono = nullptr;
}

// Calcula una sola vez qué píxeles forman el halo y su brillo/tono
void prepararAnillo() {
  aBase = (uint8_t*)malloc(MAX_ANILLO);
  aProf = (uint8_t*)malloc(MAX_ANILLO);
  aTono = (uint8_t*)malloc(MAX_ANILLO);
  if (!aBase || !aProf || !aTono) { liberarAnillo(); return; }   // sin memoria: arranca sin halo
  for (int i = 0; i < 256; i++) tonoRGB(i, PAL[i][0], PAL[i][1], PAL[i][2]);
  int n = 0;
  for (int y = 0; y < 240; y++) {
    filaIni[y] = n;
    xi0[y] = xi1[y] = xd0[y] = xd1[y] = 0;
    int fase = 0;   // 0 antes, 1 en tramo izq, 2 entre tramos, 3 en tramo der, 4 fin
    for (int x = 0; x < 240; x++) {
      float dx = x - 119.5f, dy = y - 119.5f;
      float r = sqrtf(dx * dx + dy * dy);
      bool en = (r >= R_IN && r <= R_OUT) && (n < MAX_ANILLO);
      if (en) {
        if (fase == 0)      { fase = 1; xi0[y] = x; }
        else if (fase == 2) { fase = 3; xd0[y] = x; }
        float d = (R_OUT - r) / HALO_PROF;          // 0 borde ... 1 interior
        if (d < 0) d = 0;
        if (d > 1) d = 1;
        aProf[n] = (uint8_t)(d * 255);
        aBase[n] = (uint8_t)(HALO_PICO * expf(-d * d * HALO_CAIDA));   // curva gaussiana: desvanecido suave
        float ang = atan2f(dy, dx);                  // -PI..PI
        aTono[n] = (uint8_t)((ang + PI) * (256.0f / (2.0f * PI)));
        n++;
      } else {
        if (fase == 1)      { fase = 2; xi1[y] = x; }
        else if (fase == 3) { fase = 4; xd1[y] = x; }
      }
    }
    if (fase == 1) xi1[y] = 240;
    else if (fase == 3) xd1[y] = 240;
  }
}

// Mezcla el halo encima de un color de base (el robot, o negro).
// intro: 0..510 (0 = apagado, 255 = solo el borde encendido, 510 = todo encendido)
static inline uint16_t mezclarAnillo(uint16_t base, int i, int intro, uint8_t fase) {
  int t = intro - aProf[i];
  if (t <= 0) return base;
  if (t > 255) t = 255;
  int a = (aBase[i] * (t + 1)) >> 8;
  if (a <= 0) return base;
  const uint8_t* c = PAL[(uint8_t)(aTono[i] + fase)];
  int r = (((base >> 11) & 31) * (256 - a)) >> 8;
  int g = (((base >> 5) & 63) * (256 - a)) >> 8;
  int b = ((base & 31) * (256 - a)) >> 8;
  r += (c[0] * a) >> 11;
  g += (c[1] * a) >> 10;
  b += (c[2] * a) >> 11;
  if (r > 31) r = 31;
  if (g > 63) g = 63;
  if (b > 31) b = 31;
  return (r << 11) | (g << 5) | b;
}

static inline uint16_t colorAnillo(int i, int intro, uint8_t fase) {
  return mezclarAnillo(0, i, intro, fase);
}

static inline uint8_t faseRGB() { return (uint8_t)(millis() / MS_POR_PASO_RGB); }

static uint16_t bufFila[240];

// Dibuja un cuadro completo: robot asomando abajo (opcional) + halo por encima + logo VEX (opcional).
// Cada píxel se escribe una sola vez, así no hay parpadeo ni rastros.
void dibujarFrame(int intro, int logoX, bool conLogo, bool conRobot, uint8_t fase) {
  const int logoY = (240 - VEXIMG_H) / 2;
  const int ROBOT_FILAS = 40;                 // mitad superior del robot
  const int robotY0 = 240 - ROBOT_FILAS;      // asoma desde abajo, centrado (x = 120)
  const int robotX0 = 120 - ROBOT_W / 2;
  tft.startWrite();
  for (int y = 0; y < 240; y++) {
    bool hayLogo  = conLogo  && y >= logoY && y < logoY + VEXIMG_H;
    bool hayRobot = conRobot && y >= robotY0;
    int n = filaIni[y];

    if (!hayLogo && !hayRobot) {
      // solo los tramos del halo
      if (xi1[y] > xi0[y]) {
        int w = xi1[y] - xi0[y];
        for (int k = 0; k < w; k++) bufFila[k] = colorAnillo(n++, intro, fase);
        tft.setAddrWindow(xi0[y], y, w, 1);
        tft.writePixels(bufFila, w);
      }
      if (xd1[y] > xd0[y]) {
        int w = xd1[y] - xd0[y];
        for (int k = 0; k < w; k++) bufFila[k] = colorAnillo(n++, intro, fase);
        tft.setAddrWindow(xd0[y], y, w, 1);
        tft.writePixels(bufFila, w);
      }
      continue;
    }

    // fila con robot y/o logo: se compone entera y se envía de una vez
    memset(bufFila, 0, sizeof(bufFila));
    if (hayRobot) {
      int ry = y - robotY0;
      for (int rx = 0; rx < ROBOT_W; rx++) {
        int i = ry * ROBOT_W + rx;
        if (!FONDO[i]) bufFila[robotX0 + rx] = pgm_read_word(&ROBOT[i]);
      }
    }
    for (int x = xi0[y]; x < xi1[y]; x++) bufFila[x] = mezclarAnillo(bufFila[x], n++, intro, fase);
    for (int x = xd0[y]; x < xd1[y]; x++) bufFila[x] = mezclarAnillo(bufFila[x], n++, intro, fase);
    if (hayLogo) {
      int ly = y - logoY;
      for (int lx = 0; lx < VEXIMG_W; lx++) {
        int x = logoX + lx;
        if (x < 0 || x >= 240) continue;
        uint16_t c = pgm_read_word(&VEXIMG[ly * VEXIMG_W + lx]);
        if (c) bufFila[x] = c;
      }
    }
    tft.setAddrWindow(0, y, 240, 1);
    tft.writePixels(bufFila, 240);
  }
  tft.endWrite();
}

// ---------- Texto normal centrado ----------
void textoCentrado(const char* txt, int y, int tam, uint16_t color) {
  int16_t x1, y1; uint16_t w, h;
  tft.setTextSize(tam);
  tft.getTextBounds(txt, 0, 0, &x1, &y1, &w, &h);
  tft.setCursor((240 - w) / 2 - x1, y);
  tft.setTextColor(color);
  tft.print(txt);
}

// Logo Arduino pequeño + texto "ARDUINO" a su lado, centrado
void marcaArduino(int y) {
  const char* txt = "ARDUINO";
  int16_t x1, y1; uint16_t w, h;
  tft.setTextSize(2);
  tft.getTextBounds(txt, 0, 0, &x1, &y1, &w, &h);
  int gap   = 6;
  int total = LOGO_W + gap + w;
  int x0    = (240 - total) / 2;
  tft.drawRGBBitmap(x0, y, LOGO, LOGO_W, LOGO_H);
  tft.setCursor(x0 + LOGO_W + gap - x1, y + (LOGO_H - h) / 2 - y1);
  tft.setTextColor(TEAL);
  tft.print(txt);
}

// ---------- Animación 1: arranque ----------
void pantallaArranque() {
  const int logoX = (240 - VEXIMG_W) / 2;
  const int logoY = 58;              // el logo ocupa de y=58 a y=147
  const int ROBOT_X = 150;           // usa 120 para centrarlo en la pantalla
  tft.fillScreen(GC9A01A_BLACK);
  // el robot asoma por detrás de la parte de arriba del logo (42 filas visibles)
  dibujarRobot(ROBOT_X, logoY + 12, 42);
  aparecerVEX(logoX, logoY);
  textoCentrado("powered by", 168, 1, 0x8410);
  marcaArduino(184);
  delay(VEX_PANTALLA_MS);
}

// ---------- Animación 2: halo RGB en el borde + robot asomando abajo + logo entrando de derecha a izquierda ----------
const int VEX_X_FINAL = (240 - VEXIMG_W) / 2;

void animacionLogo() {
  tft.fillScreen(GC9A01A_BLACK);

  // 1) El halo se enciende desde el borde hacia adentro (sin dar la vuelta)
  uint32_t t0 = millis();
  for (;;) {
    uint32_t dt = millis() - t0;
    if (dt >= MS_ENCENDIDO) break;
    dibujarFrame((int)(dt * 510UL / MS_ENCENDIDO), 0, false, false, faseRGB());
  }

  // 2) Aparece el robot asomando desde abajo (el halo pasa por encima) y el logo
  //    cruza de derecha a izquierda (rápido al inicio, frena al llegar)
  t0 = millis();
  for (;;) {
    uint32_t dt = millis() - t0;
    if (dt >= MS_ENTRADA_LOGO) break;
    float p = (float)dt / MS_ENTRADA_LOGO;
    float e = 1.0f - (1.0f - p) * (1.0f - p) * (1.0f - p);   // ease-out cúbico
    int x = 240 + (int)((VEX_X_FINAL - 240) * e);
    dibujarFrame(510, x, true, true, faseRGB());
  }
  dibujarFrame(510, VEX_X_FINAL, true, true, faseRGB());
}

