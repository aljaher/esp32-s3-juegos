// =====================================================================
//  DINO RUN  (el del dinosaurio de Chrome, pero a colores y con dia/noche)
//  Controles: ARRIBA saltar (mantener = salto mas alto), ABAJO agacharse /
//             caer rapido, OK pausa
//  Dibuja una franja de 240x120 en memoria y la manda de una vez (sin parpadeo)
// =====================================================================


namespace dino {

const int BANDA_Y = 60, BANDA_H = 120;     // franja de pantalla donde ocurre la accion
const int SUELO   = 92;                    // y del suelo dentro de la franja
const int DINO_X  = 34;
const int ANCHO_D = 24, ALTO_D = 26, ANCHO_AG = 28, ALTO_AG = 14;

const uint16_t CIELO_D0 = C565(120, 200, 255), CIELO_N0 = C565(12, 14, 48);
const uint16_t LEJ_D0   = C565(170, 222, 175), LEJ_N0   = C565(30, 38, 82);
const uint16_t CERC_D0  = C565(105, 200, 120), CERC_N0  = C565(20, 58, 72);
const uint16_t SUE_D0   = C565(228, 192, 124), SUE_N0   = C565(72, 60, 50);
const uint16_t LIN_D0   = C565(140, 98, 48),  LIN_N0   = C565(30, 24, 20);
const uint16_t NUBE_D0  = C565(255, 255, 255), NUBE_N0  = C565(74, 84, 126);
const uint16_t C_DINO0  = C565(80, 205, 90),  C_DINO_S0 = C565(40, 140, 60), C_PANZA0 = C565(165, 240, 130);
const uint16_t C_CACTO0 = C565(30, 160, 70),  C_CACTO_S0 = C565(15, 105, 45);
const uint16_t C_AVE0   = C565(170, 80, 220), C_AVE_S0 = C565(105, 40, 160), C_PICO0 = C565(255, 170, 30);
const uint16_t ACENTO0  = C565(80, 205, 90);
// colores en uso (originales + skin elegida)
uint16_t CIELO_D, CIELO_N, LEJ_D, LEJ_N, CERC_D, CERC_N, SUE_D, SUE_N, LIN_D, LIN_N, NUBE_D, NUBE_N;
uint16_t C_DINO, C_DINO_S, C_PANZA, C_CACTO, C_CACTO_S, C_AVE, C_AVE_S, C_PICO, ACENTO;
void aplicarSkin() {
  CIELO_D = skinTinte(CIELO_D0); CIELO_N = skinTinte(CIELO_N0);
  LEJ_D = skinTinte(LEJ_D0);     LEJ_N = skinTinte(LEJ_N0);
  CERC_D = skinTinte(CERC_D0);   CERC_N = skinTinte(CERC_N0);
  SUE_D = skinTinte(SUE_D0);     SUE_N = skinTinte(SUE_N0);
  LIN_D = skinTinte(LIN_D0);     LIN_N = skinTinte(LIN_N0);
  NUBE_D = skinTinte(NUBE_D0);   NUBE_N = skinTinte(NUBE_N0);
  C_DINO = skinTinte(C_DINO0);   C_DINO_S = skinTinte(C_DINO_S0); C_PANZA = skinTinte(C_PANZA0);
  C_CACTO = skinTinte(C_CACTO0); C_CACTO_S = skinTinte(C_CACTO_S0);
  C_AVE = skinTinte(C_AVE0);     C_AVE_S = skinTinte(C_AVE_S0);   C_PICO = skinTinte(C_PICO0);
  ACENTO = skinTinte(ACENTO0);
}

struct Obs { float x; uint8_t tipo; int16_t w, h, alt; bool on; };
struct Nube { float x; int16_t y; };
struct Mota { float x; uint8_t y, w; };

GFXcanvas16* cv = nullptr;
Obs   obs[4];
Nube  nubes[3];
Mota  motas[18];
float altura, vh, vel, dist, off1, off2, proxGap, desdeUlt;
uint8_t dn;                 // 0 = dia, 255 = noche
uint32_t puntos, record, pPuntos, pRecord;
int   fAnim;
bool  agachado, enSuelo, muerto, esperando;

const Note SND_SALTO[]  = {{500, 25}, {800, 35}};
const Note SND_HITO[]   = {{988, 60}, {0, 40}, {988, 60}, {1319, 120}};
const Note SND_MUERTE[] = {{400, 80}, {300, 80}, {200, 80}, {120, 200}};

uint16_t col(uint16_t d, uint16_t n) { return mezclar565(d, n, dn); }

// ---------------------------------------------------------------- dibujo en el lienzo
void dibujarNube(int x, int y, uint16_t c) {
  cv->fillRoundRect(x, y + 5, 28, 7, 3, c);
  cv->fillCircle(x + 9, y + 5, 5, c);
  cv->fillCircle(x + 17, y + 4, 6, c);
}

void dibujarCacto(int x, int yb, int h, uint16_t c, uint16_t s) {
  int tw = h > 24 ? 8 : 6;
  int tx = x + 4;
  cv->fillRect(tx, yb - h, tw, h, c);
  cv->fillRect(tx + 1, yb - h - 1, tw - 2, 1, c);
  cv->fillRect(tx + tw - 2, yb - h + 2, 2, h - 3, s);          // sombra del tronco
  int a1 = yb - (h * 55) / 100;                                 // brazo izquierdo
  cv->fillRect(x, a1, 5, 3, c);
  cv->fillRect(x, a1 - (h > 24 ? 9 : 6), 3, (h > 24 ? 9 : 6) + 3, c);
  cv->fillRect(x + 1, a1 - (h > 24 ? 9 : 6) - 1, 1, 1, c);
  int a2 = yb - (h * 40) / 100;                                 // brazo derecho
  cv->fillRect(tx + tw - 1, a2, 5, 3, c);
  cv->fillRect(tx + tw + 2, a2 - (h > 24 ? 8 : 5), 3, (h > 24 ? 8 : 5) + 3, c);
  cv->fillRect(tx + tw + 3, a2 - (h > 24 ? 8 : 5) - 1, 1, 1, c);
  cv->drawPixel(tx + 2, yb - h + 4, BLANCO);                    // espinas
  cv->drawPixel(tx + 3, yb - h / 2, BLANCO);
  cv->drawPixel(tx + 1, yb - 5, BLANCO);
}

void dibujarAve(int x, int y, int frame) {          // x,y = esquina superior izquierda (22x14)
  cv->fillRect(x + 4, y + 5, 13, 5, C_AVE);        // cuerpo
  cv->fillRect(x + 14, y + 3, 6, 5, C_AVE);        // cabeza
  cv->fillRect(x + 19, y + 5, 3, 2, C_PICO);       // pico
  cv->drawPixel(x + 17, y + 4, BLANCO);
  cv->fillRect(x, y + 6, 5, 2, C_AVE_S);           // cola
  cv->fillRect(x + 4, y + 9, 12, 1, C_AVE_S);
  if (frame) {                                      // alas arriba
    cv->fillTriangle(x + 6, y + 5, x + 14, y + 5, x + 9, y - 1, C_AVE_S);
    cv->fillTriangle(x + 8, y + 5, x + 13, y + 5, x + 12, y - 1, C_AVE);
  } else {                                          // alas abajo
    cv->fillTriangle(x + 6, y + 10, x + 14, y + 10, x + 9, y + 15, C_AVE_S);
    cv->fillTriangle(x + 8, y + 10, x + 13, y + 10, x + 12, y + 15, C_AVE);
  }
}

// yPies = coordenada del suelo bajo los pies
void dibujarDino(int x, int yPies, bool ag, int frame, bool muertoD) {
  uint16_t c = C_DINO, s = C_DINO_S;
  if (!ag) {
    int y = yPies - ALTO_D;
    cv->fillRect(x + 11, y, 13, 11, c);             // cabeza
    cv->fillRect(x + 22, y + 1, 2, 2, c);
    cv->fillRect(x + 10, y + 1, 1, 8, c);
    cv->fillRect(x + 17, y + 8, 7, 3, s);           // boca
    cv->fillRect(x + 17, y + 9, 5, 1, NEGRO);
    if (muertoD) { cv->drawLine(x + 15, y + 2, x + 18, y + 5, NEGRO); cv->drawLine(x + 18, y + 2, x + 15, y + 5, NEGRO); }
    else { cv->fillRect(x + 15, y + 2, 4, 4, BLANCO); cv->fillRect(x + 17, y + 3, 2, 2, NEGRO); }
    cv->fillRect(x + 9, y + 11, 10, 5, c);          // cuello
    cv->fillRect(x + 4, y + 15, 15, 7, c);          // cuerpo
    cv->fillRect(x + 2, y + 13, 7, 6, c);           // lomo
    cv->fillRect(x + 8, y + 18, 9, 4, C_PANZA);     // panza
    cv->fillRect(x + 0, y + 14, 4, 4, c);           // cola
    cv->fillRect(x + 0, y + 17, 2, 2, s);
    cv->fillRect(x + 2, y + 18, 3, 3, c);
    cv->fillRect(x + 17, y + 16, 5, 2, c);          // bracito
    cv->fillRect(x + 20, y + 17, 2, 1, s);
    cv->fillRect(x + 4, y + 20, 15, 2, s);          // sombra bajo el cuerpo
    int l1 = 4, l2 = 4;                             // piernas (una sube y otra baja al correr)
    if (!muertoD && yPies >= SUELO) { if (frame) l1 = 1; else l2 = 1; }
    cv->fillRect(x + 6, yPies - l1, 4, l1, c);
    cv->fillRect(x + 6, yPies - 1, 6, 1, s);
    cv->fillRect(x + 14, yPies - l2, 4, l2, c);
    cv->fillRect(x + 14, yPies - 1, 6, 1, s);
  } else {
    int y = yPies - ALTO_AG;
    cv->fillRect(x + 4, y + 4, 18, 7, c);           // cuerpo largo
    cv->fillRect(x + 6, y + 9, 12, 2, C_PANZA);
    cv->fillRect(x + 0, y + 5, 5, 4, c);            // cola
    cv->fillRect(x + 17, y + 0, 11, 8, c);          // cabeza
    cv->fillRect(x + 24, y + 5, 4, 3, s);           // boca
    cv->fillRect(x + 21, y + 1, 3, 3, BLANCO);
    cv->fillRect(x + 22, y + 2, 2, 2, NEGRO);
    int l1 = 3, l2 = 3;
    if (frame) l1 = 1; else l2 = 1;
    cv->fillRect(x + 7, yPies - l1, 4, l1, c);
    cv->fillRect(x + 15, yPies - l2, 4, l2, c);
  }
}

void dibujarObs(const Obs& o) {
  int x = (int)o.x;
  if (o.tipo == 5) {
    dibujarAve(x, SUELO - o.alt - o.h, (fAnim >> 2) & 1);
    return;
  }
  int n = (o.w + 2) / 14;                             // cuantos troncos
  int h = o.h;
  for (int i = 0; i < n; i++) dibujarCacto(x + i * 14, SUELO + 1, h - (i == 1 && n == 3 ? 4 : 0), C_CACTO, C_CACTO_S);
}

void componer() {
  uint16_t cielo = col(CIELO_D, CIELO_N);
  cv->fillScreen(cielo);
  // estrellas de noche
  if (dn > 70) {
    uint16_t es = mezclar565(cielo, BLANCO, dn - 40);
    static const uint8_t ex[10] = {14, 40, 66, 92, 118, 150, 176, 204, 226, 80};
    static const uint8_t ey[10] = {10, 30, 6, 22, 40, 12, 34, 8, 26, 50};
    for (int i = 0; i < 10; i++) { cv->drawPixel(ex[i], ey[i], es); if (i & 1) cv->drawPixel(ex[i] + 1, ey[i], es); }
  }
  // sol / luna
  if (dn < 128) {
    cv->fillCircle(190, 24, 12, mezclar565(cielo, C565(255, 240, 150), 120));
    cv->fillCircle(190, 24, 9, C565(255, 215, 40));
  } else {
    cv->fillCircle(190, 24, 9, C565(236, 236, 205));
    cv->fillCircle(194, 21, 8, cielo);
  }
  // nubes
  uint16_t cn = col(NUBE_D, NUBE_N);
  for (int i = 0; i < 3; i++) dibujarNube((int)nubes[i].x, nubes[i].y, cn);
  // colinas lejanas y cercanas (parallax)
  uint16_t cl = col(LEJ_D, LEJ_N), cc = col(CERC_D, CERC_N);
  for (int x = 0; x < 240; x++) {
    int h1 = 18 + (int)(11.0f * sinf((x + off1) * 0.045f) + 5.0f * sinf((x + off1) * 0.11f));
    cv->drawFastVLine(x, SUELO - h1, h1, cl);
  }
  for (int x = 0; x < 240; x++) {
    int h2 = 8 + (int)(6.0f * sinf((x + off2) * 0.08f + 1.3f));
    cv->drawFastVLine(x, SUELO - h2, h2, cc);
  }
  // suelo
  uint16_t su = col(SUE_D, SUE_N), li = col(LIN_D, LIN_N);
  cv->fillRect(0, SUELO, 240, BANDA_H - SUELO, su);
  cv->fillRect(0, SUELO, 240, 2, li);
  for (int i = 0; i < 18; i++) cv->fillRect((int)motas[i].x, SUELO + motas[i].y, motas[i].w, 1, li);
  // obstaculos y dino
  for (int i = 0; i < 4; i++) if (obs[i].on) dibujarObs(obs[i]);
  int yPies = SUELO + 1 - (int)altura;
  dibujarDino(DINO_X, yPies, agachado && enSuelo, (fAnim >> 2) & 1, muerto);
}

// colores de las zonas fuera de la franja
void fondoExterior() {
  tft.fillRect(0, 0, 240, BANDA_Y, col(CIELO_D, CIELO_N));
  tft.fillRect(0, BANDA_Y + BANDA_H, 240, 240 - BANDA_Y - BANDA_H, col(SUE_D, SUE_N));
}

void hud(bool todo) {
  uint16_t fondo = col(CIELO_D, CIELO_N);
  uint16_t tx = mezclar565(C565(50, 60, 70), BLANCO, dn);
  if (todo || pPuntos != puntos || pRecord != record) {
    char b[16];
    tft.fillRect(60, 30, 120, 28, fondo);
    snprintf(b, sizeof(b), "%05lu", (unsigned long)puntos);
    printC(b, 32, 2, tx);
    snprintf(b, sizeof(b), "HI %05lu", (unsigned long)record);
    printC(b, 50, 1, tx);
    pPuntos = puntos; pRecord = record;
  }
}

// ---------------------------------------------------------------- logica
void nuevaObs() {
  int i = 0;
  while (i < 4 && obs[i].on) i++;
  if (i >= 4) return;
  Obs& o = obs[i];
  o.on = true; o.x = 246; o.alt = 0;
  int r = random(100);
  if (puntos > 200 && r < 24) {                   // pajaro
    o.tipo = 5; o.w = 22; o.h = 14;
    static const int16_t alts[3] = {2, 16, 34};
    o.alt = alts[random(3)];
  } else {
    int t = (puntos < 120) ? random(3) : random(5);
    o.tipo = t;
    static const int16_t ws[5] = {10, 12, 26, 40, 28};
    static const int16_t hs[5] = {20, 30, 20, 20, 30};
    o.w = ws[t]; o.h = hs[t];
    if (t == 1) o.w = 14;
  }
}

bool choque() {
  int dx0, dy0, dx1, dy1;
  int yPies = SUELO + 1 - (int)altura;
  if (agachado && enSuelo) { dx0 = DINO_X + 3; dx1 = DINO_X + 26; dy0 = yPies - ALTO_AG + 4; dy1 = yPies - 1; }
  else { dx0 = DINO_X + 5; dx1 = DINO_X + 22; dy0 = yPies - ALTO_D + 2; dy1 = yPies - 2; }
  for (int i = 0; i < 4; i++) {
    if (!obs[i].on) continue;
    int ox0, ox1, oy0, oy1;
    if (obs[i].tipo == 5) {
      ox0 = (int)obs[i].x + 3; ox1 = (int)obs[i].x + obs[i].w - 3;
      oy1 = SUELO - obs[i].alt - 2; oy0 = SUELO - obs[i].alt - obs[i].h + 3;
    } else {
      ox0 = (int)obs[i].x + 3; ox1 = (int)obs[i].x + obs[i].w - 3;
      oy1 = SUELO; oy0 = SUELO - obs[i].h + 3;
    }
    if (dx1 > ox0 && dx0 < ox1 && dy1 > oy0 && dy0 < oy1) return true;
  }
  return false;
}

void reiniciar() {
  altura = 0; vh = 0; vel = 4.6f * DIF_VEL[diffIdx]; dist = 0; off1 = 0; off2 = 0; desdeUlt = 0; proxGap = 150;
  dn = 0; puntos = 0; fAnim = 0; agachado = false; enSuelo = true; muerto = false; esperando = true;
  for (int i = 0; i < 4; i++) obs[i].on = false;
  for (int i = 0; i < 3; i++) { nubes[i].x = 30 + i * 85; nubes[i].y = 6 + random(30); }
  for (int i = 0; i < 18; i++) { motas[i].x = random(240); motas[i].y = 4 + random(22); motas[i].w = 1 + random(3); }
  pPuntos = 0xFFFFFFFF; pRecord = 0xFFFFFFFF;
}

// Una partida. Devuelve true si perdio, false si salio por la pausa.
bool partida() {
  randomSeed(micros());
  reiniciar();
  fondoExterior();
  componer(); empujarLienzo(cv, 0, BANDA_Y);
  hud(true);
  printC("ARRIBA: SALTAR", 192, 1, BLANCO);
  printC("ABAJO: AGACHAR", 206, 1, BLANCO);
  clearPresses();
  uint32_t ultimo = 0;
  bool noche = false;
  uint8_t cuentaFondo = 0;

  for (;;) {
    uint32_t now = millis();
    updateSound(now);
    readButtons(now);
    if (now - ultimo < FRAME_MS) { delay(1); continue; }
    ultimo = now;

    if (btnPress[B_OK]) {
      clearPresses();
      if (menuPausa(ACENTO)) return false;
      fondoExterior(); hud(true);
      if (esperando) { printC("ARRIBA: SALTAR", 192, 1, BLANCO); printC("ABAJO: AGACHAR", 206, 1, BLANCO); }
      componer(); empujarLienzo(cv, 0, BANDA_Y);
      continue;
    }

    if (esperando) {
      if (btnPress[B_UP]) {
        esperando = false;
        tft.fillRect(60, 186, 120, 30, col(SUE_D, SUE_N));
      } else { clearPresses(); continue; }
    }

    // ---- entrada
    agachado = btnHeld[B_DOWN];
    if (enSuelo && btnPress[B_UP] ) {
      vh = 9.8f; enSuelo = false;
      playSeq(SND_SALTO, NN(SND_SALTO), 1);
    }
    if (!enSuelo) {
      if (!btnHeld[B_UP] && vh > 3.6f) vh = 3.6f;      // soltar = salto corto
      vh -= agachado ? 2.6f : 0.92f;
      altura += vh;
      if (altura <= 0) { altura = 0; vh = 0; enSuelo = true; }
    }

    // ---- mundo
    vel = (4.6f + (float)puntos * 0.0045f) * DIF_VEL[diffIdx]; if (vel > 10.5f * DIF_VEL[diffIdx]) vel = 10.5f * DIF_VEL[diffIdx];
    dist += vel;
    puntos = (uint32_t)(dist / 11.0f);
    off1 += vel * 0.22f; off2 += vel * 0.55f;
    fAnim++;
    for (int i = 0; i < 3; i++) { nubes[i].x -= vel * 0.12f; if (nubes[i].x < -34) { nubes[i].x = 244; nubes[i].y = 6 + random(30); } }
    for (int i = 0; i < 18; i++) { motas[i].x -= vel; if (motas[i].x < -4) { motas[i].x = 242 + random(20); motas[i].y = 4 + random(22); motas[i].w = 1 + random(3); } }
    for (int i = 0; i < 4; i++) if (obs[i].on) { obs[i].x -= vel; if (obs[i].x < -50) obs[i].on = false; }
    desdeUlt += vel;
    if (desdeUlt >= proxGap) { nuevaObs(); desdeUlt = 0; proxGap = vel * (24 + random(18)) + 44; }

    // ---- dia / noche
    noche = ((puntos / 350) & 1) == 1;
    if (noche && dn < 255) dn = (dn > 253) ? 255 : dn + 2;
    else if (!noche && dn > 0) dn = (dn < 2) ? 0 : dn - 2;
    if ((dn != 0 && dn != 255) && ((++cuentaFondo) & 3) == 0) { fondoExterior(); hud(true); }

    static uint32_t ultimoHito = 0;
    if (puntos < 5) ultimoHito = 0;
    if (puntos / 100 > ultimoHito) { ultimoHito = puntos / 100; if (puntos >= 100) playSeq(SND_HITO, NN(SND_HITO), 2); }

    // ---- dibujar
    muerto = choque();
    componer();
    empujarLienzo(cv, 0, BANDA_Y);
    hud(false);
    if (muerto) {
      playSeq(SND_MUERTE, NN(SND_MUERTE), 3);
      waitMs(900);
      return true;
    }
    clearPresses();
  }
}

void jugar() {
  for (;;) {
    record = prefsA.getUInt("hiDino", 0);
    if (!menuJuego("DINO RUN", ACENTO0, record, 2)) return;
    aplicarSkin();
    cv = crearLienzo(240, BANDA_H);
    if (!cv) return;
    for (;;) {
      bool perdio = partida();
      if (!perdio) break;
      bool nuevo = puntos > record;
      if (nuevo) { record = puntos; prefsA.putUInt("hiDino", record); }
      if (!pantallaFin(puntos, record, nuevo, ACENTO)) break;
    }
    delete cv; cv = nullptr;
  }
}

