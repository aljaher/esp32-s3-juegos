// ============================== ANIMACION DE ARRANQUE ==============================
void bootAnimation() {
  prepararMascaraRobot();
  prepararAnillo();
  pantallaArranque();          // VEX + powered by ARDUINO
  animacionLogo();             // halo RGB + robot + logo entrando
  // el halo sigue girando un rato (o hasta pulsar OK) y luego pasa al menu
  uint32_t t0 = millis();
  while (millis() - t0 < VEX_HALO_MS && digitalRead(PIN_OK) == HIGH) {
    dibujarFrame(510, VEX_X_FINAL, true, true, faseRGB());
  }
  liberarAnillo();             // el halo ya no se usa: devuelve ~80 KB de RAM al menu de caratulas
}

// ============================== SETUP / LOOP ==============================
void setup() {
  for (int i = 0; i < 5; i++) pinMode(btnPins[i], INPUT_PULLUP);
  soundInit();
  prefs.begin("pacman", false);
  soundOn = prefs.getBool("snd", true);
  skinIdx = prefs.getUChar("skin", 0); if (skinIdx >= NUM_SKINS) skinIdx = 0;
  diffIdx = prefs.getUChar("diff", 1); if (diffIdx > 2) diffIdx = 1;
  hiScore = prefs.getUInt("hi", 0);
  pinMode(RC_SS, OUTPUT);  digitalWrite(RC_SS, HIGH);     // >>> NUEVO: RC522 deseleccionado antes de usar el bus
  pinMode(RC_RST, OUTPUT); digitalWrite(RC_RST, LOW);     // (dormido hasta entrar en AGREGAR)
  SPI.begin(TFT_SCK, RC_MISO, TFT_MOSI, TFT_CS);          // >>> NUEVO: MISO=13 para el RC522 (antes -1)
  tft.begin(40000000);        // si ves basura en pantalla, baja a 24000000 (o usa tft.begin();)
  tft.setRotation(0);
  bootAnimation();
  agm::indexar();              // >>> NUEVO: lee los juegos descargados (la 1a vez formatea LittleFS)
}

void loop() {
  arcadeMenu();      // no vuelve: el menu del arcade lanza los juegos y se queda esperando
}
