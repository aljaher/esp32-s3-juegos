// ===== inicio de motor_snake.h =====
// =====================================================================
//  MOTOR SNAKE: ejecuta los mapas de un .agm de tipo snake.
//  Flechas = girar, OK = pausa (en pausa: OK sigue, IZQ sale)
// =====================================================================
namespace snk {

const int CEL = 12;
const int MAXC = ARC_DIM * ARC_DIM;
uint8_t pared[ARC_DIM][ARC_DIM];
uint8_t ocup[ARC_DIM][ARC_DIM];
uint8_t sx[MAXC], sy[MAXC];
int w, h, ox, oy, cola, cabeza, largo, dir, mx, my;
uint32_t puntos;
uint16_t cAc;

void celda(int c, int r, uint16_t col) {
  tft.fillRect(ox + c * CEL + 1, oy + r * CEL + 1, CEL - 2, CEL - 2, col);
}
void borrarCelda(int c, int r) { tft.fillRect(ox + c * CEL, oy + r * CEL, CEL, CEL, NEGRO); }
void hud(int niv, int comidas, int meta) {
  char b[24];
  tft.fillRect(60, 18, 120, 12, NEGRO);
  snprintf(b, sizeof(b), "PUNTOS %lu", (unsigned long)puntos);
  printC(b, 22, 1, cAc);
  tft.fillRect(60, 204, 120, 12, NEGRO);
  snprintf(b, sizeof(b), "NIV %d  %d/%d", niv + 1, comidas, meta);
  printC(b, 206, 1, BLANCO);
}
void dibujarTodo(int niv, int comidas, int meta) {
  tft.fillScreen(NEGRO);
  for (int r = 0; r < h; r++) for (int c = 0; c < w; c++)
    if (pared[r][c]) {
      tft.fillRect(ox + c * CEL, oy + r * CEL, CEL, CEL, SK.wallFill);
      tft.drawRect(ox + c * CEL, oy + r * CEL, CEL, CEL, SK.wallLine);
    }
  for (int i = 0, k = cola; i < largo; i++, k = (k + 1) % MAXC)
    celda(sx[k], sy[k], (i == largo - 1) ? aclarar(cAc) : cAc);
  if (mx >= 0) tft.fillCircle(ox + mx * CEL + 6, oy + my * CEL + 6, 4, C_RED);
  hud(niv, comidas, meta);
}
bool libre(int c, int r) { return c >= 0 && r >= 0 && c < w && r < h && !pared[r][c] && !ocup[r][c]; }
bool nuevaManzana() {
  int libres = 0;
  for (int r = 0; r < h; r++) for (int c = 0; c < w; c++) if (libre(c, r)) libres++;
  if (!libres) { mx = -1; return false; }
  int k = random(libres);
  for (int r = 0; r < h; r++) for (int c = 0; c < w; c++)
    if (libre(c, r) && k-- == 0) { mx = c; my = r; return true; }
  return false;
}
bool cargar(const char* b, int k) {
  static char f[ARC_DIM][ARC_DIM + 1];
  if (!agm::nivel(b, k, f, &w, &h)) return false;
  int hx = 0, hy = 0;
  memset(ocup, 0, sizeof(ocup));
  for (int r = 0; r < h; r++) for (int c = 0; c < w; c++) {
    pared[r][c] = (f[r][c] == '#');
    if (f[r][c] == 'S') { hx = c; hy = r; }
  }
  ox = (240 - w * CEL) / 2;
  oy = (240 - h * CEL) / 2;
  // direccion inicial: 0 arriba, 1 abajo, 2 izq, 3 der; busca una con 2 celdas libres detras
  int mejor = -1;
  for (int d = 3; d >= 0 && mejor < 0; d--) {
    int dx = BDX[d], dy = BDY[d];
    int ax = hx + dx, ay = hy + dy;
    if (ax < 0 || ay < 0 || ax >= w || ay >= h || pared[ay][ax]) continue;
    int b1x = hx - dx, b1y = hy - dy, b2x = hx - 2 * dx, b2y = hy - 2 * dy;
    bool ok1 = b1x >= 0 && b1y >= 0 && b1x < w && b1y < h && !pared[b1y][b1x];
    bool ok2 = b2x >= 0 && b2y >= 0 && b2x < w && b2y < h && !pared[b2y][b2x];
    if (ok1 && ok2) mejor = d;
  }
  if (mejor < 0) {                                    // sin espacio detras: empieza con largo 1
    for (int d = 3; d >= 0 && mejor < 0; d--) {
      int ax = hx + BDX[d], ay = hy + BDY[d];
      if (ax >= 0 && ay >= 0 && ax < w && ay < h && !pared[ay][ax]) mejor = d;
    }
    if (mejor < 0) return false;
    dir = mejor; largo = 1; cola = 0; cabeza = 0;
    sx[0] = hx; sy[0] = hy; ocup[hy][hx] = 1;
  } else {
    dir = mejor;
    int dx = BDX[dir], dy = BDY[dir];
    largo = 3; cola = 0; cabeza = 2;
    sx[0] = hx - 2 * dx; sy[0] = hy - 2 * dy;
    sx[1] = hx - dx;     sy[1] = hy - dy;
    sx[2] = hx;          sy[2] = hy;
    for (int i = 0; i < 3; i++) ocup[sy[i]][sx[i]] = 1;
  }
  nuevaManzana();
  return true;
}

// Devuelve true si el jugador perdio, false si salio con la pausa
bool partida(const char* b, int total, uint16_t ac) {
  cAc = skinTinte(ac);
  int velBase = agm::valorInt(b, "vel", 150);
  int meta = agm::valorInt(b, "meta", 8);
  puntos = 0;
  int niv = 0, vuelta = 0;
  for (;;) {
    int k = niv % total;
    if (!cargar(b, k)) return false;
    int comidas = 0;
    float paso = velBase * DIF_PCT[diffIdx] / 100.0f;
    for (int i = 0; i < vuelta; i++) paso *= 0.9f;
    if (paso < 50) paso = 50;
    dibujarTodo(niv, comidas, meta);
    clearPresses();
    int pend = dir;
    uint32_t tPaso = millis() + 400;
    for (;;) {
      uint32_t now = millis();
      updateSound(now);
      readButtons(now);
      for (int d = 0; d < 4; d++)
        if (btnPress[d] && !(BDX[d] == -BDX[dir] && BDY[d] == -BDY[dir])) pend = d;
      if (btnPress[B_OK]) {
        if (menuPausa(ac)) return false;
        dibujarTodo(niv, comidas, meta);
        tPaso = millis() + 300;
      }
      clearPresses();
      if ((int32_t)(now - tPaso) < 0) { delay(1); continue; }
      tPaso = now + (uint32_t)paso;
      dir = pend;
      int hx = sx[cabeza], hy = sy[cabeza];
      int nx = hx + BDX[dir], ny = hy + BDY[dir];
      bool come = (nx == mx && ny == my);
      int colaX = sx[cola], colaY = sy[cola];
      bool choque = (nx < 0 || ny < 0 || nx >= w || ny >= h || pared[ny][nx] ||
                     (ocup[ny][nx] && !(nx == colaX && ny == colaY && !come)));
      if (choque) {
        playSeq(SND_DEATH, NN(SND_DEATH), 3);
        for (int i = 0, kk = cola; i < largo; i++, kk = (kk + 1) % MAXC) celda(sx[kk], sy[kk], C_RED);
        esperar(700);
        return true;
      }
      if (!come) {                                    // la cola avanza
        ocup[colaY][colaX] = 0;
        borrarCelda(colaX, colaY);
        cola = (cola + 1) % MAXC;
        largo--;
      }
      celda(hx, hy, cAc);
      cabeza = (cabeza + 1) % MAXC;
      sx[cabeza] = nx; sy[cabeza] = ny;
      ocup[ny][nx] = 1;
      largo++;
      celda(nx, ny, aclarar(cAc));
      if (come) {
        puntos += 10;
        comidas++;
        playSeq(SND_LIFE, NN(SND_LIFE), 2);
        bool hay = nuevaManzana();
        if (hay) tft.fillCircle(ox + mx * CEL + 6, oy + my * CEL + 6, 4, C_RED);
        hud(niv, comidas, meta);
        if (comidas >= meta || !hay) break;
      }
    }
    puntos += 50;
    playSeq(SND_LEVEL, NN(SND_LEVEL), 3);
    printC("NIVEL SUPERADO!", 104, 1, cAc);
    esperar(1100);
    niv++;
    if (niv % total == 0) vuelta++;                   // al dar la vuelta a todos los niveles, mas rapido
  }
}

