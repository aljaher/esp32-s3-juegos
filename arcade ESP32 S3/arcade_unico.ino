void readButtons(uint32_t now) {
  for (int i = 0; i < 5; i++) {
    bool raw = (digitalRead(btnPins[i]) == LOW);
    if (raw != btnHeld[i] && (now - btnLast[i]) > 15) {
      btnHeld[i] = raw;
      btnLast[i] = now;
      if (raw) btnPress[i] = true;
    }
  }
}
