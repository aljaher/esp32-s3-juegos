// ===== inicio de tetris.h =====
// =====================================================================
//  TETRIS  (tablero 10x20, celdas de 10 px, cabe justo en la pantalla redonda)
//  Controles: IZQ/DER mover, ARRIBA girar, ABAJO bajar rapido, OK pausa
// =====================================================================


namespace tet {

const int BX = 70, BY = 20, CELDA = 10, BW = 10, BH = 20;

// Cada pieza son 4 giros, cada giro un mapa de 4x4 bits (bit 15 = esquina superior izquierda)
const uint16_t PIEZAS[7][4] = {
  {0x0F00, 0x2222, 0x00F0, 0x4444},   // I
  {0x6600, 0x6600, 0x6600, 0x6600},   // O
  {0x4E00, 0x4C40, 0x0E40, 0x4640},   // T
  {0x6C00, 0x4620, 0x06C0, 0x8C40},   // S
  {0xC600, 0x2640, 0x0C60, 0x4C80},   // Z
  {0x8E00, 0x6440, 0x0E20, 0x44C0},   // J
  {0x2E00, 0x4460, 0x0E80, 0xC440},   // L
};
// colores por tipo (indice = tipo + 1; 0 = vacio)
const uint16_t COLORES0[8] = {
  0,
  C565(0, 230, 240),     // I cian
  C565(250, 230, 0),     // O amarillo
  C565(180, 60, 240),    // T morado
  C565(40, 220, 60),     // S verde
  C565(240, 40, 40),     // Z rojo
  C565(50, 90, 255),     // J azul
  C565(255, 150, 0),     // L naranja
};
const uint16_t FONDO0   = C565(0, 0, 20);
const uint16_t REJILLA0 = C565(18, 18, 52);
const uint16_t MARCO0   = C565(120, 120, 200);
const uint16_t ACENTO0  = C565(0, 230, 240);
// colores en uso (originales + skin elegida)
uint16_t COLORES[8], FONDO, REJILLA, MARCO, ACENTO;
void aplicarSkin() {
  for (int i = 0; i < 8; i++) COLORES[i] = i ? skinTinte(COLORES0[i]) : 0;
  FONDO = skinTinte(FONDO0); REJILLA = skinTinte(REJILLA0); MARCO = skinTinte(MARCO0); ACENTO = skinTinte(ACENTO0);
}

uint16_t claro[8], oscuro[8];
uint8_t  tablero[BH][BW];
uint8_t  mostrado[BH][BW];          // lo que hay dibujado ahora (255 = obligar a redibujar)
int      pt, prot, px, py, sig;     // pieza actual (tipo, giro, posicion) y la siguiente
uint8_t  bolsa[7];
int      bolsaIdx;
uint32_t puntos, record;
int      lineas, nivel;
uint32_t pPuntos, pLineas, pNivel;  // ultimo valor dibujado en el panel

const Note SND_MOVER[]  = {{900, 12}};
const Note SND_GIRAR[]  = {{1300, 18}};
const Note SND_CAER[]   = {{300, 35}};
const Note SND_LINEA[]  = {{660, 70}, {880, 70}, {1100, 90}};
const Note SND_TETRIS[] = {{523, 70}, {659, 70}, {784, 70}, {1047, 200}};
const Note SND_NIVEL[]  = {{784, 80}, {988, 80}, {1319, 160}};

// ---------------------------------------------------------------- piezas
bool choca(int t, int r, int x, int y) {
  uint16_t m = PIEZAS[t][r & 3];
  for (int i = 0; i < 16; i++) {
    if (!(m & (0x8000 >> i))) continue;
    int cx = x + (i & 3), cy = y + (i >> 2);
    if (cx < 0 || cx >= BW || cy >= BH) return true;
    if (cy >= 0 && tablero[cy][cx]) return true;
  }
  return false;
}

int piezaDeLaBolsa() {
  if (bolsaIdx >= 7) {
    for (int i = 0; i < 7; i++) bolsa[i] = i;
    for (int i = 6; i > 0; i--) { int j = random(i + 1); uint8_t t = bolsa[i]; bolsa[i] = bolsa[j]; bolsa[j] = t; }
    bolsaIdx = 0;
  }
  return bolsa[bolsaIdx++];
}

// ---------------------------------------------------------------- dibujo
void dibujarCelda(int c, int r, uint8_t v) {
  int x = BX + c * CELDA, y = BY + r * CELDA;
  if (v == 0) {
    tft.fillRect(x, y, CELDA, CELDA, FONDO);
    tft.drawRect(x, y, CELDA, CELDA, REJILLA);
  } else if (v >= 16) {                       // sombra de donde va a caer
    uint8_t k = v - 16;
    tft.fillRect(x, y, CELDA, CELDA, FONDO);
    tft.drawRect(x, y, CELDA, CELDA, oscuro[k]);
    tft.drawRect(x + 1, y + 1, CELDA - 2, CELDA - 2, REJILLA);
  } else {
    tft.fillRect(x, y, CELDA, CELDA, COLORES[v]);
    tft.drawFastHLine(x, y, CELDA, claro[v]);
    tft.drawFastVLine(x, y, CELDA, claro[v]);
    tft.drawFastHLine(x, y + CELDA - 1, CELDA, oscuro[v]);
    tft.drawFastVLine(x + CELDA - 1, y, CELDA, oscuro[v]);
    tft.fillRect(x + 3, y + 3, 3, 3, claro[v]);
  }
}

// Compone tablero + sombra + pieza actual y redibuja solo las celdas que cambiaron
void refrescar(bool conPieza = true) {
  uint8_t out[BH][BW];
  memcpy(out, tablero, sizeof(out));
  if (conPieza) {
    int gy = py;
    while (!choca(pt, prot, px, gy + 1)) gy++;
    uint16_t m = PIEZAS[pt][prot & 3];
    for (int i = 0; i < 16; i++) {
      if (!(m & (0x8000 >> i))) continue;
      int cx = px + (i & 3), cy = gy + (i >> 2);
      if (cy >= 0 && cy < BH && cx >= 0 && cx < BW && out[cy][cx] == 0) out[cy][cx] = 16 + pt + 1;
    }
    for (int i = 0; i < 16; i++) {
      if (!(m & (0x8000 >> i))) continue;
      int cx = px + (i & 3), cy = py + (i >> 2);
      if (cy >= 0 && cy < BH && cx >= 0 && cx < BW) out[cy][cx] = pt + 1;
    }
  }
  for (int r = 0; r < BH; r++)
    for (int c = 0; c < BW; c++)
      if (out[r][c] != mostrado[r][c]) { dibujarCelda(c, r, out[r][c]); mostrado[r][c] = out[r][c]; }
}

void dibujarSiguiente() {
  tft.fillRect(176, 72, 40, 40, FONDO);
  tft.drawRect(176, 72, 40, 40, MARCO);
  uint16_t m = PIEZAS[sig][0];
  int minC = 4, maxC = -1, minR = 4, maxR = -1;
  for (int i = 0; i < 16; i++) if (m & (0x8000 >> i)) {
    int c = i & 3, r = i >> 2;
    if (c < minC) minC = c; if (c > maxC) maxC = c;
    if (r < minR) minR = r; if (r > maxR) maxR = r;
  }
  int w = (maxC - minC + 1) * 8, h = (maxR - minR + 1) * 8;
  int ox = 176 + (40 - w) / 2, oy = 72 + (40 - h) / 2;
  for (int i = 0; i < 16; i++) if (m & (0x8000 >> i)) {
    int x = ox + ((i & 3) - minC) * 8, y = oy + ((i >> 2) - minR) * 8;
    tft.fillRect(x, y, 8, 8, COLORES[sig + 1]);
    tft.drawFastHLine(x, y, 8, claro[sig + 1]);
    tft.drawFastVLine(x, y, 8, claro[sig + 1]);
    tft.drawFastHLine(x, y + 7, 8, oscuro[sig + 1]);
    tft.drawFastVLine(x + 7, y, 8, oscuro[sig + 1]);
  }
}

void valorPanel(int x, int y, uint32_t v, uint16_t col) {
  char b[12];
  snprintf(b, sizeof(b), "%lu", (unsigned long)v);
  tft.fillRect(x, y, 42, 8, NEGRO);
  tft.setTextSize(1); tft.setTextColor(col);
  tft.setCursor(x, y); tft.print(b);
}
void etiqueta(int x, int y, const char* s) {
  tft.setTextSize(1); tft.setTextColor(C565(140, 140, 200));
  tft.setCursor(x, y); tft.print(s);
}

void panel(bool todo) {
  if (todo) {
    etiqueta(22, 58, "PUNTOS");  etiqueta(22, 92, "LINEAS");
    etiqueta(22, 126, "NIVEL");  etiqueta(22, 160, "RECORD");
    etiqueta(180, 58, "NEXT");
    valorPanel(22, 170, record, C565(255, 200, 60));
    pPuntos = pLineas = pNivel = 0xFFFFFFFF;
  }
  if (pPuntos != puntos) { valorPanel(22, 68, puntos, BLANCO);  pPuntos = puntos; }
  if (pLineas != (uint32_t)lineas) { valorPanel(22, 102, lineas, BLANCO); pLineas = lineas; }
  if (pNivel != (uint32_t)nivel) { valorPanel(22, 136, nivel, ACENTO); pNivel = nivel; }
}

void dibujarTodo() {
  tft.fillScreen(NEGRO);
  tft.drawRect(BX - 2, BY - 2, BW * CELDA + 4, BH * CELDA + 4, MARCO);
  tft.drawRect(BX - 1, BY - 1, BW * CELDA + 2, BH * CELDA + 2, C565(50, 50, 110));
  memset(mostrado, 255, sizeof(mostrado));
  panel(true);
  dibujarSiguiente();
  refrescar();
}

// ---------------------------------------------------------------- juego
uint32_t intervaloCaida() {
  int ms = (760 - (nivel - 1) * 62) * DIF_PCT[diffIdx] / 100;
  return ms < 55 ? 55 : ms;
}

void nuevaPieza() {
  pt = sig; prot = 0; px = 3; py = 0;
  sig = piezaDeLaBolsa();
  dibujarSiguiente();
}

bool mover(int dx, int dy) {
  if (choca(pt, prot, px + dx, py + dy)) return false;
  px += dx; py += dy;
  return true;
}

void girar() {
  int nr = (prot + 1) & 3;
  const int kicks[5] = {0, -1, 1, -2, 2};
  for (int k = 0; k < 5; k++) {
    if (!choca(pt, nr, px + kicks[k], py)) {
      px += kicks[k]; prot = nr;
      playSeq(SND_GIRAR, NN(SND_GIRAR), 1);
      return;
    }
  }
}

// Fija la pieza, borra lineas completas. Devuelve false si ya no cabe la siguiente (fin).
bool fijarPieza() {
  uint16_t m = PIEZAS[pt][prot & 3];
  for (int i = 0; i < 16; i++) if (m & (0x8000 >> i)) {
    int cx = px + (i & 3), cy = py + (i >> 2);
    if (cy >= 0 && cy < BH && cx >= 0 && cx < BW) tablero[cy][cx] = pt + 1;
  }
  playSeq(SND_CAER, NN(SND_CAER), 1);
  refrescar(false);

  int llenas[4], n = 0;
  for (int r = 0; r < BH && n < 4; r++) {
    bool full = true;
    for (int c = 0; c < BW; c++) if (!tablero[r][c]) { full = false; break; }
    if (full) llenas[n++] = r;
  }
  if (n > 0) {
    playSeq(n == 4 ? SND_TETRIS : SND_LINEA, n == 4 ? NN(SND_TETRIS) : NN(SND_LINEA), 2);
    for (int f = 0; f < 4; f++) {                        // parpadeo blanco
      for (int k = 0; k < n; k++)
        for (int c = 0; c < BW; c++) {
          int x = BX + c * CELDA, y = BY + llenas[k] * CELDA;
          tft.fillRect(x, y, CELDA, CELDA, (f & 1) ? COLORES[tablero[llenas[k]][c]] : BLANCO);
        }
      waitMs(70);
    }
    for (int k = 0; k < n; k++) {                        // bajar lo de arriba
      for (int r = llenas[k]; r > 0; r--) memcpy(tablero[r], tablero[r - 1], BW);
      memset(tablero[0], 0, BW);
    }
    memset(mostrado, 255, sizeof(mostrado));
    const uint16_t pts[5] = {0, 100, 300, 500, 800};
    puntos += pts[n] * nivel;
    lineas += n;
    int nuevoNivel = 1 + lineas / 10;
    if (nuevoNivel > nivel) { nivel = nuevoNivel; playSeq(SND_NIVEL, NN(SND_NIVEL), 3); }
  }
  nuevaPieza();
  panel(false);
  return !choca(pt, prot, px, py);
}

// Una partida. Devuelve true si termino perdiendo, false si salio desde la pausa.
bool partida() {
  memset(tablero, 0, sizeof(tablero));
  puntos = 0; lineas = 0; nivel = 1; bolsaIdx = 7;
  randomSeed(micros());
  sig = piezaDeLaBolsa();
  nuevaPieza();
  dibujarTodo();
  clearPresses();

  uint32_t tCaida = millis() + 600, tAbajo = 0, repetir[2] = {0, 0}, ultimo = 0;
  for (;;) {
    uint32_t now = millis();
    updateSound(now);
    readButtons(now);
    if (now - ultimo < FRAME_MS) { delay(1); continue; }
    ultimo = now;

    if (btnPress[B_OK]) {
      clearPresses();
      if (menuPausa(ACENTO)) return false;
      dibujarTodo();
      tCaida = millis() + 400;
      continue;
    }
    // izquierda / derecha con repeticion al mantener
    for (int d = 0; d < 2; d++) {
      int b = d == 0 ? B_LEFT : B_RIGHT, dx = d == 0 ? -1 : 1;
      if (btnPress[b]) { if (mover(dx, 0)) playSeq(SND_MOVER, 1, 0); repetir[d] = now + 170; }
      else if (btnHeld[b] && now >= repetir[d]) { if (mover(dx, 0)) playSeq(SND_MOVER, 1, 0); repetir[d] = now + 55; }
    }
    if (btnPress[B_UP]) girar();

    bool bajo = false;
    if (btnHeld[B_DOWN] && now >= tAbajo) {
      tAbajo = now + 32;
      if (mover(0, 1)) { puntos++; tCaida = now + intervaloCaida(); }
      else bajo = true;
    }
    if (now >= tCaida) {
      tCaida = now + intervaloCaida();
      if (!mover(0, 1)) bajo = true;
    }
    if (bajo) {
      if (!fijarPieza()) return true;
      tCaida = millis() + intervaloCaida();
      tAbajo = millis() + 150;
    }
    refrescar();
    panel(false);
    clearPresses();
  }
}

// Punto de entrada desde el arcade: menu del juego -> partidas -> menu del juego ...
void jugar() {
  for (;;) {
    record = prefsA.getUInt("hiTet", 0);
    if (!menuJuego("TETRIS", ACENTO0, record, 0)) return;
    aplicarSkin();
    for (int i = 1; i < 8; i++) { claro[i] = aclarar(COLORES[i]); oscuro[i] = oscurecer(COLORES[i]); }
    for (;;) {
      bool perdio = partida();
      if (!perdio) break;
      // la pila sube hasta arriba
      for (int r = BH - 1; r >= 0; r--) {
        for (int c = 0; c < BW; c++) {
          int x = BX + c * CELDA, y = BY + r * CELDA;
          tft.fillRect(x, y, CELDA, CELDA, skinTinte(C565(90, 90, 100)));
          tft.drawRect(x, y, CELDA, CELDA, skinTinte(C565(40, 40, 50)));
        }
        delay(18);
      }
      bool nuevo = puntos > record;
      if (nuevo) { record = puntos; prefsA.putUInt("hiTet", record); }
      if (!pantallaFin(puntos, record, nuevo, ACENTO)) break;
    }
  }
}

